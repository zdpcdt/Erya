<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:semi="https://irihi.tech/semi"
             x:Class="Erya.Controls.Demo.App"
             RequestedThemeVariant="Default">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Semi.Avalonia/Icons/StrokedIcons.axaml" />
                <ResourceInclude Source="avares://Semi.Avalonia/Icons/FillIcons.axaml" />
                <!--  ValidationErrorIcon 主题（Semi 风格）  -->
                <ResourceInclude Source="avares://Erya.Controls/ValidationErrorTheme.axaml" />
                <!--  ReorderableItemsControl / DragHandle 主题（Semi 风格）  -->
                <ResourceInclude Source="avares://Erya.Controls/ReorderTheme.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <semi:SemiTheme Locale="zh-CN" />
        <!--  输入控件 silent-errors（配合 ValidationErrorIcon）  -->
        <StyleInclude Source="avares://Erya.Controls/InputStyles.axaml" />
    </Application.Styles>
</Application>
