<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:u="https://irihi.tech/ursa"
        xmlns:vm="clr-namespace:Erya.ViewModels"
        mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="640"
        x:Class="Erya.SchemaManagerWindow"
        x:DataType="vm:SchemaManagerViewModel"
        Title="方案管理"
        Width="640" Height="640"
        MinWidth="520" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        FontFamily="Inter, Microsoft YaHei UI, Segoe UI">

    <Grid RowDefinitions="Auto,*,Auto" Margin="28,24">

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="输入方案" FontSize="22" FontWeight="Bold" />
            <TextBlock Text="勾选要启用的方案，列表顺序即方案切换顺序。保存后自动写入 default.custom.yaml 并重新部署。"
                       Opacity="0.6" FontSize="13" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Schema list -->
        <Grid Grid.Row="1" Margin="0,16" IsVisible="{Binding HasSchemas}">
            <ScrollViewer>
                <ItemsControl ItemsSource="{Binding Schemas}" Margin="0,0,4,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SchemaItemViewModel">
                            <CheckBox IsChecked="{Binding IsSelected}" Margin="0,5">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Id}" Opacity="0.45" FontSize="12"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </CheckBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- Loading / empty states -->
        <StackPanel Grid.Row="1" Margin="0,16" Spacing="10"
                    IsVisible="{Binding !HasSchemas}">
            <TextBlock Text="正在读取方案列表…" IsVisible="{Binding IsLoading}" Opacity="0.6" />
            <u:Banner Type="Warning" Content="{Binding Hint}" ShowIcon="True"
                      IsVisible="{Binding HasHint}" />
        </StackPanel>

        <!-- Footer -->
        <Grid Grid.Row="2" RowDefinitions="Auto,Auto" Margin="0,4,0,0">
            <u:Banner Grid.Row="0" Type="Error" Content="{Binding ErrorMessage}" ShowIcon="True"
                      IsVisible="{Binding HasError}" Margin="0,0,0,10" />

            <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto">
                <Button Grid.Column="1" Content="取消" Click="OnCancelClick"
                        IsEnabled="{Binding !IsBusy}" Margin="0,0,10,0" MinWidth="88" />
                <Button Grid.Column="2" Content="保存并部署" Classes="primary" Click="OnSaveClick"
                        IsEnabled="{Binding !IsBusy}" MinWidth="108" />
            </Grid>
        </Grid>
    </Grid>
</Window>
