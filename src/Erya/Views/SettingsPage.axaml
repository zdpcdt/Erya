<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:u="https://irihi.tech/ursa"
             xmlns:views="clr-namespace:Erya.Views"
             xmlns:sf="clr-namespace:Erya.ViewModels.Settings"
             xmlns:loc="clr-namespace:Erya.Localization"
             mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="620"
             x:Class="Erya.Views.SettingsPage"
             x:DataType="sf:SettingsEditorViewModel">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="{Binding Subtitle}" Opacity="0.6" TextWrapping="Wrap" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                <u:IconButton Icon="{StaticResource SemiIconRefresh}"
                              Command="{Binding LoadCommand}"
                              ToolTip.Tip="{Translate {x:Static loc:LanguageManager+Keys.settings_reloadTip}}" />
                <u:IconButton Theme="{DynamicResource SolidIconButton}" Classes="Primary"
                              Icon="{StaticResource SemiIconSave}"
                              Command="{Binding SaveAndDeployCommand}"
                              ToolTip.Tip="{Translate {x:Static loc:LanguageManager+Keys.settings_saveDeployTip}}" />
            </StackPanel>
        </Grid>

        <!-- Body -->
        <ScrollViewer Grid.Row="1" Margin="0,12" IsVisible="{Binding IsSupported}">
            <views:SettingsSectionsView Sections="{Binding Sections}" />
        </ScrollViewer>

        <!-- States -->
        <StackPanel Grid.Row="1" Margin="0,14" Spacing="10" IsVisible="{Binding !IsSupported}">
            <u:Banner Type="Information" Content="{Binding UnsupportedReason}" ShowIcon="True" />
        </StackPanel>
        <TextBlock Grid.Row="1" Text="{Translate {x:Static loc:LanguageManager+Keys.settings_loadingText}}"
                   IsVisible="{Binding IsLoading}" Opacity="0.6" Margin="0,14" />

        <!-- Footer -->
        <Grid Grid.Row="2" Margin="0,4,0,0">
            <u:Banner Type="Error" Content="{Binding ErrorMessage}" ShowIcon="True"
                      IsVisible="{Binding HasError}" />
        </Grid>
    </Grid>
</UserControl>
