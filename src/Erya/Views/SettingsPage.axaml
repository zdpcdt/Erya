<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:u="https://irihi.tech/ursa"
             xmlns:tdicon="https://irihi.tech/iconica/tdesign"
             xmlns:c="clr-namespace:Erya.Controls;assembly=Erya.Controls"
             xmlns:views="clr-namespace:Erya.Views"
             xmlns:sf="clr-namespace:Erya.ViewModels.Settings"
             mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="620"
             x:Class="Erya.Views.SettingsPage"
             x:DataType="sf:SettingsEditorViewModel">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="{Binding Subtitle}" Opacity="0.6" TextWrapping="Wrap" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                <u:IconButton Icon="{StaticResource SemiIconRefresh}"
                              Command="{Binding LoadCommand}" ToolTip.Tip="重新读取设置" />
                <u:IconButton Theme="{DynamicResource SolidIconButton}" Classes="Primary"
                              Icon="{StaticResource SemiIconSave}"
                              Command="{Binding SaveAndDeployCommand}" ToolTip.Tip="保存并部署" />
            </StackPanel>
        </Grid>

        <!-- Body：候选窗预览固定在顶部不随设置区滚动；亮/暗两个皮肤并排对照 -->
        <Grid Grid.Row="1" RowDefinitions="Auto,*" IsVisible="{Binding IsSupported}">
            <StackPanel Grid.Row="0" IsVisible="{Binding HasCandidatePreview}"
                        Orientation="Horizontal" HorizontalAlignment="Center" Spacing="40"
                        Margin="0,4,0,4">
                <StackPanel Spacing="2">
                    <TextBlock Text="亮色皮肤" HorizontalAlignment="Center" FontSize="12" Opacity="0.75" />
                    <ContentControl Content="{Binding CandidatePreview}"
                                    ContentTemplate="{StaticResource CandidateWindowTemplate}" />
                </StackPanel>
                <StackPanel Spacing="2">
                    <TextBlock Text="暗色皮肤" HorizontalAlignment="Center" FontSize="12" Opacity="0.75" />
                    <ContentControl Content="{Binding CandidatePreviewDark}"
                                    ContentTemplate="{StaticResource CandidateWindowTemplate}" />
                </StackPanel>
            </StackPanel>

            <ScrollViewer Grid.Row="1" Margin="0,12">
                <StackPanel Spacing="20">

                    <!--  schema 分节 → CellGroup；字段 → Cell（按类型分发编辑器）  -->
                <ItemsControl ItemsSource="{Binding Sections}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="20" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="sf:SettingsSectionViewModel">
                            <c:CellGroup Header="{Binding Title}" Description="{Binding Description}"
                                         ItemsSource="{Binding Fields}">
                                <c:CellGroup.ItemTemplate>
                                    <DataTemplate x:DataType="sf:SettingsFieldViewModel">
                                        <ContentControl Content="{Binding}">
                                            <ContentControl.DataTemplates>

                                                <DataTemplate x:DataType="sf:ToggleFieldViewModel">
                                                    <c:Cell Icon="{Binding IconName, Converter={x:Static views:Converters.FieldIcon}}"
                                                            Content="{Binding Label}" Description="{Binding Description}">
                                                        <c:Cell.RightContent>
                                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                                <ToggleSwitch Theme="{DynamicResource SimpleToggleSwitch}"
                                                                              IsChecked="{Binding IsChecked}" />
                                                            </StackPanel>
                                                        </c:Cell.RightContent>
                                                    </c:Cell>
                                                </DataTemplate>

                                                <DataTemplate x:DataType="sf:NumberFieldViewModel">
                                                    <c:Cell Icon="{Binding IconName, Converter={x:Static views:Converters.FieldIcon}}"
                                                            Content="{Binding Label}" Description="{Binding Description}"
                                                            Note="{Binding Note}">
                                                        <c:Cell.RightContent>
                                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                                <StackPanel Orientation="Horizontal" Spacing="8"
                                                                            IsVisible="{Binding IsStepper}">
                                                                    <u:NumericDoubleUpDown x:Name="Nu" Classes="silent-errors"
                                                                                           Width="130"
                                                                                           Value="{Binding Value}"
                                                                                           Minimum="{Binding Min}" Maximum="{Binding Max}"
                                                                                           Step="{Binding Step}"
                                                                                           FormatString="{Binding Format}" />
                                                                    <c:ValidationErrorIcon Target="{Binding #Nu}"
                                                                                            VerticalAlignment="Center" />
                                                                </StackPanel>
                                                                <Slider Width="180" IsVisible="{Binding IsSlider}"
                                                                        Minimum="{Binding Min}" Maximum="{Binding Max}"
                                                                        SmallChange="{Binding Step}" LargeChange="10"
                                                                        Value="{Binding Value}" />
                                                            </StackPanel>
                                                        </c:Cell.RightContent>
                                                    </c:Cell>
                                                </DataTemplate>

                                                <!--  font：本机已安装字体下拉（首项「未设置」）。固定宽度：
                                                      合并默认值可能是 ~200 字符的 Emoji 回退长串，框内截断显示，
                                                      不能撑开挤掉同行控件。
                                                      必须排在 TextFieldViewModel 模板之前：模板按顺序取
                                                      第一个可匹配项，而 FontFieldViewModel 兼容其基类。  -->
                                                <DataTemplate x:DataType="sf:FontFieldViewModel">
                                                    <c:Cell Icon="{Binding IconName, Converter={x:Static views:Converters.FieldIcon}}"
                                                            Content="{Binding Label}" Description="{Binding Description}">
                                                        <c:Cell.RightContent>
                                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                                <ComboBox ItemsSource="{Binding Options}"
                                                                          SelectedItem="{Binding SelectedOption, Mode=TwoWay}"
                                                                          Width="240" />
                                                            </StackPanel>
                                                        </c:Cell.RightContent>
                                                    </c:Cell>
                                                </DataTemplate>

                                                <DataTemplate x:DataType="sf:TextFieldViewModel">
                                                    <c:Cell Icon="{Binding IconName, Converter={x:Static views:Converters.FieldIcon}}"
                                                            Content="{Binding Label}" Description="{Binding Description}">
                                                        <c:Cell.RightContent>
                                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                                <TextBox Text="{Binding Text}" PlaceholderText="{Binding Placeholder}"
                                                                         Width="240" />
                                                            </StackPanel>
                                                        </c:Cell.RightContent>
                                                    </c:Cell>
                                                </DataTemplate>

                                                <DataTemplate x:DataType="sf:ChoiceFieldViewModel">
                                                    <c:Cell Icon="{Binding IconName, Converter={x:Static views:Converters.FieldIcon}}"
                                                            Content="{Binding Label}" Description="{Binding Description}">
                                                        <c:Cell.RightContent>
                                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                                <ComboBox ItemsSource="{Binding Options}"
                                                                          SelectedItem="{Binding SelectedOption, Mode=TwoWay}"
                                                                          MinWidth="170" />
                                                            </StackPanel>
                                                        </c:Cell.RightContent>
                                                    </c:Cell>
                                                </DataTemplate>

                                                <!--  hotkeyList / hotkeyPairList：行内摘要 + 点开录入按键组合。
                                                      录入框固定宽度靠左，删除/添加按钮紧随其后  -->
                                                <DataTemplate x:DataType="sf:ListFieldViewModel">
                                                    <c:Cell Icon="{Binding IconName, Converter={x:Static views:Converters.FieldIcon}}"
                                                            Content="{Binding Label}" Description="{Binding Description}"
                                                            Note="{Binding Items.Count, StringFormat=已设 {0} 项}">
                                                        <c:Cell.Detail>
                                                            <StackPanel Spacing="10">
                                                                <ItemsControl ItemsSource="{Binding Items}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate x:DataType="sf:HotkeyRowViewModel">
                                                                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2">
                                                                                <u:KeyGestureInput Width="280"
                                                                                                   Gesture="{Binding Value, Converter={x:Static views:Converters.RimeHotkey}, Mode=TwoWay}"
                                                                                                   ToolTip.Tip="{Binding Value}" />
                                                                                <u:IconButton Classes="Danger"
                                                                                              Theme="{DynamicResource SolidIconButton}"
                                                                                              Icon="{StaticResource SemiIconDelete}"
                                                                                              VerticalAlignment="Center"
                                                                                              Command="{Binding $parent[ContentControl].((sf:ListFieldViewModel)DataContext).RemoveItemCommand}"
                                                                                              CommandParameter="{Binding}"
                                                                                              ToolTip.Tip="删除此快捷键" />
                                                                            </StackPanel>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                                    <u:KeyGestureInput Width="280"
                                                                                       Gesture="{Binding NewItem, Converter={x:Static views:Converters.RimeHotkey}, Mode=TwoWay}"
                                                                                       ToolTip.Tip="聚焦后按下新的组合键" />
                                                                    <u:IconButton Theme="{DynamicResource SolidIconButton}"
                                                                                  Icon="{StaticResource SemiIconPlus}"
                                                                                  VerticalAlignment="Center"
                                                                                  Command="{Binding AddItemCommand}"
                                                                                  ToolTip.Tip="添加快捷键" />
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </c:Cell.Detail>
                                                    </c:Cell>
                                                </DataTemplate>

                                                <!--  keyMapping：每键一行下拉。左列按键名经 RimeHotkey
                                                      转成与快捷键输入框一致的显示（Caps_Lock → CapsLock）  -->
                                                <DataTemplate x:DataType="sf:KeyMappingFieldViewModel">
                                                    <c:Cell Icon="{Binding IconName, Converter={x:Static views:Converters.FieldIcon}}"
                                                            Content="{Binding Label}" Description="{Binding Description}"
                                                            Note="{Binding Summary}">
                                                        <c:Cell.Detail>
                                                            <StackPanel Spacing="10">
                                                                <ItemsControl ItemsSource="{Binding Rows}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate x:DataType="sf:KeyMappingRowViewModel">
                                                                            <Grid ColumnDefinitions="Auto,Auto" Margin="0,2">
                                                                                <TextBlock Text="{Binding Key, Converter={x:Static views:Converters.RimeHotkey}}"
                                                                                           Width="110"
                                                                                           VerticalAlignment="Center" Opacity="0.7" />
                                                                                <ComboBox Grid.Column="1"
                                                                                          ItemsSource="{Binding $parent[ContentControl].((sf:KeyMappingFieldViewModel)DataContext).Options}"
                                                                                          SelectedItem="{Binding SelectedOption, Mode=TwoWay}"
                                                                                          Width="200" />
                                                                            </Grid>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </StackPanel>
                                                        </c:Cell.Detail>
                                                    </c:Cell>
                                                </DataTemplate>

                                                <!--  checkList：每项一排  -->
                                                <DataTemplate x:DataType="sf:CheckListFieldViewModel">
                                                    <c:Cell Icon="{Binding IconName, Converter={x:Static views:Converters.FieldIcon}}"
                                                            Content="{Binding Label}" Description="{Binding Description}"
                                                            Note="{Binding EnabledSummary}">
                                                        <c:Cell.Detail>
                                                            <StackPanel Spacing="10">
                                                                <ItemsControl ItemsSource="{Binding Options}">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <!--  Semi 复选框行高小，拉开行距避免拥挤  -->
                                                                            <StackPanel Spacing="14" />
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate x:DataType="sf:CheckOptionViewModel">
                                                                            <CheckBox Content="{Binding Value}"
                                                                                      IsChecked="{Binding IsChecked}" />
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </StackPanel>
                                                        </c:Cell.Detail>
                                                    </c:Cell>
                                                </DataTemplate>

                                                <!--  appOptions：每应用一行  -->
                                                <DataTemplate x:DataType="sf:AppOptionsFieldViewModel">
                                                    <c:Cell Icon="{Binding IconName, Converter={x:Static views:Converters.FieldIcon}}"
                                                            Content="{Binding Label}" Description="{Binding Description}"
                                                            Note="{Binding Rows.Count, StringFormat={}{0} 个应用}">
                                                        <c:Cell.Detail>
                                                            <StackPanel Spacing="12">
                                                                <ItemsControl ItemsSource="{Binding Rows}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate x:DataType="sf:AppOptionsRowViewModel">
                                                                            <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,4">
                                                                                <TextBox Grid.Column="0" Text="{Binding AppId, Mode=TwoWay}"
                                                                                         PlaceholderText="应用标识（macOS Bundle ID / Windows exe 名）" />
                                                                                <CheckBox Grid.Column="1" Content="默认英文"
                                                                                          IsChecked="{Binding AsciiMode}"
                                                                                          Margin="14,0,0,0" VerticalAlignment="Center" />
                                                                                <CheckBox Grid.Column="2" Content="Vim 模式"
                                                                                          IsChecked="{Binding VimMode}"
                                                                                          Margin="14,0,0,0" VerticalAlignment="Center" />
                                                                                <u:IconButton Grid.Column="3" Classes="Danger"
                                                                                              Theme="{DynamicResource SolidIconButton}"
                                                                                              Icon="{StaticResource SemiIconDelete}"
                                                                                              Margin="14,0,0,0" VerticalAlignment="Center"
                                                                                              Command="{Binding $parent[ContentControl].((sf:AppOptionsFieldViewModel)DataContext).RemoveRowCommand}"
                                                                                              CommandParameter="{Binding}"
                                                                                              ToolTip.Tip="删除此应用" />
                                                                            </Grid>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                                <u:IconButton Theme="{DynamicResource SolidIconButton}"
                                                                              Icon="{StaticResource SemiIconPlus}"
                                                                              HorizontalAlignment="Right"
                                                                              Command="{Binding AddRowCommand}"
                                                                              ToolTip.Tip="添加应用" />
                                                            </StackPanel>
                                                        </c:Cell.Detail>
                                                    </c:Cell>
                                                </DataTemplate>

                                            </ContentControl.DataTemplates>
                                        </ContentControl>
                                    </DataTemplate>
                                </c:CellGroup.ItemTemplate>
                            </c:CellGroup>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!--  皮肤库（外观目标专属）：每套皮肤一行，点开编辑  -->
                <StackPanel Spacing="8" IsVisible="{Binding HasSchemeLibrary}">
                    <c:CellGroup ItemsSource="{Binding SchemeLibrary.Schemes}">
                        <c:CellGroup.Header>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="皮肤库" />
                                <Border IsVisible="{Binding SchemeLibrary.IsModified}"
                                        Background="#4C7BE4D8" CornerRadius="3" Padding="5,1"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="已修改" FontSize="10" />
                                </Border>
                            </StackPanel>
                        </c:CellGroup.Header>
                        <c:CellGroup.Description>
                            皮肤集合（preset_color_schemes），颜色为 0xBBGGRR。展开查看/调整：内置皮肤只读，可复制 YAML 或「以此新增」派生；自定义皮肤展开即可编辑（预览实时联动）。
                        </c:CellGroup.Description>
                        <c:CellGroup.ItemTemplate>
                            <DataTemplate x:DataType="sf:ColorSchemeViewModel">
                                <c:Cell Content="{Binding Name}" Description="{Binding KindText}">
                                    <c:Cell.Icon>
                                        <tdicon:Palette Width="20" Height="20" />
                                    </c:Cell.Icon>
                                    <c:Cell.Trailing>
                                        <Border IsVisible="{Binding IsPatched}"
                                                Background="#4C7BE4D8" CornerRadius="3" Padding="5,1"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="已修改" FontSize="10" />
                                        </Border>
                                    </c:Cell.Trailing>
                                    <c:Cell.RightContent>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <!--  候选条迷你预览  -->
                                            <Border Background="{Binding BackPreview}" CornerRadius="4"
                                                    Padding="10,4" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="ni hao" Foreground="{Binding CandidateTextPreview}" FontSize="12" />
                                                    <TextBlock Text="1. 你好" Foreground="{Binding CandidateTextPreview}" FontSize="12" />
                                                    <Border Background="{Binding HilitedBackPreview}" CornerRadius="3" Padding="4,1">
                                                        <TextBlock Text="2. 拟好" Foreground="{Binding HilitedTextPreview}" FontSize="12" />
                                                    </Border>
                                                    <TextBlock Text=" ní hǎo" Foreground="{Binding CommentTextPreview}" FontSize="11" />
                                                </StackPanel>
                                            </Border>
                                            <u:IconButton Icon="{StaticResource SemiIconPlus}"
                                                          VerticalAlignment="Center"
                                                          Command="{Binding DuplicateCommand}"
                                                          CommandParameter="{Binding}"
                                                          ToolTip.Tip="以此皮肤为底新增自定义皮肤" />
                                            <u:IconButton Theme="{DynamicResource SolidIconButton}"
                                                          Icon="{StaticResource SemiIconCode}"
                                                          VerticalAlignment="Center"
                                                          Command="{Binding CopyYamlCommand}"
                                                          ToolTip.Tip="复制此皮肤的 YAML 定义" />
                                            <u:IconButton Classes="Danger" Theme="{DynamicResource SolidIconButton}"
                                                          Icon="{StaticResource SemiIconDelete}"
                                                          VerticalAlignment="Center"
                                                          IsVisible="{Binding CanRemove}"
                                                          Command="{Binding RemoveCommand}"
                                                          CommandParameter="{Binding}"
                                                          ToolTip.Tip="删除此皮肤（内置皮肤不可删除）" />
                                        </StackPanel>
                                    </c:Cell.RightContent>
                                    <!--  展开区（Windows 设置式）：一行一个 Cell；内置皮肤只读（IsReadOnly/IsEnabled 绑定）  -->
                                    <c:Cell.Detail>
                                        <StackPanel Spacing="12">
                                            <ContentControl Content="{Binding DetailPreview}"
                                                            ContentTemplate="{StaticResource CandidateWindowTemplate}" />
                                            <c:CellGroup Header="信息">
                                                <c:Cell Content="名称">
                                                    <c:Cell.RightContent>
                                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                                            <TextBox Text="{Binding Name, Mode=TwoWay}" IsReadOnly="{Binding IsShipped}"
                                                                     Width="240" />
                                                        </StackPanel>
                                                    </c:Cell.RightContent>
                                                </c:Cell>
                                                <c:Cell Content="作者">
                                                    <c:Cell.RightContent>
                                                        <TextBox Text="{Binding Author, Mode=TwoWay}" IsReadOnly="{Binding IsShipped}"
                                                                 Width="240" />
                                                    </c:Cell.RightContent>
                                                </c:Cell>
                                            </c:CellGroup>
                                            <c:CellGroup Header="颜色（0xBBGGRR）">
                                                <c:Cell Content="背景 / 候选文字">
                                                    <c:Cell.RightContent>
                                                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                                            <ColorPicker IsColorSpectrumVisible="False" IsColorSpectrumSliderVisible="False"
                                                                         IsEnabled="{Binding !IsShipped}"
                                                                         Color="{Binding BackColor, Converter={x:Static views:Converters.RimeColor}, ConverterParameter=FFFFFF, Mode=TwoWay}" />
                                                            <TextBlock Text="{Binding BackColor, StringFormat={}0x{0}}" Opacity="0.6" VerticalAlignment="Center" />
                                                            <ColorPicker IsColorSpectrumVisible="False" IsColorSpectrumSliderVisible="False" Margin="16,0,0,0"
                                                                         IsEnabled="{Binding !IsShipped}"
                                                                         Color="{Binding CandidateTextColor, Converter={x:Static views:Converters.RimeColor}, ConverterParameter=000000, Mode=TwoWay}" />
                                                            <TextBlock Text="{Binding CandidateTextColor, StringFormat={}0x{0}}" Opacity="0.6" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </c:Cell.RightContent>
                                                </c:Cell>
                                                <c:Cell Content="高亮背景 / 高亮文字">
                                                    <c:Cell.RightContent>
                                                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                                            <ColorPicker IsColorSpectrumVisible="False" IsColorSpectrumSliderVisible="False"
                                                                         IsEnabled="{Binding !IsShipped}"
                                                                         Color="{Binding HilitedBackColor, Converter={x:Static views:Converters.RimeColor}, ConverterParameter=D3E3F6, Mode=TwoWay}" />
                                                            <TextBlock Text="{Binding HilitedBackColor, StringFormat={}0x{0}}" Opacity="0.6" VerticalAlignment="Center" />
                                                            <ColorPicker IsColorSpectrumVisible="False" IsColorSpectrumSliderVisible="False" Margin="16,0,0,0"
                                                                         IsEnabled="{Binding !IsShipped}"
                                                                         Color="{Binding HilitedTextColor, Converter={x:Static views:Converters.RimeColor}, ConverterParameter=000000, Mode=TwoWay}" />
                                                            <TextBlock Text="{Binding HilitedTextColor, StringFormat={}0x{0}}" Opacity="0.6" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </c:Cell.RightContent>
                                                </c:Cell>
                                                <c:Cell Content="注释文字">
                                                    <c:Cell.RightContent>
                                                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                                            <ColorPicker IsColorSpectrumVisible="False" IsColorSpectrumSliderVisible="False"
                                                                         IsEnabled="{Binding !IsShipped}"
                                                                         Color="{Binding CommentTextColor, Converter={x:Static views:Converters.RimeColor}, ConverterParameter=333333, Mode=TwoWay}" />
                                                            <TextBlock Text="{Binding CommentTextColor, StringFormat={}0x{0}}" Opacity="0.6" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </c:Cell.RightContent>
                                                </c:Cell>
                                                <c:Cell Content="高亮注释文字">
                                                    <c:Cell.RightContent>
                                                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                                            <ColorPicker IsColorSpectrumVisible="False" IsColorSpectrumSliderVisible="False"
                                                                         IsEnabled="{Binding !IsShipped}"
                                                                         Color="{Binding HilitedCommentTextColor, Converter={x:Static views:Converters.RimeColor}, ConverterParameter=333333, Mode=TwoWay}" />
                                                            <TextBlock Text="{Binding HilitedCommentTextColor, StringFormat={}0x{0}}" Opacity="0.6" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </c:Cell.RightContent>
                                                </c:Cell>
                                                <c:Cell Content="编码文字 / 高亮编码">
                                                    <c:Cell.RightContent>
                                                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                                            <ColorPicker IsColorSpectrumVisible="False" IsColorSpectrumSliderVisible="False"
                                                                         IsEnabled="{Binding !IsShipped}"
                                                                         Color="{Binding TextColor, Converter={x:Static views:Converters.RimeColor}, ConverterParameter=000000, Mode=TwoWay}" />
                                                            <ColorPicker IsColorSpectrumVisible="False" IsColorSpectrumSliderVisible="False" Margin="16,0,0,0"
                                                                         IsEnabled="{Binding !IsShipped}"
                                                                         Color="{Binding HilitedPreeditColor, Converter={x:Static views:Converters.RimeColor}, ConverterParameter=000000, Mode=TwoWay}" />
                                                        </StackPanel>
                                                    </c:Cell.RightContent>
                                                </c:Cell>
                                            </c:CellGroup>
                                            <c:CellGroup Header="字体与排版">
                                                <c:Cell Content="字体">
                                                    <c:Cell.RightContent>
                                                        <!--  固定宽：回退长串不能挤爆行  -->
                                                        <ComboBox ItemsSource="{Binding FontOptions}"
                                                                  SelectedItem="{Binding SelectedFontFace, Mode=TwoWay}"
                                                                  IsEnabled="{Binding !IsShipped}"
                                                                  Width="240" />
                                                    </c:Cell.RightContent>
                                                </c:Cell>
                                                <c:Cell Content="字号（像素，0 = 跟随全局）">
                                                    <c:Cell.RightContent>
                                                        <TextBox Text="{Binding FontPointText, Mode=TwoWay}" IsReadOnly="{Binding IsShipped}"
                                                                 Width="120" PlaceholderText="未设置" />
                                                    </c:Cell.RightContent>
                                                </c:Cell>
                                                <c:Cell Content="圆角（像素，空 = 跟随全局）">
                                                    <c:Cell.RightContent>
                                                        <TextBox Text="{Binding CornerRadiusText, Mode=TwoWay}" IsReadOnly="{Binding IsShipped}"
                                                                 Width="120" PlaceholderText="未设置" />
                                                    </c:Cell.RightContent>
                                                </c:Cell>
                                                <c:Cell Content="行距（像素，空 = 跟随全局）">
                                                    <c:Cell.RightContent>
                                                        <TextBox Text="{Binding LineSpacingText, Mode=TwoWay}" IsReadOnly="{Binding IsShipped}"
                                                                 Width="120" PlaceholderText="未设置" />
                                                    </c:Cell.RightContent>
                                                </c:Cell>
                                            </c:CellGroup>
                                        </StackPanel>
                                    </c:Cell.Detail>
                                </c:Cell>
                            </DataTemplate>
                        </c:CellGroup.ItemTemplate>
                    </c:CellGroup>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        </Grid>

        <!-- States -->
        <StackPanel Grid.Row="1" Margin="0,14" Spacing="10" IsVisible="{Binding !IsSupported}">
            <u:Banner Type="Information" Content="{Binding UnsupportedReason}" ShowIcon="True" />
        </StackPanel>
        <TextBlock Grid.Row="1" Text="正在读取设置…" IsVisible="{Binding IsLoading}" Opacity="0.6" Margin="0,14" />

        <!-- Footer -->
        <Grid Grid.Row="2" Margin="0,4,0,0">
            <u:Banner Type="Error" Content="{Binding ErrorMessage}" ShowIcon="True"
                      IsVisible="{Binding HasError}" />
        </Grid>
    </Grid>
</UserControl>
