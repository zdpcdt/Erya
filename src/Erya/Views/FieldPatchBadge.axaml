<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sf="clr-namespace:Erya.ViewModels.Settings"
             mc:Ignorable="d" d:DesignWidth="60" d:DesignHeight="20"
             x:Class="Erya.Views.FieldPatchBadge"
             x:DataType="sf:SettingsFieldViewModel">
    <!--  该键已写入 .custom.yaml 补丁的标签，放在 Cell 标题右侧（Trailing）；
          撤销操作见 FieldUndoButton（右侧输入控件左边）。  -->
    <Border Background="#4C7BE4D8" CornerRadius="3" Padding="5,1"
            VerticalAlignment="Center" IsVisible="{Binding IsModified}">
        <TextBlock Text="已修改" FontSize="10" />
    </Border>
</UserControl>
