<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:u="https://irihi.tech/ursa"
             xmlns:c="clr-namespace:Erya.Controls;assembly=Erya.Controls"
             xmlns:views="clr-namespace:Erya.Views"
             xmlns:vm="clr-namespace:Erya.ViewModels"
             xmlns:loc="clr-namespace:Erya.Localization"
             mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="560"
             x:Class="Erya.Views.BackupRestorePage"
             x:DataType="vm:BackupRestoreViewModel">

    <StackPanel Spacing="20">

        <TextBlock Text="{Translate {x:Static loc:LanguageManager+Keys.backup_intro}}"
                   Opacity="0.6" TextWrapping="Wrap" />

        <!--  备份 / 恢复两组。结果反馈走 Toast；busy 由按钮文案与禁用表达，页面不放状态条  -->
        <StackPanel Spacing="20" IsVisible="{Binding HasUserDir}">

            <u:SettingsCardGroup Header="{Translate {x:Static loc:LanguageManager+Keys.backup_backupTitle}}"
                         Description="{Translate {x:Static loc:LanguageManager+Keys.backup_backupDesc}}">
                <u:SettingsCard Icon="{StaticResource SemiIconSaveStroked}"
                        Content="{Translate {x:Static loc:LanguageManager+Keys.backup_backupLabel}}">
                    <u:SettingsCard.Note>
                        <TextBlock Text="{Binding UserDirSummary}" FontSize="13" Opacity="0.75"
                                   VerticalAlignment="Center" />
                    </u:SettingsCard.Note>
                    <u:SettingsCard.RightContent>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <u:IconButton Command="{Binding OpenUserDirCommand}"
                                          Theme="{DynamicResource SolidIconButton}"
                                          Icon="{StaticResource SemiIconFolderOpen}"
                                          ToolTip.Tip="{Translate {x:Static loc:LanguageManager+Keys.backup_openUserDirTip}}" />
                            <Button Classes="Primary" MinWidth="120"
                                    Content="{Binding BackupButtonText}"
                                    IsEnabled="{Binding CanBackup}"
                                    Click="OnBackupClick" />
                        </StackPanel>
                    </u:SettingsCard.RightContent>
                </u:SettingsCard>
            </u:SettingsCardGroup>

            <u:SettingsCardGroup Header="{Translate {x:Static loc:LanguageManager+Keys.backup_restoreTitle}}"
                         Description="{Translate {x:Static loc:LanguageManager+Keys.backup_restoreDesc}}">
                <u:SettingsCard Icon="{StaticResource SemiIconRestoreStroked}"
                        Content="{Translate {x:Static loc:LanguageManager+Keys.backup_restoreLabel}}">
                    <u:SettingsCard.Note>
                        <TextBlock Text="{Binding RestoreNote}" FontSize="13" Opacity="0.75"
                                   TextTrimming="CharacterEllipsis" MaxWidth="280"
                                   VerticalAlignment="Center"
                                   ToolTip.Tip="{Binding RestoreSourcePath}" />
                    </u:SettingsCard.Note>
                    <u:SettingsCard.RightContent>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button MinWidth="108" Content="{Translate {x:Static loc:LanguageManager+Keys.backup_pickBackupFile}}"
                                    IsEnabled="{Binding !IsBusy}"
                                    Click="OnPickRestoreClick" />
                            <Button Classes="Primary" MinWidth="108"
                                    Content="{Binding RestoreButtonText}"
                                    IsEnabled="{Binding CanRestore}"
                                    Command="{Binding RestoreCommand}" />
                        </StackPanel>
                    </u:SettingsCard.RightContent>
                </u:SettingsCard>
            </u:SettingsCardGroup>
        </StackPanel>

        <!--  未检测到 RIME：与概览页英雄卡空态同语言的整页空态  -->
        <Border Background="{DynamicResource SemiColorBackground1}"
                BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="1"
                CornerRadius="{DynamicResource SemiBorderRadiusMedium}"
                Padding="20,36" IsVisible="{Binding !HasUserDir}">
            <StackPanel HorizontalAlignment="Center" Spacing="10">
                <views:RimeLogoIcon Width="32" Height="32" Opacity="0.45"
                                    HorizontalAlignment="Center" />
                <TextBlock Text="{Translate {x:Static loc:LanguageManager+Keys.backup_emptyTitle}}" FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{Translate {x:Static loc:LanguageManager+Keys.backup_emptyDesc}}"
                           Opacity="0.6" FontSize="12" HorizontalAlignment="Center"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
