<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:u="https://irihi.tech/ursa"
             xmlns:c="clr-namespace:Erya.Controls;assembly=Erya.Controls"
             xmlns:vm="clr-namespace:Erya.ViewModels"
             mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="560"
             x:Class="Erya.Views.SchemaManagerPage"
             x:DataType="vm:SchemaManagerViewModel">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="勾选要启用的方案；拖动调整顺序，已启用方案的顺序即 Ctrl+` 切换顺序。" Opacity="0.6" />
                <TextBlock Text="保存后写入 default.custom.yaml 补丁并触发重新部署。"
                           Opacity="0.6" FontSize="12" />
            </StackPanel>
            <u:IconButton Grid.Column="1" VerticalAlignment="Top"
                          Theme="{DynamicResource SolidIconButton}"
                          Command="{Binding LoadCommand}"
                          Icon="{StaticResource SemiIconRefresh}"
                          ToolTip.Tip="重新扫描方案列表" />
        </Grid>

        <!-- Schema list -->
        <Grid Grid.Row="1" Margin="0,14">
            <ScrollViewer IsVisible="{Binding HasSchemas}">
                <StackPanel>
                    <c:ReorderableItemsControl ItemsSource="{Binding Schemas}" Margin="0,0,4,0">
                        <c:ReorderableItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SchemaItemViewModel">
                                <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,5">
                                    <!-- 拖拽把手：按住上下拖动调整顺序（对所有行开放；未启用行的位置不落盘） -->
                                    <c:DragHandle Data="{DynamicResource SemiIconHandle}"
                                                  VerticalAlignment="Center"
                                                  ToolTip.Tip="拖动调整顺序" />
                                    <CheckBox IsChecked="{Binding IsSelected}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Id}" Opacity="0.45" FontSize="12"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </CheckBox>
                                </StackPanel>
                            </DataTemplate>
                        </c:ReorderableItemsControl.ItemTemplate>
                    </c:ReorderableItemsControl>

                    <!-- 在线方案：社区配置包一键安装（GUI 版的东风破配方） -->
                    <Expander Margin="0,14,0,0" Header="在线方案（社区配置包）">
                        <StackPanel Spacing="10" Margin="0,10,0,0">
                            <TextBlock Text="从 GitHub 下载整份社区配置安装到用户目录；同名文件会被覆盖（升级即此原理），安装前自动备份原配置。"
                                       Opacity="0.6" FontSize="12" TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding OnlinePackages}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:OnlinePackageViewModel">
                                        <Grid ColumnDefinitions="*,Auto" Margin="0,6" ColumnSpacing="10">
                                            <StackPanel Grid.Column="0" Spacing="2">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Homepage}" Opacity="0.4"
                                                               FontSize="11" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Description}" Opacity="0.7"
                                                           FontSize="12" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Status}" FontSize="11"
                                                           IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="安装" VerticalAlignment="Center"
                                                    MinWidth="72"
                                                    Command="{Binding $parent[ItemsControl].((vm:SchemaManagerViewModel)DataContext).InstallCommand}"
                                                    CommandParameter="{Binding}"
                                                    IsEnabled="{Binding !IsInstalling}"
                                                    ToolTip.Tip="下载并安装到 RIME 用户目录，完成后自动重新部署" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Loading / empty states -->
        <StackPanel Grid.Row="1" Margin="0,14" Spacing="10"
                    IsVisible="{Binding !HasSchemas}">
            <TextBlock Text="正在读取方案列表…" IsVisible="{Binding IsLoading}" Opacity="0.6" />
            <u:Banner Type="Warning" Content="{Binding Hint}" ShowIcon="True"
                      IsVisible="{Binding HasHint}" />
        </StackPanel>

        <!-- Footer -->
        <Grid Grid.Row="2" RowDefinitions="Auto,Auto" Margin="0,4,0,0">
            <u:Banner Grid.Row="0" Type="Error" Content="{Binding ErrorMessage}" ShowIcon="True"
                      IsVisible="{Binding HasError}" Margin="0,0,0,10" />
            <Button Grid.Row="1" Content="保存并部署" Classes="Primary"
                    HorizontalAlignment="Right" MinWidth="108"
                    Command="{Binding SaveAndDeployCommand}" IsEnabled="{Binding !IsBusy}" />
        </Grid>
    </Grid>
</UserControl>
