<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:u="https://irihi.tech/ursa"
             xmlns:c="clr-namespace:Erya.Controls;assembly=Erya.Controls"
             xmlns:vm="clr-namespace:Erya.ViewModels"
             xmlns:loc="clr-namespace:Erya.Localization"
             mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="560"
             x:Class="Erya.Views.SchemaManagerPage"
             x:DataType="vm:SchemaManagerViewModel">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="{Translate {x:Static loc:LanguageManager+Keys.schemas_headerHint}}" Opacity="0.6" />
                <TextBlock Text="{Translate {x:Static loc:LanguageManager+Keys.schemas_headerHintDetail}}"
                           Opacity="0.6" FontSize="12" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                <u:IconButton Command="{Binding LoadCommand}"
                              Icon="{StaticResource SemiIconRefresh}"
                              ToolTip.Tip="{Translate {x:Static loc:LanguageManager+Keys.schemas_rescanTip}}" />
                <u:IconButton Theme="{DynamicResource SolidIconButton}" Classes="Primary"
                              Command="{Binding SaveAndDeployCommand}"
                              Icon="{StaticResource SemiIconSave}"
                              ToolTip.Tip="{Translate {x:Static loc:LanguageManager+Keys.schemas_saveAndDeployTip}}"
                              IsEnabled="{Binding !IsBusy}" />
            </StackPanel>
        </Grid>

        <!-- Schema list -->
        <Grid Grid.Row="1" Margin="0,14">
            <ScrollViewer IsVisible="{Binding HasSchemas}">
                <StackPanel>
                    <c:ReorderableItemsControl ItemsSource="{Binding Schemas}" Margin="0,0,4,0">
                        <c:ReorderableItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SchemaItemViewModel">
                                <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,5">
                                    <!-- 拖拽把手：按住上下拖动调整顺序（对所有行开放；未启用行的位置不落盘） -->
                                    <c:DragHandle Data="{DynamicResource SemiIconHandle}"
                                                  VerticalAlignment="Center"
                                                  ToolTip.Tip="{Translate {x:Static loc:LanguageManager+Keys.schemas_dragTip}}" />
                                    <CheckBox IsChecked="{Binding IsSelected}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Id}" Opacity="0.45" FontSize="12"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </CheckBox>
                                </StackPanel>
                            </DataTemplate>
                        </c:ReorderableItemsControl.ItemTemplate>
                    </c:ReorderableItemsControl>

                    <!-- 在线方案：社区配置包一键安装（GUI 版的东风破配方） -->
                    <Expander Margin="0,14,0,0" Header="{Translate {x:Static loc:LanguageManager+Keys.schemas_onlineHeader}}">
                        <StackPanel Spacing="10" Margin="0,10,0,0">
                            <TextBlock Text="{Translate {x:Static loc:LanguageManager+Keys.schemas_onlineDesc}}"
                                       Opacity="0.6" FontSize="12" TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding OnlinePackages}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:OnlinePackageViewModel">
                                        <Grid ColumnDefinitions="*,Auto" Margin="0,6" ColumnSpacing="10">
                                            <StackPanel Grid.Column="0" Spacing="2">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Homepage}" Opacity="0.4"
                                                               FontSize="11" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Description}" Opacity="0.7"
                                                           FontSize="12" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding StatusText}" FontSize="11"
                                                           IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <!-- 安装/重新安装：未装=下载图标，已装=同步图标（覆盖写入即升级），文字语义在 tooltip -->
                                                <u:IconButton Icon="{StaticResource SemiIconDownload}"
                                                              IsVisible="{Binding !IsInstalled}"
                                                              Command="{Binding $parent[ItemsControl].((vm:SchemaManagerViewModel)DataContext).InstallCommand}"
                                                              CommandParameter="{Binding}"
                                                              IsEnabled="{Binding !IsBusy}"
                                                              ToolTip.Tip="{Binding InstallToolTip}" />
                                                <u:IconButton Icon="{StaticResource SemiIconSync}"
                                                              IsVisible="{Binding IsInstalled}"
                                                              Command="{Binding $parent[ItemsControl].((vm:SchemaManagerViewModel)DataContext).InstallCommand}"
                                                              CommandParameter="{Binding}"
                                                              IsEnabled="{Binding !IsBusy}"
                                                              ToolTip.Tip="{Binding InstallToolTip}" />
                                                <!-- 删除：仅已安装的包显示；删前弹确认 + 整目录备份 -->
                                                <u:IconButton Icon="{StaticResource SemiIconDelete}"
                                                              IsVisible="{Binding IsInstalled}"
                                                              Command="{Binding $parent[ItemsControl].((vm:SchemaManagerViewModel)DataContext).UninstallCommand}"
                                                              CommandParameter="{Binding}"
                                                              IsEnabled="{Binding !IsBusy}"
                                                              ToolTip.Tip="{Translate {x:Static loc:LanguageManager+Keys.schemas_uninstallTip}}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Loading / empty states -->
        <StackPanel Grid.Row="1" Margin="0,14" Spacing="10"
                    IsVisible="{Binding !HasSchemas}">
            <TextBlock Text="{Translate {x:Static loc:LanguageManager+Keys.schemas_loadingText}}" IsVisible="{Binding IsLoading}" Opacity="0.6" />
            <u:Banner Type="Warning" Content="{Binding Hint}" ShowIcon="True"
                      IsVisible="{Binding HasHint}" />
        </StackPanel>

        <!-- Footer -->
        <Grid Grid.Row="2" Margin="0,4,0,0">
            <u:Banner Type="Error" Content="{Binding ErrorMessage}" ShowIcon="True"
                      IsVisible="{Binding HasError}" />
        </Grid>
    </Grid>
</UserControl>
