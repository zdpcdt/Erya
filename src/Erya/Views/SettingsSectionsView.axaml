<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:u="https://irihi.tech/ursa"
             xmlns:c="clr-namespace:Erya.Controls;assembly=Erya.Controls"
             xmlns:views="clr-namespace:Erya.Views"
             xmlns:sf="clr-namespace:Erya.ViewModels.Settings"
             xmlns:loc="clr-namespace:Erya.Localization"
             mc:Ignorable="d"
             x:Class="Erya.Views.SettingsSectionsView"
             x:Name="Root">

    <!--  schema 分节 → CellGroup；字段 → Cell（按类型分发编辑器）。
          输入设置页与外观三个子页共用这套渲染。  -->
    <ItemsControl ItemsSource="{Binding #Root.Sections}">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <StackPanel Spacing="20" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="sf:SettingsSectionViewModel">
                <u:SettingsCardGroup Header="{Binding Title}" Description="{Binding Description}"
                                     ItemsSource="{Binding Fields}">
                    <u:SettingsCardGroup.ItemTemplate>
                        <DataTemplate x:DataType="sf:SettingsFieldViewModel">
                            <ContentControl Content="{Binding}">
                                <ContentControl.DataTemplates>

                                    <DataTemplate x:DataType="sf:ToggleFieldViewModel">
                                        <u:SettingsCard
                                            Icon="{Binding IconName, Converter={x:Static views:Converters.FieldIcon}}"
                                            Content="{Binding Label}" Description="{Binding Description}">
                                            <u:SettingsCard.RightContent>
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <ToggleSwitch Theme="{DynamicResource SimpleToggleSwitch}"
                                                                  IsChecked="{Binding IsChecked}" />
                                                </StackPanel>
                                            </u:SettingsCard.RightContent>
                                        </u:SettingsCard>
                                    </DataTemplate>

                                    <DataTemplate x:DataType="sf:NumberFieldViewModel">
                                        <u:SettingsCard
                                            Icon="{Binding IconName, Converter={x:Static views:Converters.FieldIcon}}"
                                            Content="{Binding Label}" Description="{Binding Description}"
                                            Note="{Binding Note}">
                                            <u:SettingsCard.RightContent>
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <StackPanel Orientation="Horizontal" Spacing="8"
                                                                IsVisible="{Binding IsStepper}">
                                                        <u:NumericDoubleUpDown x:Name="Nu" Classes="silent-errors"
                                                                               Width="130"
                                                                               Value="{Binding Value}"
                                                                               Minimum="{Binding Min}"
                                                                               Maximum="{Binding Max}"
                                                                               Step="{Binding Step}"
                                                                               FormatString="{Binding Format}" />
                                                        <c:ValidationErrorIcon Target="{Binding #Nu}"
                                                                               VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <Slider Width="180" IsVisible="{Binding IsSlider}"
                                                            Minimum="{Binding Min}" Maximum="{Binding Max}"
                                                            SmallChange="{Binding Step}" LargeChange="10"
                                                            Value="{Binding Value}" />
                                                </StackPanel>
                                            </u:SettingsCard.RightContent>
                                        </u:SettingsCard>
                                    </DataTemplate>

                                    <!--  font：本机已安装字体下拉（首项「未设置」）。固定宽度：
                                          合并默认值可能是 ~200 字符的 Emoji 回退长串，框内截断显示，
                                          不能撑开挤掉同行控件。
                                          必须排在 TextFieldViewModel 模板之前：模板按顺序取
                                          第一个可匹配项，而 FontFieldViewModel 兼容其基类。  -->
                                    <DataTemplate x:DataType="sf:FontFieldViewModel">
                                        <u:SettingsCard
                                            Icon="{Binding IconName, Converter={x:Static views:Converters.FieldIcon}}"
                                            Content="{Binding Label}" Description="{Binding Description}">
                                            <u:SettingsCard.RightContent>
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <ComboBox ItemsSource="{Binding Options}"
                                                              SelectedItem="{Binding SelectedOption, Mode=TwoWay}"
                                                              Width="240" />
                                                </StackPanel>
                                            </u:SettingsCard.RightContent>
                                        </u:SettingsCard>
                                    </DataTemplate>

                                    <!--  hotkey：单键标量字段（以词定字等）。派生自 TextField，
                                          必须排在基类模板之前，否则先被文本框模板吃掉  -->
                                    <DataTemplate x:DataType="sf:HotkeyFieldViewModel">
                                        <u:SettingsCard
                                            Icon="{Binding IconName, Converter={x:Static views:Converters.FieldIcon}}"
                                            Content="{Binding Label}" Description="{Binding Description}">
                                            <u:SettingsCard.RightContent>
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <u:KeyGestureInput Width="280"
                                                                       Gesture="{Binding Text, Converter={x:Static views:Converters.RimeHotkey}, Mode=TwoWay}" />
                                                </StackPanel>
                                            </u:SettingsCard.RightContent>
                                        </u:SettingsCard>
                                    </DataTemplate>

                                    <DataTemplate x:DataType="sf:TextFieldViewModel">
                                        <u:SettingsCard
                                            Icon="{Binding IconName, Converter={x:Static views:Converters.FieldIcon}}"
                                            Content="{Binding Label}" Description="{Binding Description}">
                                            <u:SettingsCard.RightContent>
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <TextBox Text="{Binding Text}"
                                                             PlaceholderText="{Binding Placeholder}"
                                                             Width="240" />
                                                </StackPanel>
                                            </u:SettingsCard.RightContent>
                                        </u:SettingsCard>
                                    </DataTemplate>

                                    <DataTemplate x:DataType="sf:ChoiceFieldViewModel">
                                        <u:SettingsCard
                                            Icon="{Binding IconName, Converter={x:Static views:Converters.FieldIcon}}"
                                            Content="{Binding Label}" Description="{Binding Description}">
                                            <u:SettingsCard.RightContent>
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <ComboBox ItemsSource="{Binding Options}"
                                                              SelectedItem="{Binding SelectedOption, Mode=TwoWay}"
                                                              MinWidth="170" />
                                                </StackPanel>
                                            </u:SettingsCard.RightContent>
                                        </u:SettingsCard>
                                    </DataTemplate>

                                    <!--  hotkeyList / hotkeyPairList：行内摘要 + ➕ 新增。
                                          外层右侧 ➕ 在 Detail 追加一排空行并展开（已有空行时不叠行），
                                          聚焦行内录入即成；每条记录一张 SettingsCard，行内 ClearButton × /
                                          清空 = 删行，重复值标 ⚠  -->
                                    <DataTemplate x:DataType="sf:ListFieldViewModel">
                                        <u:SettingsCard
                                            Icon="{Binding IconName, Converter={x:Static views:Converters.FieldIcon}}"
                                            Content="{Binding Label}" Description="{Binding Description}"
                                            Note="{Binding NoteText}"
                                            IsExpanded="{Binding IsDetailExpanded, Mode=TwoWay}">
                                            <u:SettingsCard.RightContent>
                                                <u:IconButton Theme="{DynamicResource SolidIconButton}"
                                                              Icon="{StaticResource SemiIconPlus}"
                                                              VerticalAlignment="Center"
                                                              Command="{Binding AddHotkeyRowCommand}"
                                                              ToolTip.Tip="{Translate {x:Static loc:LanguageManager+Keys.settings_addHotkeyTip}}" />
                                            </u:SettingsCard.RightContent>
                                            <u:SettingsCard.Detail>
                                                <ItemsControl ItemsSource="{Binding Items}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="sf:HotkeyRowViewModel">
                                                            <u:SettingsCard>
                                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                                    <u:KeyGestureInput Width="280" Classes="ClearButton"
                                                                            Gesture="{Binding Value, Converter={x:Static views:Converters.RimeHotkey}, Mode=TwoWay}"
                                                                            views:HotkeyRowDelete.DeleteCommand="{Binding $parent[ItemsControl].((sf:ListFieldViewModel)DataContext).DeleteRowCommand}"
                                                                            views:HotkeyRowFocus.FocusOnAttach="{Binding IsFresh}" />
                                                                    <c:ValidationErrorIcon Error="{Binding DuplicateError}"
                                                                            VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </u:SettingsCard>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </u:SettingsCard.Detail>
                                        </u:SettingsCard>
                                    </DataTemplate>

                                    <!--  keyMapping：点开每键一行下拉。按键名经 RimeHotkey 转成与
                                          快捷键输入框一致的显示（Caps_Lock → CapsLock）作行标题  -->
                                    <DataTemplate x:DataType="sf:KeyMappingFieldViewModel">
                                        <u:SettingsCard
                                            Icon="{Binding IconName, Converter={x:Static views:Converters.FieldIcon}}"
                                            Content="{Binding Label}" Description="{Binding Description}"
                                            Note="{Binding Summary}">
                                            <u:SettingsCard.Detail>
                                                <ItemsControl ItemsSource="{Binding Rows}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="sf:KeyMappingRowViewModel">
                                                            <u:SettingsCard
                                                                Content="{Binding Key, Converter={x:Static views:Converters.RimeHotkey}}">
                                                                <u:SettingsCard.RightContent>
                                                                    <ComboBox
                                                                        ItemsSource="{Binding $parent[ItemsControl].((sf:KeyMappingFieldViewModel)DataContext).Options}"
                                                                        SelectedItem="{Binding SelectedOption, Mode=TwoWay}"
                                                                        Width="200" />
                                                                </u:SettingsCard.RightContent>
                                                            </u:SettingsCard>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </u:SettingsCard.Detail>
                                        </u:SettingsCard>
                                    </DataTemplate>

                                    <!--  checkList：点开每项一行卡（标题左、勾选右）  -->
                                    <DataTemplate x:DataType="sf:CheckListFieldViewModel">
                                        <u:SettingsCard
                                            Icon="{Binding IconName, Converter={x:Static views:Converters.FieldIcon}}"
                                            Content="{Binding Label}" Description="{Binding Description}"
                                            Note="{Binding EnabledSummary}">
                                            <u:SettingsCard.Detail>
                                                <ItemsControl ItemsSource="{Binding Options}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="sf:CheckOptionViewModel">
                                                            <u:SettingsCard>
                                                                <CheckBox
                                                                    Content="{Binding Value}"
                                                                    IsChecked="{Binding IsChecked}" />
                                                            </u:SettingsCard>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </u:SettingsCard.Detail>
                                        </u:SettingsCard>
                                    </DataTemplate>

                                    <!--  appOptions 不在此渲染：应用行为页有专用卡片列表
                                          （Views/AppsPage.axaml + AppsPageViewModel）  -->

                                </ContentControl.DataTemplates>
                            </ContentControl>
                        </DataTemplate>
                    </u:SettingsCardGroup.ItemTemplate>
                </u:SettingsCardGroup>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>