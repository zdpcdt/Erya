<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:u="https://irihi.tech/ursa"
             xmlns:sf="clr-namespace:Erya.ViewModels.Settings"
             xmlns:loc="clr-namespace:Erya.Localization"
             mc:Ignorable="d" d:DesignWidth="340" d:DesignHeight="440"
             Width="340"
             x:Class="Erya.Views.AddAppFlyout"
             x:DataType="sf:AddAppPickerViewModel">

    <!--  添加应用弹层：搜索/手输合一；点任意条目=立即添加并关闭（回车=添加手输的标识）。  -->
    <StackPanel Spacing="8">

        <TextBox x:Name="SearchBox" Text="{Binding SearchText, Mode=TwoWay}"
                 Classes="ClearButton"
                 Watermark="{Translate {x:Static loc:LanguageManager+Keys.settings_addAppSearchWatermark}}"
                 KeyDown="OnSearchKeyDown">
            <TextBox.InnerLeftContent>
                <PathIcon Data="{StaticResource SemiIconSearch}" Theme="{DynamicResource InnerPathIcon}" />
            </TextBox.InnerLeftContent>
        </TextBox>

        <!--  首行三态：添加手输标识 / 加不了的行内提示（重复、夹空白）  -->
        <Button Classes="Tertiary" Padding="10,8" HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                Command="{Binding AddCustomCommand}"
                IsVisible="{Binding CanAddCustom}">
            <TextBlock Text="{Binding CustomAddLabel}" FontWeight="SemiBold" />
        </Button>
        <TextBlock Text="{Binding HintText}" Opacity="0.55" FontSize="12" Margin="2,0,0,0"
                   IsVisible="{Binding HintText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   TextWrapping="Wrap" />

        <!--  正在运行（Windows=进程 exe 名；macOS=应用名+小字 Bundle ID）。已添加的灰显不可点。  -->
        <ScrollViewer MaxHeight="380" IsVisible="{Binding HasEntries}">
            <StackPanel Spacing="6">
                <TextBlock Text="{Translate {x:Static loc:LanguageManager+Keys.settings_addAppRunning}}"
                           FontSize="12" Opacity="0.55" Margin="2,2,0,2"
                           IsVisible="{Binding HasFilteredEntries}" />
                <ItemsControl ItemsSource="{Binding FilteredEntries}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="sf:AddAppEntry">
                            <Button Classes="Tertiary" Padding="10,7" HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Command="{Binding $parent[ItemsControl].((sf:AddAppPickerViewModel)DataContext).PickEntryCommand}"
                                    CommandParameter="{Binding}"
                                    IsEnabled="{Binding !IsAdded}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <!--  无友好名（Windows）：exe 名一行等宽；有友好名（macOS）：应用名+小字 Bundle ID 两行  -->
                                    <StackPanel Grid.Column="0" Spacing="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Id}" FontSize="12"
                                                   FontFamily="Consolas, Menlo, monospace"
                                                   TextTrimming="CharacterEllipsis"
                                                   IsVisible="{Binding !HasTitle}" />
                                        <TextBlock Text="{Binding Title}" FontSize="12"
                                                   TextTrimming="CharacterEllipsis"
                                                   IsVisible="{Binding HasTitle}" />
                                        <TextBlock Text="{Binding Id}" FontSize="11" Opacity="0.55"
                                                   FontFamily="Consolas, Menlo, monospace"
                                                   TextTrimming="CharacterEllipsis"
                                                   IsVisible="{Binding HasTitle}" />
                                    </StackPanel>
                                    <u:Badge Grid.Column="1" Content="{Translate {x:Static loc:LanguageManager+Keys.settings_addAppAdded}}"
                                             VerticalAlignment="Center"
                                             IsVisible="{Binding IsAdded}" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </StackPanel>
</UserControl>
