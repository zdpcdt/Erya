<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:u="https://irihi.tech/ursa"
             xmlns:tdicon="https://irihi.tech/iconica/tdesign"
             xmlns:c="clr-namespace:Erya.Controls;assembly=Erya.Controls"
             xmlns:sf="clr-namespace:Erya.ViewModels.Settings"
             xmlns:loc="clr-namespace:Erya.Localization"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="640"
             x:Class="Erya.Views.SkinPage"
             x:DataType="sf:SkinPageViewModel">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="{Binding Subtitle}" Opacity="0.6" TextWrapping="Wrap" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                <u:IconButton Icon="{StaticResource SemiIconRefresh}"
                              Command="{Binding LoadCommand}" ToolTip.Tip="{Translate {x:Static loc:LanguageManager+Keys.appearance_reloadTip}}" />
                <u:IconButton Theme="{DynamicResource SolidIconButton}" Classes="Primary"
                              Icon="{StaticResource SemiIconSave}"
                              Command="{Binding SaveAndDeployCommand}" ToolTip.Tip="{Translate {x:Static loc:LanguageManager+Keys.appearance_saveTip}}" />
            </StackPanel>
        </Grid>

        <!-- Body：顶部锚点固定（亮/暗预览 + 槽位行不随滚动），下方整块是皮肤画廊 -->
        <Grid Grid.Row="1" RowDefinitions="Auto,*" Margin="0,12" IsVisible="{Binding IsSupported}">

            <!--  固定区：亮/暗候选窗预览 + 亮/暗主题槽位行  -->
            <StackPanel Grid.Row="0" Spacing="16">
                <StackPanel IsVisible="{Binding HasCandidatePreview}"
                            Orientation="Horizontal" HorizontalAlignment="Center" Spacing="40">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{Translate {x:Static loc:LanguageManager+Keys.appearance_lightSkinLabel}}" HorizontalAlignment="Center" FontSize="12" Opacity="0.75" />
                        <ContentControl Content="{Binding CandidatePreview}"
                                        ContentTemplate="{StaticResource CandidateWindowTemplate}" />
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock Text="{Translate {x:Static loc:LanguageManager+Keys.appearance_darkSkinLabel}}" HorizontalAlignment="Center" FontSize="12" Opacity="0.75" />
                        <ContentControl Content="{Binding CandidatePreviewDark}"
                                        ContentTemplate="{StaticResource CandidateWindowTemplate}" />
                    </StackPanel>
                </StackPanel>

                <c:CellGroup IsVisible="{Binding HasSchemeLibrary}">
                    <c:Cell Content="{Translate {x:Static loc:LanguageManager+Keys.skin_lightThemeLabel}}"
                            Description="{Translate {x:Static loc:LanguageManager+Keys.skin_lightThemeDesc}}">
                        <c:Cell.Icon>
                            <tdicon:Sunny Width="20" Height="20" />
                        </c:Cell.Icon>
                        <c:Cell.RightContent>
                            <ComboBox ItemsSource="{Binding LightSchemeField.Options}"
                                      SelectedItem="{Binding LightSchemeField.SelectedOption, Mode=TwoWay}"
                                      MinWidth="220" />
                        </c:Cell.RightContent>
                    </c:Cell>
                    <c:Cell Content="{Translate {x:Static loc:LanguageManager+Keys.skin_darkThemeLabel}}"
                            Description="{Translate {x:Static loc:LanguageManager+Keys.skin_darkThemeDesc}}">
                        <c:Cell.Icon>
                            <tdicon:Moon Width="20" Height="20" />
                        </c:Cell.Icon>
                        <c:Cell.RightContent>
                            <ComboBox ItemsSource="{Binding DarkSchemeField.Options}"
                                      SelectedItem="{Binding DarkSchemeField.SelectedOption, Mode=TwoWay}"
                                      MinWidth="220" />
                        </c:Cell.RightContent>
                    </c:Cell>
                </c:CellGroup>
            </StackPanel>

            <!--  滚动区：皮肤画廊整块  -->
            <ScrollViewer Grid.Row="1" Margin="0,16,0,0">
                <StackPanel Spacing="8" IsVisible="{Binding HasSchemeLibrary}">
                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <TextBlock Text="{Translate {x:Static loc:LanguageManager+Keys.skin_galleryTitle}}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="{Translate {x:Static loc:LanguageManager+Keys.skin_createButton}}" Classes="Tertiary"
                                Command="{Binding CreateSchemeCommand}" Margin="0,0,12,0"
                                ToolTip.Tip="{Translate {x:Static loc:LanguageManager+Keys.skin_createTip}}" />
                        <TextBox Grid.Column="2" Text="{Binding SearchText, Mode=TwoWay}"
                                 Classes="ClearButton"
                                 PlaceholderText="{Translate {x:Static loc:LanguageManager+Keys.skin_searchPlaceholder}}" Width="220" VerticalAlignment="Center">
                            <TextBox.InnerLeftContent>
                                <PathIcon Data="{StaticResource SemiIconSearch}" Theme="{DynamicResource InnerPathIcon}" />
                            </TextBox.InnerLeftContent>
                        </TextBox>
                    </Grid>
                    <TextBlock Text="{Translate {x:Static loc:LanguageManager+Keys.skin_galleryHint}}"
                               Opacity="0.55" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding FilteredSchemes}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <u:ElasticWrapPanel IsFillHorizontal="True" ItemWidth="232" ItemSpacing="12" LineSpacing="12"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="sf:ColorSchemeViewModel">
                                <Border Classes="skin-card"
                                        BorderBrush="{Binding CardBorderBrush}"
                                        BorderThickness="{Binding CardBorderThickness}"
                                        HorizontalAlignment="Left" Width="232" Padding="10" CornerRadius="6">
                                    <StackPanel Spacing="8">
                                        <!--  卡片主体：点击 = 应用为亮色主题  -->
                                        <Button Padding="0" HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch"
                                                Classes="Tertiary"
                                                Command="{Binding $parent[ItemsControl].((sf:SkinPageViewModel)DataContext).UseAsLightSchemeCommand}"
                                                CommandParameter="{Binding}"
                                                ToolTip.Tip="{Translate {x:Static loc:LanguageManager+Keys.skin_applyAsLightTip}}">
                                            <StackPanel Spacing="8">
                                                    <Panel>
                                                        <Border Background="{Binding BackPreview}" CornerRadius="4" Padding="8,5">
                                                            <StackPanel Spacing="3">
                                                                <TextBlock Text="ni hao" FontSize="11"
                                                                           Foreground="{Binding CandidateTextPreview}" />
                                                                <Border Background="{Binding HilitedBackPreview}" CornerRadius="3"
                                                                        Padding="5,2" HorizontalAlignment="Left">
                                                                    <TextBlock Text="{Translate {x:Static loc:LanguageManager+Keys.skin_cardSampleFirst}}" FontSize="12"
                                                                               Foreground="{Binding HilitedTextPreview}" />
                                                                </Border>
                                                                <TextBlock Text="{Translate {x:Static loc:LanguageManager+Keys.skin_cardSampleRest}}" FontSize="11"
                                                                           Foreground="{Binding CandidateTextPreview}" />
                                                            </StackPanel>
                                                        </Border>
                                                    </Panel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding DetailText}" FontSize="11" Opacity="0.5"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Button>
                                        <!--  角上操作：指派亮 / 指派暗 / 复制(内置)或编辑(自定义) / 复制 YAML / 删除(自定义)  -->
                                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                            <u:IconButton Icon="{StaticResource SemiIconSun}"
                                                          Classes="Tertiary"
                                                          Command="{Binding $parent[ItemsControl].((sf:SkinPageViewModel)DataContext).UseAsLightSchemeCommand}"
                                                          CommandParameter="{Binding}"
                                                          ToolTip.Tip="{Translate {x:Static loc:LanguageManager+Keys.skin_setLightTip}}" />
                                            <u:IconButton Icon="{StaticResource SemiIconMoon}"
                                                          Classes="Tertiary"
                                                          Command="{Binding $parent[ItemsControl].((sf:SkinPageViewModel)DataContext).UseAsDarkSchemeCommand}"
                                                          CommandParameter="{Binding}"
                                                          ToolTip.Tip="{Translate {x:Static loc:LanguageManager+Keys.skin_setDarkTip}}" />
                                            <!--  内置皮肤：复制一份为自定义皮肤（打开即副本的编辑窗口）  -->
                                            <u:IconButton Icon="{StaticResource SemiIconCopy}"
                                                          Classes="Tertiary"
                                                          IsVisible="{Binding IsShipped}"
                                                          Command="{Binding $parent[ItemsControl].((sf:SkinPageViewModel)DataContext).EditSchemeCommand}"
                                                          CommandParameter="{Binding}"
                                                          ToolTip.Tip="{Translate {x:Static loc:LanguageManager+Keys.skin_copyAsCustomTip}}" />
                                            <!--  自定义皮肤：编辑  -->
                                            <u:IconButton Icon="{StaticResource SemiIconEdit}"
                                                          Classes="Tertiary"
                                                          IsVisible="{Binding !IsShipped}"
                                                          Command="{Binding $parent[ItemsControl].((sf:SkinPageViewModel)DataContext).EditSchemeCommand}"
                                                          CommandParameter="{Binding}"
                                                          ToolTip.Tip="{Translate {x:Static loc:LanguageManager+Keys.skin_editTip}}" />
                                            <u:IconButton Icon="{StaticResource SemiIconCode}"
                                                          Classes="Tertiary"
                                                          Command="{Binding CopyYamlCommand}"
                                                          ToolTip.Tip="{Translate {x:Static loc:LanguageManager+Keys.skin_copyYamlTip}}" />
                                            <u:IconButton Icon="{StaticResource SemiIconDelete}"
                                                          Classes="Tertiary"
                                                          IsVisible="{Binding CanRemove}"
                                                          Command="{Binding RemoveCommand}"
                                                          CommandParameter="{Binding}"
                                                          ToolTip.Tip="{Translate {x:Static loc:LanguageManager+Keys.skin_removeTip}}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- States -->
        <StackPanel Grid.Row="1" Margin="0,14" Spacing="10" IsVisible="{Binding !IsSupported}">
            <u:Banner Type="Information" Content="{Binding UnsupportedReason}" ShowIcon="True" />
        </StackPanel>
        <TextBlock Grid.Row="1" Text="{Translate {x:Static loc:LanguageManager+Keys.appearance_loading}}" IsVisible="{Binding IsLoading}" Opacity="0.6" Margin="0,14" />

        <!-- Footer -->
        <Grid Grid.Row="2" Margin="0,4,0,0">
            <u:Banner Type="Error" Content="{Binding ErrorMessage}" ShowIcon="True"
                      IsVisible="{Binding HasError}" />
        </Grid>
    </Grid>
</UserControl>
