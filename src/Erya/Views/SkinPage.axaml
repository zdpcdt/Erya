<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:u="https://irihi.tech/ursa"
             xmlns:c="clr-namespace:Erya.Controls;assembly=Erya.Controls"
             xmlns:views="clr-namespace:Erya.Views"
             xmlns:sf="clr-namespace:Erya.ViewModels.Settings"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="640"
             x:Class="Erya.Views.SkinPage"
             x:DataType="sf:SkinPageViewModel">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="{Binding Subtitle}" Opacity="0.6" TextWrapping="Wrap" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                <u:IconButton Icon="{StaticResource SemiIconRefresh}"
                              Command="{Binding LoadCommand}" ToolTip.Tip="重新读取设置" />
                <u:IconButton Theme="{DynamicResource SolidIconButton}" Classes="Primary"
                              Icon="{StaticResource SemiIconSave}"
                              Command="{Binding SaveAndDeployCommand}" ToolTip.Tip="保存并部署" />
            </StackPanel>
        </Grid>

        <!-- Body -->
        <ScrollViewer Grid.Row="1" Margin="0,12" IsVisible="{Binding IsSupported}">
            <StackPanel Spacing="20">

                <!--  亮/暗候选窗预览  -->
                <StackPanel IsVisible="{Binding HasCandidatePreview}"
                            Orientation="Horizontal" HorizontalAlignment="Center" Spacing="40">
                    <StackPanel Spacing="2">
                        <TextBlock Text="亮色皮肤" HorizontalAlignment="Center" FontSize="12" Opacity="0.75" />
                        <ContentControl Content="{Binding CandidatePreview}"
                                        ContentTemplate="{StaticResource CandidateWindowTemplate}" />
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock Text="暗色皮肤" HorizontalAlignment="Center" FontSize="12" Opacity="0.75" />
                        <ContentControl Content="{Binding CandidatePreviewDark}"
                                        ContentTemplate="{StaticResource CandidateWindowTemplate}" />
                    </StackPanel>
                </StackPanel>

                <!--  画廊视图 / 深页编辑  -->
                <ContentControl Content="{Binding}">
                    <ContentControl.DataTemplates>
                        <DataTemplate x:DataType="sf:SkinPageViewModel">
                            <Grid>

                            <!--  画廊：皮肤缩略卡横排（点击应用为亮色主题）+ 亮/暗主题 Cell  -->
                            <StackPanel Spacing="20" IsVisible="{Binding EditingSchemeIsNull}">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="皮肤画廊" FontWeight="SemiBold" />
                                    <TextBlock Text="点击卡片应用为亮色主题；暗色主题在下方调整。内置皮肤只读，可「以此新增」派生自定义皮肤。"
                                               Opacity="0.55" TextWrapping="Wrap" />
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                                  VerticalScrollBarVisibility="Disabled">
                                        <ItemsControl ItemsSource="{Binding SchemeLibrary.Schemes}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" Spacing="12" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="sf:ColorSchemeViewModel">
                                                    <Button Padding="0"
                                                            Command="{Binding $parent[ItemsControl].((sf:SkinPageViewModel)DataContext).UseAsLightSchemeCommand}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip.Tip="应用为亮色主题">
                                                        <Border Width="190" Padding="10" CornerRadius="6"
                                                                BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="1">
                                                            <StackPanel Spacing="8">
                                                                <Border Background="{Binding BackPreview}" CornerRadius="4" Padding="8,5">
                                                                    <StackPanel Spacing="3">
                                                                        <TextBlock Text="ni hao" FontSize="11"
                                                                                   Foreground="{Binding CandidateTextPreview}" />
                                                                        <Border Background="{Binding HilitedBackPreview}" CornerRadius="3"
                                                                                Padding="5,2" HorizontalAlignment="Left">
                                                                            <TextBlock Text="1. 你好" FontSize="12"
                                                                                       Foreground="{Binding HilitedTextPreview}" />
                                                                        </Border>
                                                                        <TextBlock Text="2. 拟好  3. 尼奥" FontSize="11"
                                                                                   Foreground="{Binding CandidateTextPreview}" />
                                                                    </StackPanel>
                                                                </Border>
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding KindText}" FontSize="11" Opacity="0.5" />
                                                            </StackPanel>
                                                        </Border>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>

                                <c:CellGroup>
                                    <c:Cell Content="亮色主题" Description="系统浅色模式使用的皮肤"
                                            Note="{Binding LightSchemeField.Selected}">
                                        <c:Cell.RightContent>
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <ComboBox ItemsSource="{Binding LightSchemeField.Options}"
                                                          SelectedItem="{Binding LightSchemeField.SelectedOption, Mode=TwoWay}"
                                                          MinWidth="200" />
                                                <u:IconButton Icon="{StaticResource SemiIconEdit}"
                                                              Command="{Binding EditLightSchemeCommand}"
                                                              ToolTip.Tip="编辑此皮肤" />
                                            </StackPanel>
                                        </c:Cell.RightContent>
                                    </c:Cell>
                                    <c:Cell Content="暗色主题" Description="系统深色模式使用的皮肤；未设置时跟随亮色"
                                            Note="{Binding DarkSchemeField.Selected}">
                                        <c:Cell.RightContent>
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <ComboBox ItemsSource="{Binding DarkSchemeField.Options}"
                                                          SelectedItem="{Binding DarkSchemeField.SelectedOption, Mode=TwoWay}"
                                                          MinWidth="200" />
                                                <u:IconButton Icon="{StaticResource SemiIconEdit}"
                                                              Command="{Binding EditDarkSchemeCommand}"
                                                              ToolTip.Tip="编辑此皮肤" />
                                            </StackPanel>
                                        </c:Cell.RightContent>
                                    </c:Cell>
                                </c:CellGroup>
                            </StackPanel>

                            <!--  深页：编辑具体皮肤（面包屑返回；内置只读）  -->
                            <StackPanel Spacing="16" IsVisible="{Binding !EditingSchemeIsNull}">
                                <StackPanel Orientation="Horizontal" Spacing="14">
                                    <Button Content="← 返回皮肤库" Command="{Binding BackToGalleryCommand}" />
                                    <TextBlock Text="{Binding EditingScheme.Name, StringFormat=编辑皮肤：{0}}"
                                               FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                                <ContentControl Content="{Binding EditingScheme}">
                                    <ContentControl.DataTemplates>
                                        <DataTemplate x:DataType="sf:ColorSchemeViewModel">
                                            <StackPanel Spacing="16">
                                                <u:Banner Type="Information" ShowIcon="True" IsVisible="{Binding IsShipped}">
                                                    内置皮肤只读——点「以此新增」可派生一份可编辑的自定义皮肤。
                                                </u:Banner>
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <u:IconButton Icon="{StaticResource SemiIconPlus}"
                                                                  Command="{Binding DuplicateCommand}"
                                                                  CommandParameter="{Binding}"
                                                                  ToolTip.Tip="以此皮肤为底新增自定义皮肤" />
                                                    <u:IconButton Theme="{DynamicResource SolidIconButton}"
                                                                  Icon="{StaticResource SemiIconCode}"
                                                                  Command="{Binding CopyYamlCommand}"
                                                                  ToolTip.Tip="复制此皮肤的 YAML 定义" />
                                                    <u:IconButton Classes="Danger" Theme="{DynamicResource SolidIconButton}"
                                                                  Icon="{StaticResource SemiIconDelete}"
                                                                  IsVisible="{Binding CanRemove}"
                                                                  Command="{Binding RemoveCommand}"
                                                                  CommandParameter="{Binding}"
                                                                  ToolTip.Tip="删除此皮肤（内置皮肤不可删除）" />
                                                </StackPanel>
                                                <ContentControl Content="{Binding DetailPreview}"
                                                                ContentTemplate="{StaticResource CandidateWindowTemplate}" />
                                                <c:CellGroup Header="信息">
                                                    <c:Cell Content="名称">
                                                        <c:Cell.RightContent>
                                                            <TextBox Text="{Binding Name, Mode=TwoWay}" IsReadOnly="{Binding IsShipped}"
                                                                     Width="260" />
                                                        </c:Cell.RightContent>
                                                    </c:Cell>
                                                    <c:Cell Content="作者">
                                                        <c:Cell.RightContent>
                                                            <TextBox Text="{Binding Author, Mode=TwoWay}" IsReadOnly="{Binding IsShipped}"
                                                                     Width="260" />
                                                        </c:Cell.RightContent>
                                                    </c:Cell>
                                                </c:CellGroup>
                                                <c:CellGroup Header="颜色（0xBBGGRR）"
                                                             Description="字体与排版请到「候选窗排版」页统一调整。">
                                                    <c:Cell Content="背景 / 候选文字">
                                                        <c:Cell.RightContent>
                                                            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                                                <ColorPicker IsColorSpectrumVisible="False" IsColorSpectrumSliderVisible="False"
                                                                             IsEnabled="{Binding !IsShipped}"
                                                                             Color="{Binding BackColor, Converter={x:Static views:Converters.RimeColor}, ConverterParameter=FFFFFF, Mode=TwoWay}" />
                                                                <TextBlock Text="{Binding BackColor, StringFormat={}0x{0}}" Opacity="0.6" VerticalAlignment="Center" />
                                                                <ColorPicker IsColorSpectrumVisible="False" IsColorSpectrumSliderVisible="False" Margin="16,0,0,0"
                                                                             IsEnabled="{Binding !IsShipped}"
                                                                             Color="{Binding CandidateTextColor, Converter={x:Static views:Converters.RimeColor}, ConverterParameter=000000, Mode=TwoWay}" />
                                                                <TextBlock Text="{Binding CandidateTextColor, StringFormat={}0x{0}}" Opacity="0.6" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </c:Cell.RightContent>
                                                    </c:Cell>
                                                    <c:Cell Content="高亮背景 / 高亮文字">
                                                        <c:Cell.RightContent>
                                                            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                                                <ColorPicker IsColorSpectrumVisible="False" IsColorSpectrumSliderVisible="False"
                                                                             IsEnabled="{Binding !IsShipped}"
                                                                             Color="{Binding HilitedBackColor, Converter={x:Static views:Converters.RimeColor}, ConverterParameter=D3E3F6, Mode=TwoWay}" />
                                                                <TextBlock Text="{Binding HilitedBackColor, StringFormat={}0x{0}}" Opacity="0.6" VerticalAlignment="Center" />
                                                                <ColorPicker IsColorSpectrumVisible="False" IsColorSpectrumSliderVisible="False" Margin="16,0,0,0"
                                                                             IsEnabled="{Binding !IsShipped}"
                                                                             Color="{Binding HilitedTextColor, Converter={x:Static views:Converters.RimeColor}, ConverterParameter=000000, Mode=TwoWay}" />
                                                                <TextBlock Text="{Binding HilitedTextColor, StringFormat={}0x{0}}" Opacity="0.6" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </c:Cell.RightContent>
                                                    </c:Cell>
                                                    <c:Cell Content="注释文字">
                                                        <c:Cell.RightContent>
                                                            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                                                <ColorPicker IsColorSpectrumVisible="False" IsColorSpectrumSliderVisible="False"
                                                                             IsEnabled="{Binding !IsShipped}"
                                                                             Color="{Binding CommentTextColor, Converter={x:Static views:Converters.RimeColor}, ConverterParameter=333333, Mode=TwoWay}" />
                                                                <TextBlock Text="{Binding CommentTextColor, StringFormat={}0x{0}}" Opacity="0.6" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </c:Cell.RightContent>
                                                    </c:Cell>
                                                    <c:Cell Content="高亮注释文字">
                                                        <c:Cell.RightContent>
                                                            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                                                <ColorPicker IsColorSpectrumVisible="False" IsColorSpectrumSliderVisible="False"
                                                                             IsEnabled="{Binding !IsShipped}"
                                                                             Color="{Binding HilitedCommentTextColor, Converter={x:Static views:Converters.RimeColor}, ConverterParameter=333333, Mode=TwoWay}" />
                                                                <TextBlock Text="{Binding HilitedCommentTextColor, StringFormat={}0x{0}}" Opacity="0.6" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </c:Cell.RightContent>
                                                    </c:Cell>
                                                    <c:Cell Content="编码文字 / 高亮编码">
                                                        <c:Cell.RightContent>
                                                            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                                                <ColorPicker IsColorSpectrumVisible="False" IsColorSpectrumSliderVisible="False"
                                                                             IsEnabled="{Binding !IsShipped}"
                                                                             Color="{Binding TextColor, Converter={x:Static views:Converters.RimeColor}, ConverterParameter=000000, Mode=TwoWay}" />
                                                                <ColorPicker IsColorSpectrumVisible="False" IsColorSpectrumSliderVisible="False" Margin="16,0,0,0"
                                                                             IsEnabled="{Binding !IsShipped}"
                                                                             Color="{Binding HilitedPreeditColor, Converter={x:Static views:Converters.RimeColor}, ConverterParameter=000000, Mode=TwoWay}" />
                                                            </StackPanel>
                                                        </c:Cell.RightContent>
                                                    </c:Cell>
                                                </c:CellGroup>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ContentControl.DataTemplates>
                                </ContentControl>
                            </StackPanel>

                            </Grid>
                        </DataTemplate>
                    </ContentControl.DataTemplates>
                </ContentControl>

            </StackPanel>
        </ScrollViewer>

        <!-- States -->
        <StackPanel Grid.Row="1" Margin="0,14" Spacing="10" IsVisible="{Binding !IsSupported}">
            <u:Banner Type="Information" Content="{Binding UnsupportedReason}" ShowIcon="True" />
        </StackPanel>
        <TextBlock Grid.Row="1" Text="正在读取设置…" IsVisible="{Binding IsLoading}" Opacity="0.6" Margin="0,14" />

        <!-- Footer -->
        <Grid Grid.Row="2" Margin="0,4,0,0">
            <u:Banner Type="Error" Content="{Binding ErrorMessage}" ShowIcon="True"
                      IsVisible="{Binding HasError}" />
        </Grid>
    </Grid>
</UserControl>
