<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:u="https://irihi.tech/ursa"
             xmlns:c="clr-namespace:Erya.Controls;assembly=Erya.Controls"
             xmlns:dist="clr-namespace:Erya.Core.Distributions;assembly=Erya.Core"
             xmlns:views="clr-namespace:Erya.Views"
             xmlns:vm="clr-namespace:Erya.ViewModels"
             xmlns:loc="clr-namespace:Erya.Localization"
             mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="520"
             x:Class="Erya.Views.OverviewPage"
             x:DataType="vm:MainViewModel">

    <StackPanel Spacing="20">

        <!--  状态英雄卡：与分组卡片同底子（背景/圆角/描边），左侧图标 + 发行版名，
              右上状态徽标三态（就绪/部署器缺失/未检测到）。持久状态都长在卡上，
              不再用 Banner；部署结果走 Toast。  -->
        <Border Background="{DynamicResource SemiColorBackground1}"
                BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="1"
                CornerRadius="{DynamicResource SemiBorderRadiusMedium}"
                Padding="20,16">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!--  RIME 官方 logo：亮/暗主题自动换墨蓝/近白变体；未检测到时灰态压暗  -->
                <Panel Width="44" Height="44">
                    <views:RimeLogoIcon Width="40" Height="40"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        IsVisible="{Binding !IsMissing}" />
                    <views:RimeLogoIcon Width="40" Height="40" Opacity="0.35"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        IsVisible="{Binding IsMissing}" />
                </Panel>

                <StackPanel Grid.Column="1" Margin="16,0,12,0" Spacing="3" VerticalAlignment="Center">
                    <TextBlock Text="{Binding HeroTitle}" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding HeroVersion}" FontSize="12" Opacity="0.55"
                               IsVisible="{Binding HeroVersion, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <TextBlock Text="{Binding HeroHint}" FontSize="12" Opacity="0.55"
                               TextWrapping="Wrap"
                               IsVisible="{Binding HeroHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsReady}">
                        <Ellipse Width="8" Height="8" Fill="{DynamicResource SemiColorSuccess}"
                                 VerticalAlignment="Center" />
                        <TextBlock Text="{Translate {x:Static loc:LanguageManager+Keys.overview_badgeReady}}" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsDeployerMissing}">
                        <Ellipse Width="8" Height="8" Fill="{DynamicResource SemiColorWarning}"
                                 VerticalAlignment="Center" />
                        <TextBlock Text="{Translate {x:Static loc:LanguageManager+Keys.overview_badgeDeployerMissing}}" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsMissing}">
                        <Ellipse Width="8" Height="8" Fill="{DynamicResource SemiColorText3}"
                                 VerticalAlignment="Center" />
                        <TextBlock Text="{Translate {x:Static loc:LanguageManager+Keys.overview_badgeMissing}}" FontSize="12" Opacity="0.55" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!--  环境 + 维护两组；未检测到 RIME 时整块隐藏，页面只剩英雄卡空态  -->
        <StackPanel Spacing="20" IsVisible="{Binding !IsMissing}">

            <c:CellGroup Header="{Translate {x:Static loc:LanguageManager+Keys.overview_envTitle}}"
                         Description="{Translate {x:Static loc:LanguageManager+Keys.overview_envDesc}}">
                <c:Cell Icon="{StaticResource SemiIconComponentStroked}"
                        Content="{Translate {x:Static loc:LanguageManager+Keys.overview_frontendLabel}}"
                        Description="{Translate {x:Static loc:LanguageManager+Keys.overview_frontendDesc}}"
                        IsVisible="{Binding HasMultipleDistributions}">
                    <c:Cell.RightContent>
                        <ComboBox ItemsSource="{Binding AvailableDistributions}"
                                  SelectedItem="{Binding Distribution, Mode=TwoWay}"
                                  MinWidth="240"
                                  ToolTip.Tip="{Translate {x:Static loc:LanguageManager+Keys.overview_frontendTip}}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="dist:IRimeDistribution">
                                    <TextBlock Text="{Binding DisplayName}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </c:Cell.RightContent>
                </c:Cell>
                <c:Cell Icon="{StaticResource SemiIconFolderStroked}"
                        Content="{Translate {x:Static loc:LanguageManager+Keys.overview_installDirLabel}}"
                        IsVisible="{Binding InstallDirDisplay, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <c:Cell.Note>
                        <TextBlock Text="{Binding InstallDirDisplay}" FontSize="13" Opacity="0.75"
                                   TextTrimming="CharacterEllipsis" MaxWidth="360"
                                   VerticalAlignment="Center" ToolTip.Tip="{Binding InstallDirDisplay}" />
                    </c:Cell.Note>
                </c:Cell>
                <c:Cell Icon="{StaticResource SemiIconFolderOpenStroked}"
                        Content="{Translate {x:Static loc:LanguageManager+Keys.overview_userDirLabel}}"
                        Description="{Translate {x:Static loc:LanguageManager+Keys.overview_userDirDesc}}">
                    <c:Cell.Note>
                        <TextBlock Text="{Binding UserDir}" FontSize="13" Opacity="0.75"
                                   TextTrimming="CharacterEllipsis" MaxWidth="360"
                                   VerticalAlignment="Center" ToolTip.Tip="{Binding UserDir}" />
                    </c:Cell.Note>
                    <c:Cell.RightContent>
                        <u:IconButton Command="{Binding OpenUserDirCommand}"
                                      Theme="{DynamicResource SolidIconButton}"
                                      Icon="{StaticResource SemiIconFolderOpen}"
                                      ToolTip.Tip="{Translate {x:Static loc:LanguageManager+Keys.overview_openUserDirTip}}" />
                    </c:Cell.RightContent>
                </c:Cell>
            </c:CellGroup>

            <c:CellGroup Header="{Translate {x:Static loc:LanguageManager+Keys.overview_maintTitle}}">
                <c:Cell Icon="{StaticResource SemiIconRedoStroked}"
                        Content="{Translate {x:Static loc:LanguageManager+Keys.overview_deployLabel}}"
                        Description="{Translate {x:Static loc:LanguageManager+Keys.overview_deployDesc}}">
                    <c:Cell.RightContent>
                        <Button Content="{Translate {x:Static loc:LanguageManager+Keys.overview_deployLabel}}" Classes="Primary" MinWidth="96"
                                Command="{Binding DeployCommand}" IsEnabled="{Binding CanDeploy}" />
                    </c:Cell.RightContent>
                </c:Cell>
            </c:CellGroup>
        </StackPanel>
    </StackPanel>
</UserControl>
