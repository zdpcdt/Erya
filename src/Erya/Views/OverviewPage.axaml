<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:u="https://irihi.tech/ursa"
             xmlns:c="clr-namespace:Erya.Controls;assembly=Erya.Controls"
             xmlns:dist="clr-namespace:Erya.Core.Distributions;assembly=Erya.Core"
             xmlns:vm="clr-namespace:Erya.ViewModels"
             mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="520"
             x:Class="Erya.Views.OverviewPage"
             x:DataType="vm:MainViewModel">

    <StackPanel Spacing="20">

        <!--  状态英雄卡：与分组卡片同底子（背景/圆角/描边），左侧图标 + 发行版名，
              右上状态徽标三态（就绪/部署器缺失/未检测到）。持久状态都长在卡上，
              不再用 Banner；部署结果走 Toast。  -->
        <Border Background="{DynamicResource SemiColorBackground1}"
                BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="1"
                CornerRadius="{DynamicResource SemiBorderRadiusMedium}"
                Padding="20,16">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Border Width="44" Height="44" CornerRadius="22"
                        Background="{DynamicResource SemiColorFill0}">
                    <Panel>
                        <PathIcon Width="24" Height="24"
                                  Theme="{DynamicResource InnerPathIcon}"
                                  Data="{StaticResource SemiIconMonitorStroked}"
                                  Foreground="{DynamicResource SemiColorPrimary}"
                                  IsVisible="{Binding !IsMissing}" />
                        <PathIcon Width="24" Height="24"
                                  Theme="{DynamicResource InnerPathIcon}"
                                  Data="{StaticResource SemiIconMonitorStroked}"
                                  Foreground="{DynamicResource SemiColorText3}"
                                  IsVisible="{Binding IsMissing}" />
                    </Panel>
                </Border>

                <StackPanel Grid.Column="1" Margin="16,0,12,0" Spacing="3" VerticalAlignment="Center">
                    <TextBlock Text="{Binding HeroTitle}" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding HeroVersion}" FontSize="12" Opacity="0.55"
                               IsVisible="{Binding HeroVersion, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <TextBlock Text="{Binding HeroHint}" FontSize="12" Opacity="0.55"
                               TextWrapping="Wrap"
                               IsVisible="{Binding HeroHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsReady}">
                        <Ellipse Width="8" Height="8" Fill="{DynamicResource SemiColorSuccess}"
                                 VerticalAlignment="Center" />
                        <TextBlock Text="就绪" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsDeployerMissing}">
                        <Ellipse Width="8" Height="8" Fill="{DynamicResource SemiColorWarning}"
                                 VerticalAlignment="Center" />
                        <TextBlock Text="部署器缺失" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsMissing}">
                        <Ellipse Width="8" Height="8" Fill="{DynamicResource SemiColorText3}"
                                 VerticalAlignment="Center" />
                        <TextBlock Text="未检测到" FontSize="12" Opacity="0.55" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!--  环境 + 维护两组；未检测到 RIME 时整块隐藏，页面只剩英雄卡空态  -->
        <StackPanel Spacing="20" IsVisible="{Binding !IsMissing}">

            <c:CellGroup Header="环境" Description="检测到的 RIME 发行版信息">
                <c:Cell Icon="{StaticResource SemiIconComponentStroked}"
                        Content="输入前端"
                        Description="本机安装了多个 RIME 前端，尔雅只管理选中的这个；切换后其他页面会重新加载"
                        IsVisible="{Binding HasMultipleDistributions}">
                    <c:Cell.RightContent>
                        <ComboBox ItemsSource="{Binding AvailableDistributions}"
                                  SelectedItem="{Binding Distribution, Mode=TwoWay}"
                                  MinWidth="240"
                                  ToolTip.Tip="选择尔雅要管理的 RIME 前端">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="dist:IRimeDistribution">
                                    <TextBlock Text="{Binding DisplayName}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </c:Cell.RightContent>
                </c:Cell>
                <c:Cell Icon="{StaticResource SemiIconFolderStroked}"
                        Content="安装目录"
                        IsVisible="{Binding InstallDirDisplay, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <c:Cell.Note>
                        <TextBlock Text="{Binding InstallDirDisplay}" FontSize="13" Opacity="0.75"
                                   TextTrimming="CharacterEllipsis" MaxWidth="360"
                                   VerticalAlignment="Center" ToolTip.Tip="{Binding InstallDirDisplay}" />
                    </c:Cell.Note>
                </c:Cell>
                <c:Cell Icon="{StaticResource SemiIconFolderOpenStroked}"
                        Content="用户目录"
                        Description="方案配置、自定义补丁与用户词典所在位置">
                    <c:Cell.Note>
                        <TextBlock Text="{Binding UserDir}" FontSize="13" Opacity="0.75"
                                   TextTrimming="CharacterEllipsis" MaxWidth="360"
                                   VerticalAlignment="Center" ToolTip.Tip="{Binding UserDir}" />
                    </c:Cell.Note>
                    <c:Cell.RightContent>
                        <u:IconButton Command="{Binding OpenUserDirCommand}"
                                      Theme="{DynamicResource SolidIconButton}"
                                      Icon="{StaticResource SemiIconFolderOpen}"
                                      ToolTip.Tip="在资源管理器中打开用户目录" />
                    </c:Cell.RightContent>
                </c:Cell>
            </c:CellGroup>

            <c:CellGroup Header="维护">
                <c:Cell Icon="{StaticResource SemiIconRedoStroked}"
                        Content="重新部署"
                        Description="重新生成 build 目录，使修改过的 YAML 配置生效">
                    <c:Cell.RightContent>
                        <Button Content="重新部署" Classes="Primary" MinWidth="96"
                                Command="{Binding DeployCommand}" IsEnabled="{Binding CanDeploy}" />
                    </c:Cell.RightContent>
                </c:Cell>
            </c:CellGroup>
        </StackPanel>
    </StackPanel>
</UserControl>
