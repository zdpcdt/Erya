<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:u="https://irihi.tech/ursa"
             xmlns:c="clr-namespace:Erya.Controls;assembly=Erya.Controls"
             xmlns:sf="clr-namespace:Erya.ViewModels.Settings"
             xmlns:views="clr-namespace:Erya.Views"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="640"
             Width="600" MaxHeight="760"
             x:Class="Erya.Views.SchemeEditDialog"
             x:DataType="sf:SchemeEditDialogViewModel">

    <!--  编辑即生效（皮肤 VM 直接承载），对话框底部「确定/取消」由 Ursa 标准按钮提供  -->
    <ScrollViewer>
        <StackPanel Spacing="16" Margin="16,12,16,16" MinWidth="520">

            <!--  候选窗预览：固定渲染正在编辑的皮肤，排版参数取外观字段当前值  -->
            <ContentControl Content="{Binding Preview}"
                            ContentTemplate="{StaticResource CandidateWindowTemplate}" />

            <c:CellGroup Header="皮肤信息">
                <c:Cell Content="名称">
                    <c:Cell.RightContent>
                        <TextBox Text="{Binding Scheme.Name, Mode=TwoWay}" Width="260" />
                    </c:Cell.RightContent>
                </c:Cell>
                <c:Cell Content="作者">
                    <c:Cell.RightContent>
                        <TextBox Text="{Binding Scheme.Author, Mode=TwoWay}" Width="260" />
                    </c:Cell.RightContent>
                </c:Cell>
            </c:CellGroup>

            <c:CellGroup Header="颜色（0xBBGGRR）">
                <c:Cell Content="背景 / 候选文字">
                    <c:Cell.RightContent>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <ColorPicker IsColorSpectrumVisible="False" IsColorSpectrumSliderVisible="False"
                                         Color="{Binding Scheme.BackColor, Converter={x:Static views:Converters.RimeColor}, ConverterParameter=FFFFFF, Mode=TwoWay}" />
                            <ColorPicker IsColorSpectrumVisible="False" IsColorSpectrumSliderVisible="False"
                                         Color="{Binding Scheme.CandidateTextColor, Converter={x:Static views:Converters.RimeColor}, ConverterParameter=000000, Mode=TwoWay}" />
                        </StackPanel>
                    </c:Cell.RightContent>
                </c:Cell>
                <c:Cell Content="高亮背景 / 高亮文字">
                    <c:Cell.RightContent>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <ColorPicker IsColorSpectrumVisible="False" IsColorSpectrumSliderVisible="False"
                                         Color="{Binding Scheme.HilitedBackColor, Converter={x:Static views:Converters.RimeColor}, ConverterParameter=D3E3F6, Mode=TwoWay}" />
                            <ColorPicker IsColorSpectrumVisible="False" IsColorSpectrumSliderVisible="False"
                                         Color="{Binding Scheme.HilitedTextColor, Converter={x:Static views:Converters.RimeColor}, ConverterParameter=000000, Mode=TwoWay}" />
                        </StackPanel>
                    </c:Cell.RightContent>
                </c:Cell>
                <c:Cell Content="注释文字">
                    <c:Cell.RightContent>
                        <ColorPicker IsColorSpectrumVisible="False" IsColorSpectrumSliderVisible="False"
                                     Color="{Binding Scheme.CommentTextColor, Converter={x:Static views:Converters.RimeColor}, ConverterParameter=333333, Mode=TwoWay}" />
                    </c:Cell.RightContent>
                </c:Cell>
                <c:Cell Content="高亮注释文字">
                    <c:Cell.RightContent>
                        <ColorPicker IsColorSpectrumVisible="False" IsColorSpectrumSliderVisible="False"
                                     Color="{Binding Scheme.HilitedCommentTextColor, Converter={x:Static views:Converters.RimeColor}, ConverterParameter=333333, Mode=TwoWay}" />
                    </c:Cell.RightContent>
                </c:Cell>
                <c:Cell Content="编码文字 / 高亮编码">
                    <c:Cell.RightContent>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <ColorPicker IsColorSpectrumVisible="False" IsColorSpectrumSliderVisible="False"
                                         Color="{Binding Scheme.TextColor, Converter={x:Static views:Converters.RimeColor}, ConverterParameter=000000, Mode=TwoWay}" />
                            <ColorPicker IsColorSpectrumVisible="False" IsColorSpectrumSliderVisible="False"
                                         Color="{Binding Scheme.HilitedPreeditColor, Converter={x:Static views:Converters.RimeColor}, ConverterParameter=000000, Mode=TwoWay}" />
                        </StackPanel>
                    </c:Cell.RightContent>
                </c:Cell>
            </c:CellGroup>

            <c:CellGroup Header="字体与排版">
                <c:Cell Content="字体">
                    <c:Cell.RightContent>
                        <!--  固定宽：回退长串不能挤爆对话框  -->
                        <ComboBox ItemsSource="{Binding Scheme.FontOptions}"
                                  SelectedItem="{Binding Scheme.SelectedFontFace, Mode=TwoWay}"
                                  Width="240" />
                    </c:Cell.RightContent>
                </c:Cell>
                <c:Cell Content="字号（像素，0 = 跟随全局）">
                    <c:Cell.RightContent>
                        <TextBox Text="{Binding Scheme.FontPointText, Mode=TwoWay}" Width="120" PlaceholderText="未设置" />
                    </c:Cell.RightContent>
                </c:Cell>
                <c:Cell Content="圆角（像素，空 = 跟随全局）">
                    <c:Cell.RightContent>
                        <TextBox Text="{Binding Scheme.CornerRadiusText, Mode=TwoWay}" Width="120" PlaceholderText="未设置" />
                    </c:Cell.RightContent>
                </c:Cell>
                <c:Cell Content="行距（像素，空 = 跟随全局）">
                    <c:Cell.RightContent>
                        <TextBox Text="{Binding Scheme.LineSpacingText, Mode=TwoWay}" Width="120" PlaceholderText="未设置" />
                    </c:Cell.RightContent>
                </c:Cell>
            </c:CellGroup>
        </StackPanel>
    </ScrollViewer>
</UserControl>
