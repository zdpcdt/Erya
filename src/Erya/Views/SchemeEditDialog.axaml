<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:u="https://irihi.tech/ursa"
             xmlns:c="clr-namespace:Erya.Controls;assembly=Erya.Controls"
             xmlns:views="clr-namespace:Erya.Views"
             xmlns:sf="clr-namespace:Erya.ViewModels.Settings"
             xmlns:loc="clr-namespace:Erya.Localization"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="700"
             Width="560" MaxHeight="780"
             x:Class="Erya.Views.SchemeEditDialog"
             x:DataType="sf:SchemeEditDialogViewModel">

    <!--  编辑即生效（皮肤 VM 直接承载）；窗口级 Dialog 自带标题与「确定/取消」按钮。
          草稿模式（新建/内置复制）：确定=入库为自定义皮肤，取消=丢弃。  -->
    <ScrollViewer>
        <StackPanel Spacing="14" Margin="16,12,16,16" MinWidth="480">

            <!--  候选窗预览：固定渲染正在编辑的皮肤，排版参数取外观字段当前值  -->
            <ContentControl Content="{Binding Preview}"
                            ContentTemplate="{StaticResource CandidateWindowTemplate}" />

            <c:CellGroup Header="{Translate {x:Static loc:LanguageManager+Keys.schemas_infoGroup}}">
                <c:Cell Content="{Translate {x:Static loc:LanguageManager+Keys.schemas_nameLabel}}">
                    <c:Cell.RightContent>
                        <TextBox Text="{Binding Scheme.Name, Mode=TwoWay}" Width="260" />
                    </c:Cell.RightContent>
                </c:Cell>
            </c:CellGroup>

            <!--  颜色：一排色块，点击弹取色面板（对比度主题式）  -->
            <c:CellGroup Header="{Translate {x:Static loc:LanguageManager+Keys.schemas_colorsGroup}}">
                <c:Cell Content="{Translate {x:Static loc:LanguageManager+Keys.schemas_colorBackCandidate}}">
                    <c:Cell.RightContent>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <views:ColorSwatch RimeHex="{Binding Scheme.BackColor, Mode=TwoWay}" />
                            <views:ColorSwatch RimeHex="{Binding Scheme.CandidateTextColor, Mode=TwoWay}" />
                        </StackPanel>
                    </c:Cell.RightContent>
                </c:Cell>
                <c:Cell Content="{Translate {x:Static loc:LanguageManager+Keys.schemas_colorHilitedBackText}}">
                    <c:Cell.RightContent>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <views:ColorSwatch RimeHex="{Binding Scheme.HilitedBackColor, Mode=TwoWay}" />
                            <views:ColorSwatch RimeHex="{Binding Scheme.HilitedTextColor, Mode=TwoWay}" />
                        </StackPanel>
                    </c:Cell.RightContent>
                </c:Cell>
                <c:Cell Content="{Translate {x:Static loc:LanguageManager+Keys.schemas_colorComment}}">
                    <c:Cell.RightContent>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <views:ColorSwatch RimeHex="{Binding Scheme.CommentTextColor, Mode=TwoWay}" />
                            <views:ColorSwatch RimeHex="{Binding Scheme.HilitedCommentTextColor, Mode=TwoWay}" />
                        </StackPanel>
                    </c:Cell.RightContent>
                </c:Cell>
                <c:Cell Content="{Translate {x:Static loc:LanguageManager+Keys.schemas_colorPreedit}}">
                    <c:Cell.RightContent>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <views:ColorSwatch RimeHex="{Binding Scheme.TextColor, Mode=TwoWay}" />
                            <views:ColorSwatch RimeHex="{Binding Scheme.HilitedPreeditColor, Mode=TwoWay}" />
                        </StackPanel>
                    </c:Cell.RightContent>
                </c:Cell>
            </c:CellGroup>

            <!--  皮肤级字体/排版：鼠须管专属（SquirrelTheme 皮肤键覆盖全局 style），
                  小狼毫从皮肤只读颜色——显示即是 placebo。  -->
            <c:CellGroup Header="{Translate {x:Static loc:LanguageManager+Keys.schemas_fontLayoutGroup}}"
                         IsVisible="{Binding IsSquirrel}">
                <c:Cell Content="{Translate {x:Static loc:LanguageManager+Keys.schemas_fontLabel}}">
                    <c:Cell.RightContent>
                        <!--  固定宽：回退长串不能挤爆对话框  -->
                        <ComboBox ItemsSource="{Binding Scheme.FontOptions}"
                                  SelectedItem="{Binding Scheme.SelectedFontFace, Mode=TwoWay}"
                                  Width="240" />
                    </c:Cell.RightContent>
                </c:Cell>
                <c:Cell Content="{Translate {x:Static loc:LanguageManager+Keys.schemas_fontPointLabel}}">
                    <c:Cell.RightContent>
                        <TextBox Text="{Binding Scheme.FontPointText, Mode=TwoWay}" Width="120" PlaceholderText="{Translate {x:Static loc:LanguageManager+Keys.schemas_notSetPlaceholder}}" />
                    </c:Cell.RightContent>
                </c:Cell>
                <c:Cell Content="{Translate {x:Static loc:LanguageManager+Keys.schemas_cornerRadiusLabel}}">
                    <c:Cell.RightContent>
                        <TextBox Text="{Binding Scheme.CornerRadiusText, Mode=TwoWay}" Width="120" PlaceholderText="{Translate {x:Static loc:LanguageManager+Keys.schemas_notSetPlaceholder}}" />
                    </c:Cell.RightContent>
                </c:Cell>
                <c:Cell Content="{Translate {x:Static loc:LanguageManager+Keys.schemas_lineSpacingLabel}}">
                    <c:Cell.RightContent>
                        <TextBox Text="{Binding Scheme.LineSpacingText, Mode=TwoWay}" Width="120" PlaceholderText="{Translate {x:Static loc:LanguageManager+Keys.schemas_notSetPlaceholder}}" />
                    </c:Cell.RightContent>
                </c:Cell>
            </c:CellGroup>
        </StackPanel>
    </ScrollViewer>
</UserControl>
