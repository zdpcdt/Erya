<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:u="https://irihi.tech/ursa"
             xmlns:views="clr-namespace:Erya.Views"
             xmlns:sf="clr-namespace:Erya.ViewModels.Settings"
             xmlns:loc="clr-namespace:Erya.Localization"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="700"
             Width="560" MaxHeight="780"
             x:Class="Erya.Views.SchemeEditDialog"
             x:DataType="sf:SchemeEditDialogViewModel">

    <!--  编辑即生效（皮肤 VM 直接承载）；窗口级 Dialog 自带标题与「确定/取消」按钮。
          草稿模式（新建/内置复制）：确定=入库为自定义皮肤，取消=丢弃。  -->
    <ScrollViewer>
        <StackPanel Spacing="14" Margin="16,12,16,16" MinWidth="480">

            <!--  候选窗预览：固定渲染正在编辑的皮肤，排版参数取外观字段当前值  -->
            <ContentControl Content="{Binding Preview}"
                            ContentTemplate="{StaticResource CandidateWindowTemplate}" />

            <u:SettingsCardGroup Header="{Translate {x:Static loc:LanguageManager+Keys.schemas_infoGroup}}">
                <u:SettingsCard Content="{Translate {x:Static loc:LanguageManager+Keys.schemas_nameLabel}}">
                    <u:SettingsCard.RightContent>
                        <TextBox Text="{Binding Scheme.Name, Mode=TwoWay}" Width="260" />
                    </u:SettingsCard.RightContent>
                </u:SettingsCard>
            </u:SettingsCardGroup>

            <!--  颜色：一排取色器（内置 ColorPicker 下拉面板），值经 RimeColor 转 BGR 十六进制  -->
            <u:SettingsCardGroup Header="{Translate {x:Static loc:LanguageManager+Keys.schemas_colorsGroup}}">
                <u:SettingsCardGroup.Styles>
                    <Style Selector="ColorPicker">
                        <Setter Property="IsAlphaVisible" Value="False" />
                    </Style>
                </u:SettingsCardGroup.Styles>
                <u:SettingsCard Content="{Translate {x:Static loc:LanguageManager+Keys.schemas_colorBackCandidate}}">
                    <u:SettingsCard.RightContent>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ColorPicker
                                Color="{Binding Scheme.BackColor, Mode=TwoWay, Converter={x:Static views:Converters.RimeColor}}" />
                            <ColorPicker
                                Color="{Binding Scheme.CandidateTextColor, Mode=TwoWay, Converter={x:Static views:Converters.RimeColor}}" />
                        </StackPanel>
                    </u:SettingsCard.RightContent>
                </u:SettingsCard>
                <u:SettingsCard Content="{Translate {x:Static loc:LanguageManager+Keys.schemas_colorHilitedBackText}}">
                    <u:SettingsCard.RightContent>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ColorPicker
                                Color="{Binding Scheme.HilitedBackColor, Mode=TwoWay, Converter={x:Static views:Converters.RimeColor}}" />
                            <ColorPicker
                                Color="{Binding Scheme.HilitedTextColor, Mode=TwoWay, Converter={x:Static views:Converters.RimeColor}}" />
                        </StackPanel>
                    </u:SettingsCard.RightContent>
                </u:SettingsCard>
                <u:SettingsCard Content="{Translate {x:Static loc:LanguageManager+Keys.schemas_colorComment}}">
                    <u:SettingsCard.RightContent>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ColorPicker
                                Color="{Binding Scheme.CommentTextColor, Mode=TwoWay, Converter={x:Static views:Converters.RimeColor}}" />
                            <ColorPicker
                                Color="{Binding Scheme.HilitedCommentTextColor, Mode=TwoWay, Converter={x:Static views:Converters.RimeColor}}" />
                        </StackPanel>
                    </u:SettingsCard.RightContent>
                </u:SettingsCard>
                <u:SettingsCard Content="{Translate {x:Static loc:LanguageManager+Keys.schemas_colorPreedit}}">
                    <u:SettingsCard.RightContent>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ColorPicker
                                Color="{Binding Scheme.TextColor, Mode=TwoWay, Converter={x:Static views:Converters.RimeColor}}" />
                            <ColorPicker
                                Color="{Binding Scheme.HilitedPreeditColor, Mode=TwoWay, Converter={x:Static views:Converters.RimeColor}}" />
                        </StackPanel>
                    </u:SettingsCard.RightContent>
                </u:SettingsCard>
            </u:SettingsCardGroup>

            <!--  皮肤级字体/排版：鼠须管专属（SquirrelTheme 皮肤键覆盖全局 style），
                  小狼毫从皮肤只读颜色——显示即是 placebo。  -->
            <u:SettingsCardGroup Header="{Translate {x:Static loc:LanguageManager+Keys.schemas_fontLayoutGroup}}"
                                 IsVisible="{Binding IsSquirrel}">
                <u:SettingsCard Content="{Translate {x:Static loc:LanguageManager+Keys.schemas_fontLabel}}">
                    <u:SettingsCard.RightContent>
                        <!--  固定宽：回退长串不能挤爆对话框  -->
                        <ComboBox ItemsSource="{Binding Scheme.FontOptions}"
                                  SelectedItem="{Binding Scheme.SelectedFontFace, Mode=TwoWay}"
                                  Width="240" />
                    </u:SettingsCard.RightContent>
                </u:SettingsCard>
                <u:SettingsCard Content="{Translate {x:Static loc:LanguageManager+Keys.schemas_fontPointLabel}}">
                    <u:SettingsCard.RightContent>
                        <TextBox Text="{Binding Scheme.FontPointText, Mode=TwoWay}" Width="120"
                                 PlaceholderText="{Translate {x:Static loc:LanguageManager+Keys.schemas_notSetPlaceholder}}" />
                    </u:SettingsCard.RightContent>
                </u:SettingsCard>
                <u:SettingsCard Content="{Translate {x:Static loc:LanguageManager+Keys.schemas_cornerRadiusLabel}}">
                    <u:SettingsCard.RightContent>
                        <TextBox Text="{Binding Scheme.CornerRadiusText, Mode=TwoWay}" Width="120"
                                 PlaceholderText="{Translate {x:Static loc:LanguageManager+Keys.schemas_notSetPlaceholder}}" />
                    </u:SettingsCard.RightContent>
                </u:SettingsCard>
                <u:SettingsCard Content="{Translate {x:Static loc:LanguageManager+Keys.schemas_lineSpacingLabel}}">
                    <u:SettingsCard.RightContent>
                        <TextBox Text="{Binding Scheme.LineSpacingText, Mode=TwoWay}" Width="120"
                                 PlaceholderText="{Translate {x:Static loc:LanguageManager+Keys.schemas_notSetPlaceholder}}" />
                    </u:SettingsCard.RightContent>
                </u:SettingsCard>
            </u:SettingsCardGroup>
        </StackPanel>
    </ScrollViewer>
</UserControl>
