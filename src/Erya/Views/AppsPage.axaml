<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:u="https://irihi.tech/ursa"
             xmlns:tdicon="https://irihi.tech/iconica/tdesign"
             xmlns:c="clr-namespace:Erya.Controls;assembly=Erya.Controls"
             xmlns:views="clr-namespace:Erya.Views"
             xmlns:sf="clr-namespace:Erya.ViewModels.Settings"
             mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="620"
             x:Class="Erya.Views.AppsPage"
             x:DataType="sf:AppsPageViewModel">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="{Binding Subtitle}" Opacity="0.6" TextWrapping="Wrap" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                <u:IconButton Icon="{StaticResource SemiIconRefresh}"
                              Command="{Binding LoadCommand}" ToolTip.Tip="重新读取设置" />
                <u:IconButton Theme="{DynamicResource SolidIconButton}" Classes="Primary"
                              Icon="{StaticResource SemiIconSave}"
                              Command="{Binding SaveAndDeployCommand}" ToolTip.Tip="保存并部署" />
            </StackPanel>
        </Grid>

        <!-- Body：工具行固定，卡片列表滚动 -->
        <Grid Grid.Row="1" RowDefinitions="Auto,*" Margin="0,12" IsVisible="{Binding IsSupported}">

            <!--  工具行：添加应用 + 搜索  -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto">
                <TextBlock Grid.Column="0" Text="加入列表的应用会在启动输入时自动切到右侧设置的状态——终端、SSH、控制台编辑器这类直接敲英文的程序最常用。"
                           Opacity="0.55" TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button x:Name="AddButton" Grid.Column="1" Content="＋ 添加应用" Classes="Primary" Margin="0,0,12,0"
                        ToolTip.Tip="点选常用或正在运行的应用，或输入标识回车；添加即默认英文，卡片上可关">
                    <Button.Flyout>
                        <Flyout Placement="Bottom">
                            <views:AddAppFlyout DataContext="{Binding Picker}" />
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <TextBox Grid.Column="2" Text="{Binding SearchText, Mode=TwoWay}"
                         Classes="ClearButton" PlaceholderText="搜索应用…"
                         Width="200" VerticalAlignment="Center">
                    <TextBox.InnerLeftContent>
                        <PathIcon Data="{StaticResource SemiIconSearch}" Theme="{DynamicResource InnerPathIcon}" />
                    </TextBox.InnerLeftContent>
                </TextBox>
            </Grid>

            <!--  滚动区  -->
            <ScrollViewer Grid.Row="1" Margin="0,12,0,0">
                <StackPanel Spacing="12">

                    <!--  应用规则卡片：标识 + 状态摘要 + 开关 + 删除  -->
                    <c:CellGroup ItemsSource="{Binding FilteredRows}">
                        <c:CellGroup.ItemTemplate>
                            <DataTemplate x:DataType="sf:AppOptionsRowViewModel">
                                <c:Cell Content="{Binding AppId}" Description="{Binding SummaryText}">
                                    <c:Cell.Icon>
                                        <tdicon:TerminalWindow Width="20" Height="20" />
                                    </c:Cell.Icon>
                                    <c:Cell.RightContent>
                                        <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                                            <!--  逐应用选项按 schema choices 分流：鼠须管含 Vim/内嵌编码，小狼毫内嵌编码  -->
                                            <ItemsControl ItemsSource="{Binding Options}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" Spacing="16" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="sf:AppOptionViewModel">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <TextBlock Text="{Binding Label}" Opacity="0.7" VerticalAlignment="Center" />
                                                            <ToggleSwitch Theme="{DynamicResource SimpleToggleSwitch}"
                                                                          IsChecked="{Binding IsChecked, Mode=TwoWay}" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <u:IconButton Classes="Danger" Theme="{DynamicResource SolidIconButton}"
                                                          Icon="{StaticResource SemiIconDelete}"
                                                          Command="{Binding $parent[ItemsControl].((sf:AppsPageViewModel)DataContext).RemoveAppCommand}"
                                                          CommandParameter="{Binding}"
                                                          ToolTip.Tip="删除此应用规则" />
                                        </StackPanel>
                                    </c:Cell.RightContent>
                                </c:Cell>
                            </DataTemplate>
                        </c:CellGroup.ItemTemplate>
                    </c:CellGroup>

                    <!--  空态：没有任何规则  -->
                    <StackPanel Spacing="12" IsVisible="{Binding !HasAnyApp}">
                        <TextBlock Text="还没有应用规则" FontWeight="SemiBold" />
                        <TextBlock Text="终端、SSH、远程桌面这类应用里通常直接敲英文——为它们设置「默认英文」，启动输入时自动切换，不用每次手动按 Shift。"
                                   Opacity="0.6" TextWrapping="Wrap" MaxWidth="520" HorizontalAlignment="Left" />
                        <ItemsControl ItemsSource="{Binding EmptyStatePresets}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <u:ElasticWrapPanel IsFillHorizontal="True" ItemWidth="200" ItemSpacing="8" LineSpacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="sf:AppPresetItem">
                                    <Button Classes="Tertiary" Padding="12,8" HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Command="{Binding $parent[ItemsControl].((sf:AppsPageViewModel)DataContext).QuickAddCommand}"
                                            CommandParameter="{Binding}"
                                            ToolTip.Tip="一键添加为「默认英文」">
                                        <StackPanel Spacing="1">
                                            <TextBlock Text="{Binding Title}" />
                                            <TextBlock Text="{Binding Id}" FontSize="11" Opacity="0.55"
                                                       FontFamily="Consolas, Menlo, monospace"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!--  搜索无结果（有规则但都被过滤掉）  -->
                    <TextBlock Text="没有匹配的应用规则。" Opacity="0.55"
                               IsVisible="{Binding SearchMiss}" />

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- States -->
        <StackPanel Grid.Row="1" Margin="0,14" Spacing="10" IsVisible="{Binding !IsSupported}">
            <u:Banner Type="Information" Content="{Binding UnsupportedReason}" ShowIcon="True" />
        </StackPanel>
        <TextBlock Grid.Row="1" Text="正在读取设置…" IsVisible="{Binding IsLoading}" Opacity="0.6" Margin="0,14" />

        <!-- Footer -->
        <Grid Grid.Row="2" Margin="0,4,0,0">
            <u:Banner Type="Error" Content="{Binding ErrorMessage}" ShowIcon="True"
                      IsVisible="{Binding HasError}" />
        </Grid>
    </Grid>
</UserControl>
