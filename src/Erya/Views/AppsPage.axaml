<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:u="https://irihi.tech/ursa"
             xmlns:tdicon="https://irihi.tech/iconica/tdesign"
             xmlns:c="clr-namespace:Erya.Controls;assembly=Erya.Controls"
             xmlns:sf="clr-namespace:Erya.ViewModels.Settings"
             xmlns:loc="clr-namespace:Erya.Localization"
             mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="620"
             x:Class="Erya.Views.AppsPage"
             x:DataType="sf:AppsPageViewModel">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <u:IconButton Icon="{StaticResource SemiIconRefresh}"
                          Command="{Binding LoadCommand}" ToolTip.Tip="{Translate {x:Static loc:LanguageManager+Keys.appearance_reloadTip}}" />
            <u:IconButton Theme="{DynamicResource SolidIconButton}" Classes="Primary"
                          Icon="{StaticResource SemiIconSave}"
                          Command="{Binding SaveAndDeployCommand}" ToolTip.Tip="{Translate {x:Static loc:LanguageManager+Keys.appearance_saveTip}}" />
        </StackPanel>

        <!-- Body：工具行固定，卡片列表滚动 -->
        <Grid Grid.Row="1" RowDefinitions="Auto,*" Margin="0,12" IsVisible="{Binding IsSupported}">

            <!--  工具行：添加应用 + 搜索  -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button x:Name="AddButton" Content="{Translate {x:Static loc:LanguageManager+Keys.apps_addButton}}" Classes="Primary">
                    <Button.Flyout>
                        <Flyout Placement="Bottom">
                            <!--  通用 SearchablePicker（Erya.Controls，预备上游 Ursa）：文案走本页 i18n，
                                 手输校验与写回在 VM；点选/回车经 code-behind 转发 AddPicked  -->
                            <c:SearchablePicker Width="340" AllowCustomEntry="True"
                                                ItemsSource="{Binding PickerEntries}"
                                                ExistingIds="{Binding PickerExistingIds}"
                                                Text="{Binding PickerText, Mode=TwoWay}"
                                                ValidateCustomEntry="{Binding PickerValidator}"
                                                PlaceholderText="{Translate {x:Static loc:LanguageManager+Keys.settings_addAppSearchWatermark}}"
                                                SectionHeader="{Translate {x:Static loc:LanguageManager+Keys.settings_addAppRunning}}"
                                                AddedText="{Translate {x:Static loc:LanguageManager+Keys.settings_addAppAdded}}"
                                                AddCustomFormat="{Translate {x:Static loc:LanguageManager+Keys.apps_pickerAddCustom}}"
                                                DuplicateHintFormat="{Translate {x:Static loc:LanguageManager+Keys.apps_addDuplicate}}"
                                                EntryPicked="OnPickerEntryPicked"
                                                CustomEntryAdded="OnPickerCustomEntryAdded" />
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <TextBox Text="{Binding SearchText, Mode=TwoWay}"
                         Classes="ClearButton" PlaceholderText="{Translate {x:Static loc:LanguageManager+Keys.apps_searchPlaceholder}}"
                         Width="200" VerticalAlignment="Center">
                    <TextBox.InnerLeftContent>
                        <PathIcon Data="{StaticResource SemiIconSearch}" Theme="{DynamicResource InnerPathIcon}" />
                    </TextBox.InnerLeftContent>
                </TextBox>
            </StackPanel>

            <!--  滚动区  -->
            <ScrollViewer Grid.Row="1" Margin="0,12,0,0">
                <StackPanel Spacing="12">

                    <!--  应用规则卡片：标识 + 状态摘要 + 开关 + 删除  -->
                    <u:SettingsCardGroup ItemsSource="{Binding FilteredRows}">
                        <u:SettingsCardGroup.ItemTemplate>
                            <DataTemplate x:DataType="sf:AppOptionsRowViewModel">
                                <u:SettingsCard Content="{Binding AppId}" Description="{Binding SummaryText}">
                                    <u:SettingsCard.Icon>
                                        <tdicon:TerminalWindow Width="20" Height="20" />
                                    </u:SettingsCard.Icon>
                                    <u:SettingsCard.RightContent>
                                        <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                                            <!--  逐应用选项按 schema choices 分流：鼠须管含 Vim/内嵌编码，小狼毫内嵌编码  -->
                                            <ItemsControl ItemsSource="{Binding Options}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" Spacing="16" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="sf:AppOptionViewModel">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <TextBlock Text="{Binding Label}" Opacity="0.7" VerticalAlignment="Center" />
                                                            <ToggleSwitch Theme="{DynamicResource SimpleToggleSwitch}"
                                                                          IsChecked="{Binding IsChecked, Mode=TwoWay}" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <u:IconButton Classes="Danger" Theme="{DynamicResource SolidIconButton}"
                                                          Icon="{StaticResource SemiIconDelete}"
                                                          Command="{Binding $parent[ItemsControl].((sf:AppsPageViewModel)DataContext).RemoveAppCommand}"
                                                          CommandParameter="{Binding}"
                                                          ToolTip.Tip="{Translate {x:Static loc:LanguageManager+Keys.apps_removeRuleTip}}" />
                                        </StackPanel>
                                    </u:SettingsCard.RightContent>
                                </u:SettingsCard>
                            </DataTemplate>
                        </u:SettingsCardGroup.ItemTemplate>
                    </u:SettingsCardGroup>

                    <!--  空态：没有任何规则，只剩标题+说明（快捷添加走「＋ 添加应用」弹层）  -->
                    <StackPanel Spacing="12" IsVisible="{Binding !HasAnyApp}">
                        <TextBlock Text="{Translate {x:Static loc:LanguageManager+Keys.apps_emptyTitle}}" FontWeight="SemiBold" />
                        <TextBlock Text="{Translate {x:Static loc:LanguageManager+Keys.apps_emptyDesc}}"
                                   Opacity="0.6" TextWrapping="Wrap" MaxWidth="520" HorizontalAlignment="Left" />
                    </StackPanel>

                    <!--  搜索无结果（有规则但都被过滤掉）  -->
                    <TextBlock Text="{Translate {x:Static loc:LanguageManager+Keys.apps_searchMiss}}" Opacity="0.55"
                               IsVisible="{Binding SearchMiss}" />

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- States -->
        <StackPanel Grid.Row="1" Margin="0,14" Spacing="10" IsVisible="{Binding !IsSupported}">
            <u:Banner Type="Information" Content="{Binding UnsupportedReason}" ShowIcon="True" />
        </StackPanel>
        <TextBlock Grid.Row="1" Text="{Translate {x:Static loc:LanguageManager+Keys.appearance_loading}}" IsVisible="{Binding IsLoading}" Opacity="0.6" Margin="0,14" />

        <!-- Footer -->
        <Grid Grid.Row="2" Margin="0,4,0,0">
            <u:Banner Type="Error" Content="{Binding ErrorMessage}" ShowIcon="True"
                      IsVisible="{Binding HasError}" />
        </Grid>
    </Grid>
</UserControl>
