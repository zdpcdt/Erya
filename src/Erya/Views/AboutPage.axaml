<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:branding="clr-namespace:Irihi.Branding;assembly=Irihi.Branding"
             xmlns:vm="clr-namespace:Erya.ViewModels"
             xmlns:loc="clr-namespace:Erya.Localization"
             mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="560"
             x:Class="Erya.Views.AboutPage"
             x:DataType="vm:AboutViewModel">

    <UserControl.Resources>
        <!--  产品卡片（HyperlinkButton 也是 Button 子类，共用此主题）：
              Background 兼作卡片顶部强调色条，悬停时描边取同色  -->
        <ControlTheme x:Key="ProductTile" TargetType="Button">
            <Setter Property="Width" Value="264" />
            <Setter Property="Margin" Value="8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="PART_Root" Padding="0" ClipToBounds="True"
                            Theme="{DynamicResource CardBorder}">
                        <Border.Transitions>
                            <Transitions>
                                <BrushTransition Property="BorderBrush" Duration="0:0:0.3" />
                            </Transitions>
                        </Border.Transitions>
                        <DockPanel>
                            <Border Name="PART_Accent" Height="4" DockPanel.Dock="Top"
                                    Background="{TemplateBinding Background}" />
                            <ContentPresenter Padding="20,24"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}" />
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ Border#PART_Root">
                <Setter Property="BorderBrush" Value="{Binding $parent[Button].Background}" />
            </Style>
        </ControlTheme>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="TextBlock.TileName">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="700" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,12,0,8" />
        </Style>
        <Style Selector="TextBlock.TileKicker">
            <Setter Property="FontWeight" Value="600" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,12,0,4" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.TileDescription">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource TextBlockTertiaryForeground}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="Label.TileTag">
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,8,24,16">

            <!--  品牌头：IRIHI 标识 + 公司名 + 口号，图标随主题亮暗自动切换  -->
            <StackPanel Margin="0,32,0,24" HorizontalAlignment="Center" Spacing="12">
                <branding:IrihiIcon HorizontalAlignment="Center" Icon="Irihi" Size="80" />
                <TextBlock HorizontalAlignment="Center" FontSize="32" FontWeight="700"
                           Text="铱泓科技 IRIHI Technology" />
                <TextBlock HorizontalAlignment="Center" FontSize="16"
                           Foreground="{DynamicResource TextBlockTertiaryForeground}"
                           Text="{Translate {x:Static loc:LanguageManager+Keys.about_companySlogan}}" />
                <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" FontSize="14"
                           Foreground="{DynamicResource TextBlockTertiaryForeground}"
                           Text="{Translate {x:Static loc:LanguageManager+Keys.about_productsIntro}}" />
            </StackPanel>

            <!--  产品卡：点击进入产品页  -->
            <WrapPanel MaxWidth="592" HorizontalAlignment="Center">
                <HyperlinkButton Background="{DynamicResource SemiPurple5}"
                                 NavigateUri="https://irihi.tech/products/semi-avalonia/"
                                 Theme="{StaticResource ProductTile}">
                    <StackPanel>
                        <branding:IrihiIcon HorizontalAlignment="Center" Icon="Semi" Size="72" />
                        <TextBlock Classes="TileName" Text="Semi" />
                        <Label Classes="TileTag Blue Ghost" Content="{Translate {x:Static loc:LanguageManager+Keys.about_tagOpenSource}}" Theme="{DynamicResource TagLabel}" />
                        <TextBlock Classes="TileKicker"
                                   Text="{Translate {x:Static loc:LanguageManager+Keys.about_semiKicker}}" />
                        <TextBlock Classes="TileDescription"
                                   Text="{Translate {x:Static loc:LanguageManager+Keys.about_semiDesc}}" />
                    </StackPanel>
                </HyperlinkButton>
                <HyperlinkButton Background="{DynamicResource SemiBlue5}"
                                 NavigateUri="https://irihi.tech/products/ursa"
                                 Theme="{StaticResource ProductTile}">
                    <StackPanel>
                        <branding:IrihiIcon HorizontalAlignment="Center" Icon="Ursa" Size="72" />
                        <TextBlock Classes="TileName" Text="Ursa" />
                        <Label Classes="TileTag Blue Ghost" Content="{Translate {x:Static loc:LanguageManager+Keys.about_tagOpenSource}}" Theme="{DynamicResource TagLabel}" />
                        <TextBlock Classes="TileKicker"
                                   Text="{Translate {x:Static loc:LanguageManager+Keys.about_ursaKicker}}" />
                        <TextBlock Classes="TileDescription"
                                   Text="{Translate {x:Static loc:LanguageManager+Keys.about_ursaDesc}}" />
                    </StackPanel>
                </HyperlinkButton>
            </WrapPanel>

            <!--  致谢：尔雅构建于 RIME 生态之上，功能设计移植自前辈工具  -->
            <StackPanel MaxWidth="640" Margin="0,16" HorizontalAlignment="Center" Spacing="6">
                <TextBlock HorizontalAlignment="Center" FontSize="18" FontWeight="Bold"
                           Text="{Translate {x:Static loc:LanguageManager+Keys.about_ackTitle}}" />
                <TextBlock HorizontalAlignment="Center" FontSize="14" TextAlignment="Center" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextBlockTertiaryForeground}"
                           Text="{Translate {x:Static loc:LanguageManager+Keys.about_ackDesc}}" />
                <!--  单个 Grid 五行四列：列宽全表共享，天然对齐（Avalonia 无 SharedSizeGroup）  -->
                <Border Margin="0,8,0,0" Padding="20,6" Theme="{DynamicResource CardBorder}">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,8" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Text="中州韵 RIME" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Margin="16,8" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextBlockTertiaryForeground}"
                                   Text="{Translate {x:Static loc:LanguageManager+Keys.about_ackRimeDesc}}" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Margin="0,8,16,8"
                                   VerticalAlignment="Center" Text="佛振" />
                        <HyperlinkButton Grid.Row="0" Grid.Column="3" Margin="0,8" Content="GitHub"
                                         NavigateUri="https://github.com/rime/librime" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,8" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Text="鼠须管 Squirrel" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Margin="16,8" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextBlockTertiaryForeground}"
                                   Text="{Translate {x:Static loc:LanguageManager+Keys.about_ackSquirrelDesc}}" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Margin="0,8,16,8"
                                   VerticalAlignment="Center" Text="佛振" />
                        <HyperlinkButton Grid.Row="1" Grid.Column="3" Margin="0,8" Content="GitHub"
                                         NavigateUri="https://github.com/rime/squirrel" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,8" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Text="小狼毫 Weasel" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Margin="16,8" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextBlockTertiaryForeground}"
                                   Text="{Translate {x:Static loc:LanguageManager+Keys.about_ackWeaselDesc}}" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Margin="0,8,16,8"
                                   VerticalAlignment="Center"
                                   Text="{Translate {x:Static loc:LanguageManager+Keys.about_ackWeaselAuthor}}" />
                        <HyperlinkButton Grid.Row="2" Grid.Column="3" Margin="0,8" Content="GitHub"
                                         NavigateUri="https://github.com/rime/weasel" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,8" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Text="中州韵助手 rimetool" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Margin="16,8" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextBlockTertiaryForeground}"
                                   Text="{Translate {x:Static loc:LanguageManager+Keys.about_ackRimetoolDesc}}" />
                        <TextBlock Grid.Row="3" Grid.Column="2" Margin="0,8,16,8"
                                   VerticalAlignment="Center" Text="yanhuacuo" />
                        <HyperlinkButton Grid.Row="3" Grid.Column="3" Margin="0,8" Content="GitHub"
                                         NavigateUri="https://github.com/yanhuacuo/rimetool" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,8" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Text="RimeControl" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Margin="16,8" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextBlockTertiaryForeground}"
                                   Text="{Translate {x:Static loc:LanguageManager+Keys.about_ackRimeControlDesc}}" />
                        <TextBlock Grid.Row="4" Grid.Column="2" Margin="0,8,16,8"
                                   VerticalAlignment="Center" Text="qzly" />
                        <HyperlinkButton Grid.Row="4" Grid.Column="3" Margin="0,8" Content="GitHub"
                                         NavigateUri="https://github.com/qzly/RimeControl" />
                    </Grid>
                </Border>
            </StackPanel>

            <!--  底部链接  -->
            <StackPanel Margin="0,32" HorizontalAlignment="Center" Orientation="Horizontal" Spacing="32">
                <HyperlinkButton Classes="WithIcon"
                                 Content="{Translate {x:Static loc:LanguageManager+Keys.about_officialSite}}"
                                 NavigateUri="https://irihi.tech">
                    <HyperlinkButton.Styles>
                        <Style Selector=".WithIcon /template/ PathIcon">
                            <Setter Property="Data" Value="{StaticResource SemiIconHome}" />
                        </Style>
                    </HyperlinkButton.Styles>
                </HyperlinkButton>
                <HyperlinkButton Classes="WithIcon" Content="GitHub" NavigateUri="https://github.com/irihitech">
                    <HyperlinkButton.Styles>
                        <Style Selector=".WithIcon /template/ PathIcon">
                            <Setter Property="Data" Value="{StaticResource SemiIconGithubLogo}" />
                        </Style>
                    </HyperlinkButton.Styles>
                </HyperlinkButton>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
