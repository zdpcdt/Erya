<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:u="https://irihi.tech/ursa"
             xmlns:edit="https://github.com/avaloniaui/avaloniaedit"
             xmlns:adv="clr-namespace:Erya.ViewModels.Advanced"
             xmlns:loc="clr-namespace:Erya.Localization"
             mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="620"
             x:Class="Erya.Views.AdvancedSettingsPage"
             x:DataType="adv:AdvancedSettingsViewModel">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Toolbar -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
            <ComboBox Grid.Column="0" ItemsSource="{Binding Targets}" SelectedItem="{Binding SelectedTarget, Mode=TwoWay}"
                      MinWidth="210" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding SourceFeedback}" Opacity="0.6" FontSize="12"
                       Margin="14,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <u:IconButton Icon="{StaticResource SemiIconRefresh}"
                              Command="{Binding LoadCommand}" ToolTip.Tip="{Translate {x:Static loc:LanguageManager+Keys.advanced_reloadTip}}" />
                <u:IconButton Theme="{DynamicResource SolidIconButton}" Classes="Primary"
                              Icon="{StaticResource SemiIconSave}"
                              Command="{Binding SaveAndDeployCommand}" ToolTip.Tip="{Translate {x:Static loc:LanguageManager+Keys.advanced_saveTip}}"
                              IsEnabled="{Binding !IsBusy}" />
            </StackPanel>
        </Grid>

        <!-- Source editor -->
        <Border Grid.Row="1" Margin="0,12" CornerRadius="6"
                BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="1"
                ClipToBounds="True">
            <edit:TextEditor Name="Editor" Document="{Binding Document}"
                             ShowLineNumbers="True" WordWrap="False"
                             FontFamily="Menlo,Consolas,monospace" FontSize="13" />
        </Border>

        <!-- Status -->
        <Grid Grid.Row="2" ColumnDefinitions="Auto,*" Margin="0,4,0,0">
            <TextBlock Grid.Column="0" Text="{Translate {x:Static loc:LanguageManager+Keys.advanced_dirtyIndicator}}" FontSize="12"
                       Foreground="{DynamicResource SemiColorWarning}"
                       IsVisible="{Binding IsDirty}" VerticalAlignment="Center" />
            <u:Banner Grid.Column="1" Type="Error" Content="{Binding ErrorMessage}" ShowIcon="True"
                      IsVisible="{Binding HasError}" Margin="10,0,0,0" />
        </Grid>
    </Grid>
</UserControl>
