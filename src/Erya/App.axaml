<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:semi="https://irihi.tech/semi"
             xmlns:u="https://irihi.tech/ursa"
             xmlns:ip="https://irihi.tech/iconica/iconpark"
             xmlns:sf="clr-namespace:Erya.ViewModels.Settings"
             x:Class="Erya.App"
             RequestedThemeVariant="Default">
             <!-- 显式初始变体：ThemeToggleButton 的两态循环依赖非 Default 的起点，
                  且 Default 下 Ursa 首次点击会抛 "Invalid state"（Ursa 2.2.0）。 -->

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Semi 图标几何：PathIcon Data={StaticResource SemiIcon*} 使用 -->
                <ResourceInclude Source="avares://Semi.Avalonia/Icons/StrokedIcons.axaml" />
                <ResourceInclude Source="avares://Semi.Avalonia/Icons/FillIcons.axaml" />
                <!-- Cell / CellGroup（设置中心风格行控件，Semi 风格；示例见 demo/Erya.Controls.Demo） -->
                <ResourceInclude Source="avares://Erya.Controls/CellTheme.axaml" />
                <!-- ReorderableItemsControl / DragHandle（拖拽排序列表，Semi 风格） -->
                <ResourceInclude Source="avares://Erya.Controls/ReorderTheme.axaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--  候选窗预览模板：外观页亮/暗两个实例 + 皮肤编辑对话框共用（ContentTemplate 引用）  -->
            <DataTemplate x:Key="CandidateWindowTemplate" DataType="sf:CandidatePreviewViewModel">
                <StackPanel Spacing="6">
                    <TextBlock Text="{Binding Caption}" Opacity="0.6" HorizontalAlignment="Center" />
                    <Border HorizontalAlignment="Center"
                            Background="{Binding BackBrush}"
                            CornerRadius="{Binding WindowCorner}"
                            BorderBrush="{Binding FrameBrush}" BorderThickness="{Binding FrameThickness}"
                            Padding="{Binding WindowPadding}"
                            MinWidth="{Binding MinWidth}" MinHeight="{Binding MinHeight}"
                            MaxWidth="{Binding MaxWidth}" MaxHeight="{Binding MaxHeight}"
                            Opacity="{Binding WindowOpacity}"
                            Effect="{Binding Shadow}">
                        <StackPanel Orientation="{Binding PanelOrientation}" Spacing="{Binding PreeditGap}">
                            <TextBlock Text="{Binding PreeditText}" IsVisible="{Binding ShowPreedit}"
                                       Foreground="{Binding PreeditBrush}"
                                       FontFamily="{Binding PreviewFont}" FontSize="{Binding FontSize}" />
                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="{Binding PanelOrientation}"
                                                    Spacing="{Binding CandidateGap}" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="sf:CandidatePreviewItem">
                                        <Border Background="{Binding RowBack}"
                                                CornerRadius="{Binding RowCorner}"
                                                Padding="{Binding RowPadding}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center"
                                                           Foreground="{Binding LabelBrush}"
                                                           FontFamily="{Binding LabelFont}"
                                                           FontSize="{Binding LabelSize}"
                                                           Margin="{Binding LabelMargin}" />
                                                <TextBlock Text="{Binding Text}" VerticalAlignment="Center"
                                                           Foreground="{Binding TextBrush}"
                                                           FontFamily="{Binding TextFont}"
                                                           FontSize="{Binding TextSize}" />
                                                <TextBlock Text="{Binding Comment}" VerticalAlignment="Center"
                                                           IsVisible="{Binding HasComment}"
                                                           Foreground="{Binding CommentBrush}"
                                                           FontFamily="{Binding CommentFont}"
                                                           FontSize="{Binding CommentSize}"
                                                           Margin="{Binding CommentMargin}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <semi:SemiTheme Locale="zh-CN" />
        <semi:UrsaSemiTheme Locale="zh-CN" />
        <!--  AvaloniaEdit（高级设置源码编辑器）的 Semi 主题  -->
        <semi:AvaloniaEditSemiTheme />
        <!--  ColorPicker（皮肤库取色）的 Semi 主题  -->
        <semi:ColorPickerSemiTheme />
        <StyleInclude Source="avares://Erya.Controls/CellStyles.axaml" />
        <!--  Ursa NumericUpDown 的静默校验（错误改由 ValidationErrorIcon 显示；控件库不依赖 Ursa，故置于应用层）  -->
        <Style Selector="u|NumericUpDown.silent-errors /template/ DataValidationErrors">
            <Setter Property="Theme" Value="{DynamicResource SilentDataValidationErrors}" />
        </Style>
        <!--  IconPark 图标默认双色调；设置行内统一为单色线形（跟随主题文字色）  -->
        <Style Selector=":is(ip|IconParkBase)">
            <Setter Property="Mode" Value="Line" />
            <Setter Property="OuterStroke" Value="{DynamicResource SemiColorText1}" />
        </Style>
    </Application.Styles>
</Application>
