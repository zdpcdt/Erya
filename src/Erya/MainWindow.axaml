<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:u="https://irihi.tech/ursa"
        xmlns:vm="clr-namespace:Erya.ViewModels"
        mc:Ignorable="d" d:DesignWidth="860" d:DesignHeight="560"
        x:Class="Erya.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="尔雅 Erya"
        Width="860" Height="560"
        MinWidth="700" MinHeight="460"
        FontFamily="Inter, Microsoft YaHei UI, Segoe UI">

    <Grid RowDefinitions="Auto,*" Margin="36,30">

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="4">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="尔雅" FontSize="30" FontWeight="Bold" />
                <TextBlock Text="Erya" FontSize="15" FontWeight="SemiBold"
                           Opacity="0.45" VerticalAlignment="Bottom" Margin="0,0,0,6" />
            </StackPanel>
            <TextBlock Text="中州韵输入法引擎（RIME）· 可视化配置"
                       Opacity="0.6" FontSize="13" />
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="18" Margin="0,22,0,0">

            <u:Form LabelPosition="Left" LabelWidth="96">
                <u:FormItem Label="发行版">
                    <TextBlock Text="{Binding DetectionTitle}"
                               VerticalAlignment="Center" FontWeight="SemiBold" />
                </u:FormItem>
                <u:FormItem Label="安装目录" IsVisible="{Binding InstallDirDisplay, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <TextBlock Text="{Binding InstallDirDisplay}"
                               VerticalAlignment="Center" Opacity="0.72" TextWrapping="Wrap" />
                </u:FormItem>
                <u:FormItem Label="用户目录">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox Text="{Binding UserDir}" IsReadOnly="True" MinWidth="440" />
                        <u:IconButton Command="{Binding OpenUserDirCommand}"
                                      ToolTip.Tip="在资源管理器中打开用户目录">
                            <PathIcon Width="16" Height="16"
                                      Data="M10 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z" />
                        </u:IconButton>
                    </StackPanel>
                </u:FormItem>
                <u:FormItem Label="操作">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="重新部署" Classes="primary"
                                Command="{Binding DeployCommand}" IsEnabled="{Binding CanDeploy}" />
                        <Button Content="方案管理" IsEnabled="{Binding CanManageSchemas}"
                                Click="OnManageSchemasClick" />
                        <Button Content="备份恢复" IsEnabled="False" />
                        <Button Content="主题外观" IsEnabled="False" />
                    </StackPanel>
                </u:FormItem>
            </u:Form>

            <u:Banner Type="{Binding StatusType}"
                      Content="{Binding StatusMessage}"
                      ShowIcon="True"
                      IsVisible="{Binding HasStatus}" />
        </StackPanel>
    </Grid>
</Window>
