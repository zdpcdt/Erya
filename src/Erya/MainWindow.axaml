<u:UrsaWindow xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
              xmlns:u="https://irihi.tech/ursa"
              xmlns:vm="clr-namespace:Erya.ViewModels"
              xmlns:settings="clr-namespace:Erya.ViewModels.Settings"
              xmlns:adv="clr-namespace:Erya.ViewModels.Advanced"
              xmlns:views="clr-namespace:Erya.Views"
              mc:Ignorable="d" d:DesignWidth="1040" d:DesignHeight="680"
              x:Class="Erya.MainWindow"
              x:DataType="vm:ShellViewModel"
              Title="尔雅 Erya"
              Width="1040" Height="680"
              MinWidth="860" MinHeight="560"
              Background="{DynamicResource SemiGrey1}">

    <!-- Ctrl+R on Windows/Linux, Cmd+R on macOS -->
    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+R" Command="{Binding DeployCommand}" />
        <KeyBinding Gesture="Meta+R" Command="{Binding DeployCommand}" />
    </Window.KeyBindings>

    <Panel>
        <Grid ColumnDefinitions="Auto,*">

            <!-- Sidebar：直接坐在窗口底色上（底色随主题翻转：浅 #E6E8EA / 暗 #2E3238，含标题栏） -->
            <u:NavMenu Grid.Column="0" Width="216"
                       ItemsSource="{Binding NavItems}"
                       SelectedItem="{Binding SelectedNav, Mode=TwoWay}"
                       SubMenuBinding="{Binding Children}">

                <u:NavMenu.HeaderTemplate>
                    <!-- 显式模板而非 HeaderBinding：数据驱动下 Header 的显示由模板保证，
                         且 x:DataType 提供编译期检查（BindingBase 复制在真机上不可靠）。 -->
                    <DataTemplate x:DataType="vm:NavItem">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <PathIcon Width="18" Height="18" Data="{Binding Icon}" />
                            <TextBlock Text="{Binding Header}" />
                        </StackPanel>
                    </DataTemplate>
                </u:NavMenu.HeaderTemplate>

                <u:NavMenu.Header>
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="20,18,20,14">
                        <TextBlock Text="尔雅" FontSize="26" FontWeight="Bold" />
                        <TextBlock Text="Erya" FontSize="13" FontWeight="SemiBold"
                                   Opacity="0.4" VerticalAlignment="Bottom" Margin="0,0,0,5" />
                    </StackPanel>
                </u:NavMenu.Header>

                <u:NavMenu.Footer>
                    <TextBlock Text="Avalonia Port Challenge 2026"
                               Opacity="0.35" FontSize="11" Margin="20,14" />
                </u:NavMenu.Footer>
            </u:NavMenu>

            <!-- Content：内容画布（Background0）压在窗口底色上，朝侧栏一侧倒圆角，
                 数值对应 SemiBorderRadiusMedium（6），与内容卡片同一家族 -->
            <Border Grid.Column="1"
                    Background="{DynamicResource SemiColorBackground0}"
                    CornerRadius="6,0,0,6">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Grid.Row="0" Text="{Binding PageTitle}"
                               FontSize="18" FontWeight="Bold" Margin="28,14,28,0" />
                    <ContentControl Grid.Row="1" Margin="28,12,28,24" Content="{Binding CurrentPage}">
                        <ContentControl.DataTemplates>
                            <DataTemplate DataType="vm:MainViewModel">
                                <views:OverviewPage />
                            </DataTemplate>
                            <DataTemplate DataType="vm:SchemaManagerViewModel">
                                <views:SchemaManagerPage />
                            </DataTemplate>
                            <DataTemplate DataType="settings:SettingsEditorViewModel">
                                <views:SettingsPage />
                            </DataTemplate>
                            <DataTemplate DataType="settings:SkinPageViewModel">
                                <views:SkinPage />
                            </DataTemplate>
                            <DataTemplate DataType="settings:LayoutPageViewModel">
                                <views:LayoutPage />
                            </DataTemplate>
                            <DataTemplate DataType="settings:AppsPageViewModel">
                                <views:AppsPage />
                            </DataTemplate>
                            <DataTemplate DataType="adv:AdvancedSettingsViewModel">
                                <views:AdvancedSettingsPage />
                            </DataTemplate>
                            <DataTemplate DataType="vm:BackupRestoreViewModel">
                                <views:BackupRestorePage />
                            </DataTemplate>
                            <DataTemplate DataType="vm:AboutViewModel">
                                <views:AboutPage />
                            </DataTemplate>
                        </ContentControl.DataTemplates>
                    </ContentControl>
                </Grid>
            </Border>
        </Grid>

        <!-- Overlay dialogs (OverlayDialog.Show*) mount here -->
        <u:OverlayDialogHost HostId="main" IsTopLevel="True" />
    </Panel>

    <u:UrsaWindow.RightContent>
        <u:ThemeToggleButton IsThreeState="True" />
    </u:UrsaWindow.RightContent>
</u:UrsaWindow>
