<u:UrsaWindow xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
              xmlns:u="https://irihi.tech/ursa"
              mc:Ignorable="d" d:DesignWidth="1040" d:DesignHeight="680"
              x:Class="Erya.MainWindow"
              Title="尔雅 Erya"
              Width="1040" Height="680"
              MinWidth="860" MinHeight="560">

    <Panel>
        <Grid ColumnDefinitions="Auto,*">

            <!-- Sidebar -->
            <u:NavMenu Grid.Column="0" x:Name="Nav" Width="216"
                       SelectionChanged="OnNavSelectionChanged">

                <u:NavMenu.Header>
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="20,18,20,14">
                        <TextBlock Text="尔雅" FontSize="26" FontWeight="Bold" />
                        <TextBlock Text="Erya" FontSize="13" FontWeight="SemiBold"
                                   Opacity="0.4" VerticalAlignment="Bottom" Margin="0,0,0,5" />
                    </StackPanel>
                </u:NavMenu.Header>

                <u:NavMenu.Items>
                    <u:NavMenuItem Header="概览" Tag="overview" IsSelected="True">
                        <u:NavMenuItem.Icon>
                            <PathIcon Width="18" Height="18"
                                      Data="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8h5z" />
                        </u:NavMenuItem.Icon>
                    </u:NavMenuItem>
                    <u:NavMenuItem Header="方案管理" Tag="schemas">
                        <u:NavMenuItem.Icon>
                            <PathIcon Width="18" Height="18"
                                      Data="M3 5h2v2H3V5zm4 0h14v2H7V5zM3 11h2v2H3v-2zm4 0h14v2H7v-2zM3 17h2v2H3v-2zm4 0h14v2H7v-2z" />
                        </u:NavMenuItem.Icon>
                    </u:NavMenuItem>
                    <u:NavMenuItem Header="备份恢复" Tag="backup" IsEnabled="False"
                                   ToolTip.Tip="备份恢复功能即将上线">
                        <u:NavMenuItem.Icon>
                            <PathIcon Width="18" Height="18"
                                      Data="M13 3a9 9 0 0 0-9 9H1l3.9 3.9L9 12H6a7 7 0 1 1 2.06 4.94l-1.42 1.42A9 9 0 1 0 13 3zm-1 5v5l4.25 2.52.77-1.28-3.52-2.09V8H12z" />
                        </u:NavMenuItem.Icon>
                    </u:NavMenuItem>
                </u:NavMenu.Items>

                <u:NavMenu.Footer>
                    <TextBlock Text="Avalonia Port Challenge 2026"
                               Opacity="0.35" FontSize="11" Margin="20,14" />
                </u:NavMenu.Footer>
            </u:NavMenu>

            <!-- Content -->
            <Grid Grid.Column="1" RowDefinitions="Auto,*">
                <TextBlock Grid.Row="0" x:Name="PageTitleText" Text="概览"
                           FontSize="18" FontWeight="Bold" Margin="28,14,28,0" />
                <ContentControl Grid.Row="1" x:Name="PageHost" Margin="28,12,28,24" />
            </Grid>
        </Grid>

        <!-- Overlay dialogs (OverlayDialog.Show*) mount here -->
        <u:OverlayDialogHost HostId="main" IsTopLevel="True" />
    </Panel>

    <u:UrsaWindow.RightContent>
        <u:ThemeToggleButton />
    </u:UrsaWindow.RightContent>
</u:UrsaWindow>
