{
  "targetFile": "squirrel.yaml",
  "sections": [
    {
      "id": "skinChoice",
      "group": "skin",
      "title": "当前皮肤",
      "description": "候选窗配色方案。亮色用于系统浅色模式，暗色用于深色模式。",
      "fields": [
        {
          "id": "colorScheme",
          "label": "亮色皮肤",
          "type": "enum",
          "icon": "td:Sunny",
          "keyPath": "style/color_scheme",
          "choicesRef": "preset_color_schemes"
        },
        {
          "id": "colorSchemeDark",
          "label": "暗色皮肤",
          "description": "系统深色模式下使用的皮肤",
          "type": "enum",
          "icon": "td:Moon",
          "keyPath": "style/color_scheme_dark",
          "choicesRef": "preset_color_schemes"
        }
      ]
    },
    {
      "id": "layoutBehavior",
      "group": "layout",
      "title": "排列与显示",
      "description": "鼠须管候选窗的排列与显示效果。",
      "fields": [
        {
          "id": "candidateLayout",
          "label": "排列方式",
          "description": "stacked 为竖排，linear 为横排",
          "type": "segmented",
          "icon": "td:Layout",
          "keyPath": "style/candidate_list_layout",
          "choices": [
            "stacked",
            "linear"
          ]
        },
        {
          "id": "textOrientation",
          "label": "文字方向",
          "type": "segmented",
          "icon": "td:Vertical",
          "keyPath": "style/text_orientation",
          "choices": [
            "horizontal",
            "vertical"
          ]
        },
        {
          "id": "candidateFormat",
          "label": "候选格式",
          "description": "候选行模板：[label] 序号、[candidate] 候选、[comment] 注释，默认 \"[label]. [candidate] [comment]\"",
          "type": "text",
          "icon": "ip:Format",
          "keyPath": "style/candidate_format"
        },
        {
          "id": "inlinePreedit",
          "label": "内嵌编码",
          "description": "在应用光标处显示输入中的编码",
          "type": "toggle",
          "icon": "td:Text",
          "keyPath": "style/inline_preedit"
        },
        {
          "id": "inlineCandidate",
          "label": "内嵌候选",
          "description": "首选词直接内嵌在应用光标处",
          "type": "toggle",
          "keyPath": "style/inline_candidate"
        },
        {
          "id": "showPaging",
          "label": "显示翻页箭头",
          "type": "toggle",
          "icon": "td:ChevronDown",
          "keyPath": "style/show_paging"
        },
        {
          "id": "memorizeSize",
          "label": "贴靠屏幕边缘",
          "description": "候选窗贴近屏幕边缘显示，减少输入时的窗口跳动",
          "type": "toggle",
          "icon": "ip:MemoryOne",
          "keyPath": "style/memorize_size"
        },
        {
          "id": "mutualExclusive",
          "label": "色彩不叠加",
          "description": "多个透明色块不相互叠加（背景/高亮各自独立着色）",
          "type": "toggle",
          "keyPath": "style/mutual_exclusive"
        },
        {
          "id": "translucency",
          "label": "磨砂效果",
          "description": "使用系统磨砂半透明背景；仅当皮肤背景色带透明度时可见",
          "type": "toggle",
          "keyPath": "style/translucency"
        }
      ]
    },
    {
      "id": "layoutFonts",
      "group": "layout",
      "title": "字体",
      "fields": [
        {
          "id": "fontFace",
          "label": "候选字体",
          "description": "从系统已安装字体中选择，如 PingFang SC",
          "type": "font",
          "icon": "semi:SemiIconFont",
          "keyPath": "style/font_face"
        },
        {
          "id": "fontPoint",
          "label": "候选字号",
          "type": "stepper",
          "icon": "ip:FontSize",
          "keyPath": "style/font_point",
          "min": 10,
          "max": 32,
          "step": 1,
          "default": 22
        },
        {
          "id": "labelFontFace",
          "label": "序号字体",
          "type": "font",
          "icon": "semi:SemiIconFont",
          "keyPath": "style/label_font_face"
        },
        {
          "id": "labelFontPoint",
          "label": "序号字号",
          "description": "未设置时跟随候选字号",
          "type": "stepper",
          "icon": "ip:FontSize",
          "keyPath": "style/label_font_point",
          "min": 8,
          "max": 32,
          "step": 1
        },
        {
          "id": "commentFontFace",
          "label": "注释字体",
          "type": "font",
          "icon": "semi:SemiIconFont",
          "keyPath": "style/comment_font_face"
        },
        {
          "id": "commentFontPoint",
          "label": "注释字号",
          "description": "未设置时跟随候选字号",
          "type": "stepper",
          "icon": "ip:FontSize",
          "keyPath": "style/comment_font_point",
          "min": 8,
          "max": 32,
          "step": 1
        },
        {
          "id": "preeditFontFace",
          "label": "编码字体",
          "type": "font",
          "icon": "semi:SemiIconFont",
          "keyPath": "style/preedit_font_face"
        },
        {
          "id": "preeditFontPoint",
          "label": "编码字号",
          "description": "未设置时跟随候选字号",
          "type": "stepper",
          "icon": "ip:FontSize",
          "keyPath": "style/preedit_font_point",
          "min": 8,
          "max": 32,
          "step": 1
        },
        {
          "id": "baseOffset",
          "label": "基线偏移",
          "description": "文字相对基线的上下微调（像素），序号/注释与候选对齐不齐时可调",
          "type": "stepper",
          "keyPath": "style/base_offset",
          "min": -10,
          "max": 10,
          "step": 1
        }
      ]
    },
    {
      "id": "layoutSpacing",
      "group": "layout",
      "title": "间距",
      "fields": [
        {
          "id": "spacing",
          "label": "编码-候选间距",
          "description": "非内嵌模式下编码行与候选区的间距",
          "type": "stepper",
          "keyPath": "style/spacing",
          "min": 0,
          "max": 20,
          "step": 1
        },
        {
          "id": "lineSpacing",
          "label": "候选行距",
          "description": "竖排时候选行之间的间距",
          "type": "stepper",
          "icon": "td:LineHeight",
          "keyPath": "style/line_spacing",
          "min": 0,
          "max": 12,
          "step": 1
        },
        {
          "id": "surroundingExtraExpansion",
          "label": "非高亮背景扩张",
          "description": "非高亮候选背景块向四周扩张的像素",
          "type": "stepper",
          "keyPath": "style/surrounding_extra_expansion",
          "min": 0,
          "max": 20,
          "step": 1
        }
      ]
    },
    {
      "id": "layoutCorners",
      "group": "layout",
      "title": "圆角与边距",
      "fields": [
        {
          "id": "cornerRadius",
          "label": "圆角",
          "type": "stepper",
          "icon": "td:Round",
          "keyPath": "style/corner_radius",
          "min": 0,
          "max": 20,
          "step": 1
        },
        {
          "id": "hilitedCornerRadius",
          "label": "高亮圆角",
          "type": "stepper",
          "keyPath": "style/hilited_corner_radius",
          "min": 0,
          "max": 20,
          "step": 1
        },
        {
          "id": "borderHeight",
          "label": "纵向留白",
          "description": "内容与窗口边缘的垂直留白；与横向留白中较小者兼作描边宽度（默认 -2，可为负）",
          "type": "stepper",
          "keyPath": "style/border_height",
          "min": -5,
          "max": 10,
          "step": 1
        },
        {
          "id": "borderWidth",
          "label": "横向留白",
          "description": "内容与窗口边缘的水平留白；与纵向留白中较小者兼作描边宽度（默认 -2，可为负）",
          "type": "stepper",
          "icon": "td:Frame",
          "keyPath": "style/border_width",
          "min": -5,
          "max": 10,
          "step": 1
        }
      ]
    },
    {
      "id": "layoutEffects",
      "group": "layout",
      "title": "透明与阴影",
      "fields": [
        {
          "id": "alpha",
          "label": "透明度",
          "description": "整窗不透明度，1 为完全不透明",
          "type": "slider",
          "icon": "td:Alpha",
          "keyPath": "style/alpha",
          "min": 0,
          "max": 1,
          "step": 0.05,
          "default": 1
        },
        {
          "id": "shadowSize",
          "label": "高亮阴影",
          "description": "高亮候选块周围的阴影模糊半径（0 为无阴影）",
          "type": "stepper",
          "keyPath": "style/shadow_size",
          "min": 0,
          "max": 10,
          "step": 1
        }
      ]
    },
    {
      "id": "keyboard",
      "group": "layout",
      "title": "键盘体验",
      "fields": [
        {
          "id": "layout",
          "label": "拉丁键盘布局",
          "type": "enum",
          "icon": "td:Internet",
          "keyPath": "keyboard_layout",
          "choices": [
            "last",
            "default"
          ]
        },
        {
          "id": "chordDuration",
          "label": "和弦时间（秒）",
          "type": "slider",
          "icon": "td:Time",
          "keyPath": "chord_duration",
          "min": 0.05,
          "max": 0.5,
          "step": 0.05
        },
        {
          "id": "notifications",
          "label": "通知时机",
          "type": "enum",
          "icon": "td:Notification",
          "keyPath": "show_notifications_when",
          "choices": [
            "always",
            "never",
            "appropriate"
          ]
        },
        {
          "id": "statusIcon",
          "label": "菜单栏图标",
          "description": "在菜单栏显示输入法状态图标",
          "type": "toggle",
          "keyPath": "status_icon/show"
        }
      ]
    },
    {
      "id": "appOptions",
      "group": "apps",
      "title": "应用程序",
      "description": "为指定应用设置输入行为（按应用 Bundle ID，如在终端中默认使用英文）。应用行为页以卡片列表编辑本节；修改保存到补丁后重新部署生效。",
      "fields": [
        {
          "id": "appsTable",
          "label": "应用列表",
          "type": "appOptions",
          "icon": "td:App",
          "keyPath": "app_options",
          "choices": [
            "ascii_mode",
            "vim_mode",
            "inline",
            "no_inline"
          ]
        }
      ]
    }
  ]
}
