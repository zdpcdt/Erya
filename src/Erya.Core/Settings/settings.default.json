{
  "targetFile": "default.yaml",
  "sections": [
    {
      "id": "menu",
      "title": "候选词菜单",
      "fields": [
        {
          "id": "pageSize",
          "label": "候选词个数",
          "type": "stepper",
          "icon": "td:OrderList",
          "keyPath": "menu/page_size",
          "min": 3,
          "max": 10,
          "step": 1,
          "default": 5
        }
      ]
    },
    {
      "id": "switcher",
      "title": "方案选单",
      "fields": [
        {
          "id": "caption",
          "label": "标题",
          "type": "text",
          "keyPath": "switcher/caption"
        },
        {
          "id": "hotkeys",
          "label": "快捷键",
          "type": "hotkeyList",
          "icon": "td:Keyboard",
          "keyPath": "switcher/hotkeys"
        },
        {
          "id": "saveOptions",
          "label": "记忆选项",
          "type": "checkList",
          "icon": "td:Save",
          "keyPath": "switcher/save_options",
          "choices": [
            "ascii_punct",
            "traditionalization",
            "emoji",
            "full_shape",
            "search_single_char"
          ],
          "choiceLabels": {
            "ascii_punct": "西文标点",
            "traditionalization": "简繁转换",
            "emoji": "Emoji",
            "full_shape": "全角",
            "search_single_char": "单字检索"
          }
        },
        {
          "id": "foldOptions",
          "label": "折叠菜单",
          "type": "toggle",
          "icon": "td:MenuFold",
          "keyPath": "switcher/fold_options"
        },
        {
          "id": "abbreviateOptions",
          "label": "折叠缩写",
          "type": "toggle",
          "keyPath": "switcher/abbreviate_options"
        },
        {
          "id": "optionSeparator",
          "label": "选项分隔符",
          "type": "text",
          "keyPath": "switcher/option_list_separator"
        }
      ]
    },
    {
      "id": "asciiComposer",
      "title": "中英切换",
      "fields": [
        {
          "id": "capsLockMode",
          "label": "保持 Caps Lock 原功能",
          "description": "关闭时 Caps Lock 切换中英文输入状态",
          "type": "toggle",
          "icon": "td:LockOn",
          "keyPath": "ascii_composer/good_old_caps_lock"
        },
        {
          "id": "switchKey",
          "label": "切换按键行为",
          "type": "keyMapping",
          "icon": "td:Swap",
          "keyPath": "ascii_composer/switch_key",
          "choices": [
            "commit_code",
            "commit_text",
            "inline_ascii",
            "clear",
            "noop"
          ],
          "choiceLabels": {
            "commit_code": "上屏编码",
            "commit_text": "上屏候选",
            "inline_ascii": "行内英文",
            "clear": "清空编码",
            "noop": "不处理"
          },
          "keys": [
            "Caps_Lock",
            "Shift_L",
            "Shift_R",
            "Control_L",
            "Control_R"
          ]
        }
      ]
    },
    {
      "id": "keyBinder",
      "title": "功能快捷键",
      "description": "翻页、移动光标等按键映射由方案预置；修改请在「高级设置」编辑 default.yaml 补丁。",
      "fields": [
        {
          "id": "selectFirstCharacter",
          "label": "以词定字·首字（需方案支持）",
          "type": "hotkey",
          "icon": "td:CheckRectangle",
          "keyPath": "key_binder/select_first_character"
        },
        {
          "id": "selectLastCharacter",
          "label": "以词定字·末字（需方案支持）",
          "type": "hotkey",
          "icon": "td:CheckRectangle",
          "keyPath": "key_binder/select_last_character"
        }
      ]
    },
    {
      "id": "punctuator",
      "title": "数字与标点",
      "fields": [
        {
          "id": "digitSeparators",
          "label": "数字分隔符",
          "description": "连续输入数字时不上屏的分隔字符，如 \"',\"",
          "type": "text",
          "keyPath": "punctuator/digit_separators"
        },
        {
          "id": "digitSeparatorAction",
          "label": "分隔符行为",
          "type": "enum",
          "keyPath": "punctuator/digit_separator_action",
          "choices": [
            "commit",
            "noop"
          ],
          "choiceLabels": {
            "commit": "上屏分隔符",
            "noop": "不处理"
          }
        }
      ]
    }
  ]
}
