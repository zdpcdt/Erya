{
  "targetFile": "weasel.yaml",
  "sections": [
    {
      "id": "style",
      "title": "候选词面板",
      "description": "小狼毫候选窗的外观与排版。键名已对照小狼毫 0.17 源码逐一校验。",
      "fields": [
        {
          "id": "colorScheme",
          "label": "亮色皮肤",
          "type": "enum",
          "icon": "td:Sunny",
          "keyPath": "style/color_scheme",
          "choicesRef": "preset_color_schemes"
        },
        {
          "id": "colorSchemeDark",
          "label": "暗色皮肤",
          "description": "系统深色模式下使用的皮肤",
          "type": "enum",
          "icon": "td:Moon",
          "keyPath": "style/color_scheme_dark",
          "choicesRef": "preset_color_schemes"
        },
        {
          "id": "layoutType",
          "label": "排列方式",
          "description": "horizontal 横排 / vertical 竖排 / vertical_text 竖排文本（逐字竖书）。此键优先级最高，覆盖 horizontal 等旧键。",
          "type": "segmented",
          "icon": "td:Layout",
          "keyPath": "style/layout/type",
          "choices": [
            "horizontal",
            "vertical",
            "vertical_text"
          ]
        },
        {
          "id": "inlinePreedit",
          "label": "内嵌编码",
          "description": "在应用光标处显示输入中的编码",
          "type": "toggle",
          "icon": "td:Text",
          "keyPath": "style/inline_preedit"
        },
        {
          "id": "displayTrayIcon",
          "label": "显示托盘图标",
          "type": "toggle",
          "keyPath": "style/display_tray_icon"
        },
        {
          "id": "pagingOnScroll",
          "label": "滚轮翻页",
          "description": "在候选窗上滚动鼠标滚轮翻页",
          "type": "toggle",
          "keyPath": "style/paging_on_scroll"
        },
        {
          "id": "fontFace",
          "label": "字体",
          "description": "如 微软雅黑 (Microsoft YaHei)",
          "type": "text",
          "icon": "semi:SemiIconFont",
          "keyPath": "style/font_face"
        },
        {
          "id": "fontPoint",
          "label": "字号",
          "type": "stepper",
          "icon": "ip:FontSize",
          "keyPath": "style/font_point",
          "min": 10,
          "max": 32,
          "step": 1,
          "default": 22
        },
        {
          "id": "labelFontPoint",
          "label": "序号字号",
          "type": "stepper",
          "icon": "ip:FontSize",
          "keyPath": "style/label_font_point",
          "min": 8,
          "max": 32,
          "step": 1
        },
        {
          "id": "commentFontPoint",
          "label": "注释字号",
          "type": "stepper",
          "icon": "ip:FontSize",
          "keyPath": "style/comment_font_point",
          "min": 8,
          "max": 32,
          "step": 1
        },
        {
          "id": "labelFormat",
          "label": "序号格式",
          "description": "如 \"%s.\"；%s 代表数字",
          "type": "text",
          "icon": "td:Text",
          "keyPath": "style/label_format"
        },
        {
          "id": "markText",
          "label": "标记字符",
          "description": "高亮候选前的标记，如 \"·\"",
          "type": "text",
          "icon": "td:Text",
          "keyPath": "style/mark_text"
        },
        {
          "id": "cornerRadius",
          "label": "圆角",
          "type": "stepper",
          "icon": "td:Round",
          "keyPath": "style/layout/corner_radius",
          "min": 0,
          "max": 20,
          "step": 1
        },
        {
          "id": "hilitedCornerRadius",
          "label": "高亮圆角",
          "type": "stepper",
          "keyPath": "style/layout/hilited_corner_radius",
          "min": 0,
          "max": 20,
          "step": 1
        },
        {
          "id": "lineSpacing",
          "label": "候选行距",
          "type": "stepper",
          "icon": "td:LineHeight",
          "keyPath": "style/layout/linespacing",
          "min": 0,
          "max": 12,
          "step": 1
        },
        {
          "id": "spacing",
          "label": "编码-候选间距",
          "type": "stepper",
          "keyPath": "style/layout/spacing",
          "min": 0,
          "max": 20,
          "step": 1
        },
        {
          "id": "candidateSpacing",
          "label": "候选间距",
          "type": "stepper",
          "keyPath": "style/layout/candidate_spacing",
          "min": 0,
          "max": 40,
          "step": 1
        },
        {
          "id": "hiliteSpacing",
          "label": "高亮内边距",
          "type": "stepper",
          "keyPath": "style/layout/hilite_spacing",
          "min": 0,
          "max": 40,
          "step": 1
        }
      ]
    },
    {
      "id": "appOptions",
      "title": "应用程序",
      "description": "为特定应用设置输入行为（按程序 exe 名，如在 gvim.exe 中默认使用英文）。",
      "fields": [
        {
          "id": "appsTable",
          "label": "应用列表",
          "type": "appOptions",
          "icon": "td:App",
          "keyPath": "app_options"
        }
      ]
    }
  ]
}
