{
  "targetFile": "weasel.yaml",
  "sections": [
    {
      "id": "skinChoice",
      "group": "skin",
      "title": "当前皮肤",
      "fields": [
        {
          "id": "colorScheme",
          "label": "亮色皮肤",
          "type": "enum",
          "icon": "td:Sunny",
          "keyPath": "style/color_scheme",
          "choicesRef": "preset_color_schemes"
        },
        {
          "id": "colorSchemeDark",
          "label": "暗色皮肤",
          "type": "enum",
          "icon": "td:Moon",
          "keyPath": "style/color_scheme_dark",
          "choicesRef": "preset_color_schemes"
        }
      ]
    },
    {
      "id": "layoutBehavior",
      "group": "layout",
      "title": "排列与行为",
      "fields": [
        {
          "id": "layoutType",
          "label": "排列方式",
          "type": "segmented",
          "icon": "td:Layout",
          "keyPath": "style/layout/type",
          "choices": [
            "horizontal",
            "vertical",
            "vertical_text"
          ],
          "choiceLabels": {
            "horizontal": "横排",
            "vertical": "竖排",
            "vertical_text": "竖排文本"
          }
        },
        {
          "id": "inlinePreedit",
          "label": "内嵌编码",
          "type": "toggle",
          "icon": "td:Text",
          "keyPath": "style/inline_preedit"
        },
        {
          "id": "preeditType",
          "label": "编码区内容",
          "type": "enum",
          "icon": "td:Text",
          "keyPath": "style/preedit_type",
          "choices": [
            "composition",
            "preview",
            "preview_all"
          ],
          "choiceLabels": {
            "composition": "显示编码",
            "preview": "内嵌首选",
            "preview_all": "内嵌全部候选"
          }
        },
        {
          "id": "labelFormat",
          "label": "序号格式（%s 代表数字）",
          "type": "text",
          "icon": "td:Text",
          "keyPath": "style/label_format"
        },
        {
          "id": "markText",
          "label": "标记字符",
          "type": "text",
          "icon": "td:Text",
          "keyPath": "style/mark_text"
        },
        {
          "id": "pagingOnScroll",
          "label": "滚轮翻页",
          "type": "toggle",
          "keyPath": "style/paging_on_scroll"
        },
        {
          "id": "hoverType",
          "label": "悬停响应",
          "type": "enum",
          "icon": "td:Cursor",
          "keyPath": "style/hover_type",
          "choices": [
            "none",
            "semi_light",
            "hilite"
          ],
          "choiceLabels": {
            "none": "无",
            "semi_light": "半透明高亮",
            "hilite": "完整高亮"
          }
        },
        {
          "id": "candidateAbbreviateLength",
          "label": "候选缩略（字数，0 = 不缩略）",
          "type": "stepper",
          "icon": "td:Text",
          "keyPath": "style/candidate_abbreviate_length",
          "min": 0,
          "max": 20,
          "step": 1
        }
      ]
    },
    {
      "id": "verticalText",
      "group": "layout",
      "title": "竖排细节",
      "fields": [
        {
          "id": "verticalTextLeftToRight",
          "label": "竖排从左到右",
          "type": "toggle",
          "icon": "td:Vertical",
          "keyPath": "style/vertical_text_left_to_right"
        },
        {
          "id": "verticalTextWithWrap",
          "label": "竖排自动换列",
          "type": "toggle",
          "icon": "td:Vertical",
          "keyPath": "style/vertical_text_with_wrap"
        },
        {
          "id": "verticalAutoReverse",
          "label": "竖排自动换向",
          "type": "toggle",
          "icon": "td:Vertical",
          "keyPath": "style/vertical_auto_reverse"
        }
      ]
    },
    {
      "id": "rendering",
      "group": "layout",
      "title": "渲染与提示",
      "fields": [
        {
          "id": "antialiasMode",
          "label": "字体抗锯齿",
          "type": "enum",
          "keyPath": "style/antialias_mode",
          "choices": [
            "default",
            "cleartype",
            "grayscale",
            "aliased"
          ],
          "choiceLabels": {
            "default": "跟随系统",
            "cleartype": "ClearType",
            "grayscale": "灰度",
            "aliased": "关闭"
          }
        },
        {
          "id": "asciiTipFollowCursor",
          "label": "提示跟随光标",
          "type": "toggle",
          "icon": "td:Cursor",
          "keyPath": "style/ascii_tip_follow_cursor"
        },
        {
          "id": "fullscreen",
          "label": "全屏应用",
          "description": "开启后自动关闭内嵌编码，并解除候选窗最大宽度限制",
          "type": "toggle",
          "keyPath": "style/fullscreen"
        },
        {
          "id": "displayTrayIcon",
          "label": "显示托盘图标",
          "type": "toggle",
          "keyPath": "style/display_tray_icon"
        }
      ]
    },
    {
      "id": "layoutFonts",
      "group": "layout",
      "title": "字体",
      "fields": [
        {
          "id": "fontFace",
          "label": "候选字体",
          "type": "font",
          "icon": "semi:SemiIconFont",
          "keyPath": "style/font_face"
        },
        {
          "id": "fontPoint",
          "label": "候选字号",
          "type": "stepper",
          "icon": "ip:FontSize",
          "keyPath": "style/font_point",
          "min": 10,
          "max": 32,
          "step": 1,
          "default": 22
        },
        {
          "id": "labelFontFace",
          "label": "序号字体",
          "type": "font",
          "icon": "semi:SemiIconFont",
          "keyPath": "style/label_font_face"
        },
        {
          "id": "labelFontPoint",
          "label": "序号字号",
          "type": "stepper",
          "icon": "ip:FontSize",
          "keyPath": "style/label_font_point",
          "min": 8,
          "max": 32,
          "step": 1
        },
        {
          "id": "commentFontFace",
          "label": "注释字体",
          "type": "font",
          "icon": "semi:SemiIconFont",
          "keyPath": "style/comment_font_face"
        },
        {
          "id": "commentFontPoint",
          "label": "注释字号",
          "type": "stepper",
          "icon": "ip:FontSize",
          "keyPath": "style/comment_font_point",
          "min": 8,
          "max": 32,
          "step": 1
        }
      ]
    },
    {
      "id": "layoutSpacing",
      "group": "layout",
      "title": "间距",
      "fields": [
        {
          "id": "spacing",
          "label": "编码-候选间距",
          "type": "stepper",
          "keyPath": "style/layout/spacing",
          "min": 0,
          "max": 20,
          "step": 1
        },
        {
          "id": "candidateSpacing",
          "label": "候选间距",
          "type": "stepper",
          "keyPath": "style/layout/candidate_spacing",
          "min": 0,
          "max": 40,
          "step": 1
        },
        {
          "id": "hiliteSpacing",
          "label": "序号-候选间距",
          "type": "stepper",
          "keyPath": "style/layout/hilite_spacing",
          "min": 0,
          "max": 40,
          "step": 1
        },
        {
          "id": "hilitePadding",
          "label": "高亮扩张",
          "type": "stepper",
          "keyPath": "style/layout/hilite_padding",
          "min": 0,
          "max": 20,
          "step": 1
        },
        {
          "id": "lineSpacing",
          "label": "候选行距",
          "type": "stepper",
          "icon": "td:LineHeight",
          "keyPath": "style/layout/linespacing",
          "min": 0,
          "max": 12,
          "step": 1
        }
      ]
    },
    {
      "id": "layoutCorners",
      "group": "layout",
      "title": "圆角与边距",
      "fields": [
        {
          "id": "cornerRadius",
          "label": "圆角",
          "type": "stepper",
          "icon": "td:Round",
          "keyPath": "style/layout/corner_radius",
          "min": 0,
          "max": 20,
          "step": 1
        },
        {
          "id": "hilitedCornerRadius",
          "label": "高亮圆角",
          "type": "stepper",
          "keyPath": "style/layout/hilited_corner_radius",
          "min": 0,
          "max": 20,
          "step": 1
        },
        {
          "id": "borderWidth",
          "label": "边框宽度",
          "description": "颜色取自配色方案的 border_color",
          "type": "stepper",
          "icon": "td:Frame",
          "keyPath": "style/layout/border_width",
          "min": 0,
          "max": 10,
          "step": 1
        },
        {
          "id": "marginX",
          "label": "横向边距",
          "type": "stepper",
          "icon": "td:Frame",
          "keyPath": "style/layout/margin_x",
          "min": 0,
          "max": 30,
          "step": 1
        },
        {
          "id": "marginY",
          "label": "纵向边距",
          "type": "stepper",
          "icon": "td:Frame",
          "keyPath": "style/layout/margin_y",
          "min": 0,
          "max": 30,
          "step": 1
        }
      ]
    },
    {
      "id": "layoutShadow",
      "group": "layout",
      "title": "阴影",
      "fields": [
        {
          "id": "shadowRadius",
          "label": "阴影圆角",
          "description": "需配色方案提供非透明的 shadow_color 才可见",
          "type": "stepper",
          "keyPath": "style/layout/shadow_radius",
          "min": 0,
          "max": 30,
          "step": 1
        },
        {
          "id": "shadowOffsetX",
          "label": "阴影横向偏移",
          "type": "stepper",
          "keyPath": "style/layout/shadow_offset_x",
          "min": -30,
          "max": 30,
          "step": 1
        },
        {
          "id": "shadowOffsetY",
          "label": "阴影纵向偏移",
          "type": "stepper",
          "keyPath": "style/layout/shadow_offset_y",
          "min": -30,
          "max": 30,
          "step": 1
        }
      ]
    },
    {
      "id": "layoutSize",
      "group": "layout",
      "title": "宽高限制（0 = 不限制）",
      "fields": [
        {
          "id": "minWidth",
          "label": "最小宽度",
          "type": "stepper",
          "keyPath": "style/layout/min_width",
          "min": 0,
          "max": 800,
          "step": 10
        },
        {
          "id": "minHeight",
          "label": "最小高度",
          "type": "stepper",
          "keyPath": "style/layout/min_height",
          "min": 0,
          "max": 400,
          "step": 10
        },
        {
          "id": "maxWidth",
          "label": "最大宽度",
          "type": "stepper",
          "keyPath": "style/layout/max_width",
          "min": 0,
          "max": 1200,
          "step": 10
        },
        {
          "id": "maxHeight",
          "label": "最大高度",
          "type": "stepper",
          "keyPath": "style/layout/max_height",
          "min": 0,
          "max": 800,
          "step": 10
        }
      ]
    },
    {
      "id": "layoutAlign",
      "group": "layout",
      "title": "对齐与基线",
      "fields": [
        {
          "id": "alignType",
          "label": "垂直对齐",
          "type": "segmented",
          "keyPath": "style/layout/align_type",
          "choices": [
            "top",
            "center",
            "bottom"
          ],
          "choiceLabels": {
            "top": "上",
            "center": "中",
            "bottom": "下"
          }
        },
        {
          "id": "baseline",
          "label": "基线微调（%，0 = 不调整）",
          "type": "stepper",
          "keyPath": "style/layout/baseline",
          "min": -50,
          "max": 50,
          "step": 5
        }
      ]
    },
    {
      "id": "appOptions",
      "group": "apps",
      "title": "应用程序",
      "fields": [
        {
          "id": "appsTable",
          "label": "应用列表",
          "type": "appOptions",
          "icon": "td:App",
          "keyPath": "app_options",
          "choices": [
            "ascii_mode",
            "vim_mode",
            "inline_preedit"
          ]
        }
      ]
    }
  ]
}
