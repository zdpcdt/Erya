{
  "targetFile": "weasel.yaml",
  "sections": [
    {
      "id": "style",
      "title": "候选词面板",
      "description": "小狼毫候选窗的外观与排版。键名已对照小狼毫 0.17 源码逐一校验。",
      "fields": [
        {
          "id": "colorScheme",
          "label": "亮色皮肤",
          "type": "enum",
          "icon": "td:Sunny",
          "keyPath": "style/color_scheme",
          "choicesRef": "preset_color_schemes"
        },
        {
          "id": "colorSchemeDark",
          "label": "暗色皮肤",
          "description": "系统深色模式下使用的皮肤",
          "type": "enum",
          "icon": "td:Moon",
          "keyPath": "style/color_scheme_dark",
          "choicesRef": "preset_color_schemes"
        },
        {
          "id": "layoutType",
          "label": "排列方式",
          "description": "horizontal 横排 / vertical 竖排 / vertical_text 竖排文本（逐字竖书）。此键优先级最高，覆盖 horizontal 等旧键。",
          "type": "segmented",
          "icon": "td:Layout",
          "keyPath": "style/layout/type",
          "choices": [
            "horizontal",
            "vertical",
            "vertical_text"
          ]
        },
        {
          "id": "inlinePreedit",
          "label": "内嵌编码",
          "description": "在应用光标处显示输入中的编码",
          "type": "toggle",
          "icon": "td:Text",
          "keyPath": "style/inline_preedit"
        },
        {
          "id": "displayTrayIcon",
          "label": "显示托盘图标",
          "type": "toggle",
          "keyPath": "style/display_tray_icon"
        },
        {
          "id": "pagingOnScroll",
          "label": "滚轮翻页",
          "description": "在候选窗上滚动鼠标滚轮翻页",
          "type": "toggle",
          "keyPath": "style/paging_on_scroll"
        },
        {
          "id": "hoverType",
          "label": "悬停响应",
          "description": "鼠标悬停在候选词上的效果：none 无 / semi_light 浮现半透明高亮 / hilite 完整高亮",
          "type": "enum",
          "icon": "td:Cursor",
          "keyPath": "style/hover_type",
          "choices": [
            "none",
            "semi_light",
            "hilite"
          ]
        },
        {
          "id": "candidateAbbreviateLength",
          "label": "候选缩略",
          "description": "候选词超过此字数时中间缩略为省略号，0 表示不缩略",
          "type": "stepper",
          "icon": "td:Text",
          "keyPath": "style/candidate_abbreviate_length",
          "min": 0,
          "max": 20,
          "step": 1
        },
        {
          "id": "fontFace",
          "label": "字体",
          "description": "从系统已安装字体中选择，如 微软雅黑 (Microsoft YaHei)",
          "type": "font",
          "icon": "semi:SemiIconFont",
          "keyPath": "style/font_face"
        },
        {
          "id": "fontPoint",
          "label": "字号",
          "type": "stepper",
          "icon": "ip:FontSize",
          "keyPath": "style/font_point",
          "min": 10,
          "max": 32,
          "step": 1,
          "default": 22
        },
        {
          "id": "labelFontFace",
          "label": "序号字体",
          "type": "font",
          "icon": "semi:SemiIconFont",
          "keyPath": "style/label_font_face"
        },
        {
          "id": "labelFontPoint",
          "label": "序号字号",
          "type": "stepper",
          "icon": "ip:FontSize",
          "keyPath": "style/label_font_point",
          "min": 8,
          "max": 32,
          "step": 1
        },
        {
          "id": "commentFontFace",
          "label": "注释字体",
          "type": "font",
          "icon": "semi:SemiIconFont",
          "keyPath": "style/comment_font_face"
        },
        {
          "id": "commentFontPoint",
          "label": "注释字号",
          "type": "stepper",
          "icon": "ip:FontSize",
          "keyPath": "style/comment_font_point",
          "min": 8,
          "max": 32,
          "step": 1
        },
        {
          "id": "labelFormat",
          "label": "序号格式",
          "description": "如 \"%s.\"；%s 代表数字",
          "type": "text",
          "icon": "td:Text",
          "keyPath": "style/label_format"
        },
        {
          "id": "markText",
          "label": "标记字符",
          "description": "高亮候选前的标记，如 \"·\"",
          "type": "text",
          "icon": "td:Text",
          "keyPath": "style/mark_text"
        },
        {
          "id": "cornerRadius",
          "label": "圆角",
          "type": "stepper",
          "icon": "td:Round",
          "keyPath": "style/layout/corner_radius",
          "min": 0,
          "max": 20,
          "step": 1
        },
        {
          "id": "hilitedCornerRadius",
          "label": "高亮圆角",
          "type": "stepper",
          "keyPath": "style/layout/hilited_corner_radius",
          "min": 0,
          "max": 20,
          "step": 1
        },
        {
          "id": "lineSpacing",
          "label": "候选行距",
          "type": "stepper",
          "icon": "td:LineHeight",
          "keyPath": "style/layout/linespacing",
          "min": 0,
          "max": 12,
          "step": 1
        },
        {
          "id": "spacing",
          "label": "编码-候选间距",
          "type": "stepper",
          "keyPath": "style/layout/spacing",
          "min": 0,
          "max": 20,
          "step": 1
        },
        {
          "id": "candidateSpacing",
          "label": "候选间距",
          "type": "stepper",
          "keyPath": "style/layout/candidate_spacing",
          "min": 0,
          "max": 40,
          "step": 1
        },
        {
          "id": "hiliteSpacing",
          "label": "序号-候选间距",
          "type": "stepper",
          "keyPath": "style/layout/hilite_spacing",
          "min": 0,
          "max": 40,
          "step": 1
        },
        {
          "id": "hilitePadding",
          "label": "高亮扩张",
          "description": "高亮候选背景向四周扩张的像素",
          "type": "stepper",
          "keyPath": "style/layout/hilite_padding",
          "min": 0,
          "max": 20,
          "step": 1
        },
        {
          "id": "marginX",
          "label": "横向边距",
          "description": "候选窗内容与窗口边缘的左右留白",
          "type": "stepper",
          "icon": "td:Frame",
          "keyPath": "style/layout/margin_x",
          "min": 0,
          "max": 30,
          "step": 1
        },
        {
          "id": "marginY",
          "label": "纵向边距",
          "description": "候选窗内容与窗口边缘的上下留白",
          "type": "stepper",
          "icon": "td:Frame",
          "keyPath": "style/layout/margin_y",
          "min": 0,
          "max": 30,
          "step": 1
        },
        {
          "id": "borderWidth",
          "label": "边框宽度",
          "description": "候选窗描边像素；颜色取自配色方案的 border_color",
          "type": "stepper",
          "icon": "td:Frame",
          "keyPath": "style/layout/border_width",
          "min": 0,
          "max": 10,
          "step": 1
        },
        {
          "id": "shadowRadius",
          "label": "阴影圆角",
          "description": "候选窗阴影模糊半径；需配色方案提供非透明的 shadow_color 才可见",
          "type": "stepper",
          "keyPath": "style/layout/shadow_radius",
          "min": 0,
          "max": 30,
          "step": 1
        },
        {
          "id": "shadowOffsetX",
          "label": "阴影横向偏移",
          "type": "stepper",
          "keyPath": "style/layout/shadow_offset_x",
          "min": -30,
          "max": 30,
          "step": 1
        },
        {
          "id": "shadowOffsetY",
          "label": "阴影纵向偏移",
          "type": "stepper",
          "keyPath": "style/layout/shadow_offset_y",
          "min": -30,
          "max": 30,
          "step": 1
        },
        {
          "id": "minWidth",
          "label": "最小宽度",
          "description": "候选窗最小宽度，0 表示不限制",
          "type": "stepper",
          "keyPath": "style/layout/min_width",
          "min": 0,
          "max": 800,
          "step": 10
        },
        {
          "id": "minHeight",
          "label": "最小高度",
          "description": "候选窗最小高度，0 表示不限制",
          "type": "stepper",
          "keyPath": "style/layout/min_height",
          "min": 0,
          "max": 400,
          "step": 10
        },
        {
          "id": "maxWidth",
          "label": "最大宽度",
          "description": "候选窗最大宽度，0 表示不限制",
          "type": "stepper",
          "keyPath": "style/layout/max_width",
          "min": 0,
          "max": 1200,
          "step": 10
        },
        {
          "id": "maxHeight",
          "label": "最大高度",
          "description": "候选窗最大高度，0 表示不限制",
          "type": "stepper",
          "keyPath": "style/layout/max_height",
          "min": 0,
          "max": 800,
          "step": 10
        }
      ]
    },
    {
      "id": "appOptions",
      "title": "应用程序",
      "description": "为特定应用设置输入行为（按程序 exe 名，如在 gvim.exe 中默认使用英文）。",
      "fields": [
        {
          "id": "appsTable",
          "label": "应用列表",
          "type": "appOptions",
          "icon": "td:App",
          "keyPath": "app_options"
        }
      ]
    }
  ]
}
