{
  "targetFile": "weasel.yaml",
  "sections": [
    {
      "id": "skinChoice",
      "group": "skin",
      "title": "当前皮肤",
      "description": "候选窗配色方案。亮色用于系统浅色模式，暗色用于深色模式。",
      "fields": [
        {
          "id": "colorScheme",
          "label": "亮色皮肤",
          "type": "enum",
          "icon": "td:Sunny",
          "keyPath": "style/color_scheme",
          "choicesRef": "preset_color_schemes"
        },
        {
          "id": "colorSchemeDark",
          "label": "暗色皮肤",
          "description": "系统深色模式下使用的皮肤",
          "type": "enum",
          "icon": "td:Moon",
          "keyPath": "style/color_scheme_dark",
          "choicesRef": "preset_color_schemes"
        }
      ]
    },
    {
      "id": "layoutBehavior",
      "group": "layout",
      "title": "排列与行为",
      "description": "候选窗的横竖排与交互行为。键名已对照小狼毫 0.17 源码逐一校验。",
      "fields": [
        {
          "id": "layoutType",
          "label": "排列方式",
          "description": "horizontal 横排 / vertical 竖排 / vertical_text 竖排文本（逐字竖书）。此键优先级最高，覆盖 horizontal 等旧键。",
          "type": "segmented",
          "icon": "td:Layout",
          "keyPath": "style/layout/type",
          "choices": [
            "horizontal",
            "vertical",
            "vertical_text"
          ]
        },
        {
          "id": "inlinePreedit",
          "label": "内嵌编码",
          "description": "在应用光标处显示输入中的编码",
          "type": "toggle",
          "icon": "td:Text",
          "keyPath": "style/inline_preedit"
        },
        {
          "id": "preeditType",
          "label": "编码区内容",
          "description": "composition 显示输入编码；preview 在光标处显示首选候选（相当于鼠须管的内嵌候选）；preview_all 内嵌显示全部候选",
          "type": "enum",
          "icon": "td:Text",
          "keyPath": "style/preedit_type",
          "choices": [
            "composition",
            "preview",
            "preview_all"
          ]
        },
        {
          "id": "labelFormat",
          "label": "序号格式",
          "description": "如 \"%s.\"；%s 代表数字",
          "type": "text",
          "icon": "td:Text",
          "keyPath": "style/label_format"
        },
        {
          "id": "markText",
          "label": "标记字符",
          "description": "高亮候选前的标记，如 \"·\"",
          "type": "text",
          "icon": "td:Text",
          "keyPath": "style/mark_text"
        },
        {
          "id": "pagingOnScroll",
          "label": "滚轮翻页",
          "description": "在候选窗上滚动鼠标滚轮翻页",
          "type": "toggle",
          "keyPath": "style/paging_on_scroll"
        },
        {
          "id": "hoverType",
          "label": "悬停响应",
          "description": "鼠标悬停在候选词上的效果：none 无 / semi_light 浮现半透明高亮 / hilite 完整高亮",
          "type": "enum",
          "icon": "td:Cursor",
          "keyPath": "style/hover_type",
          "choices": [
            "none",
            "semi_light",
            "hilite"
          ]
        },
        {
          "id": "candidateAbbreviateLength",
          "label": "候选缩略",
          "description": "候选词超过此字数时中间缩略为省略号，0 表示不缩略",
          "type": "stepper",
          "icon": "td:Text",
          "keyPath": "style/candidate_abbreviate_length",
          "min": 0,
          "max": 20,
          "step": 1
        }
      ]
    },
    {
      "id": "verticalText",
      "group": "layout",
      "title": "竖排细节",
      "description": "排列方式为 vertical / vertical_text 时生效。",
      "fields": [
        {
          "id": "verticalTextLeftToRight",
          "label": "竖排从左到右",
          "description": "竖排文本（vertical_text）的列序改为从左到右，默认从右到左",
          "type": "toggle",
          "icon": "td:Vertical",
          "keyPath": "style/vertical_text_left_to_right"
        },
        {
          "id": "verticalTextWithWrap",
          "label": "竖排自动换列",
          "description": "竖排文本（vertical_text）超出一列时自动换列",
          "type": "toggle",
          "icon": "td:Vertical",
          "keyPath": "style/vertical_text_with_wrap"
        },
        {
          "id": "verticalAutoReverse",
          "label": "竖排自动换向",
          "description": "根据候选窗在屏幕上的位置自动反转竖排方向",
          "type": "toggle",
          "icon": "td:Vertical",
          "keyPath": "style/vertical_auto_reverse"
        }
      ]
    },
    {
      "id": "rendering",
      "group": "layout",
      "title": "渲染与提示",
      "fields": [
        {
          "id": "antialiasMode",
          "label": "字体抗锯齿",
          "description": "DirectWrite 文字渲染的抗锯齿方式：default 跟随系统、cleartype、grayscale 灰度、aliased 关闭",
          "type": "enum",
          "keyPath": "style/antialias_mode",
          "choices": [
            "default",
            "cleartype",
            "grayscale",
            "aliased"
          ]
        },
        {
          "id": "asciiTipFollowCursor",
          "label": "提示跟随光标",
          "description": "中西文切换提示显示在应用光标处",
          "type": "toggle",
          "icon": "td:Cursor",
          "keyPath": "style/ascii_tip_follow_cursor"
        },
        {
          "id": "fullscreen",
          "label": "全屏应用",
          "description": "在全屏应用（游戏、播放器）中显示候选窗；开启后自动关闭内嵌编码并解除最大宽度限制",
          "type": "toggle",
          "keyPath": "style/fullscreen"
        },
        {
          "id": "displayTrayIcon",
          "label": "显示托盘图标",
          "type": "toggle",
          "keyPath": "style/display_tray_icon"
        }
      ]
    },
    {
      "id": "layoutFonts",
      "group": "layout",
      "title": "字体",
      "fields": [
        {
          "id": "fontFace",
          "label": "候选字体",
          "description": "从系统已安装字体中选择，如 微软雅黑 (Microsoft YaHei)",
          "type": "font",
          "icon": "semi:SemiIconFont",
          "keyPath": "style/font_face"
        },
        {
          "id": "fontPoint",
          "label": "候选字号",
          "type": "stepper",
          "icon": "ip:FontSize",
          "keyPath": "style/font_point",
          "min": 10,
          "max": 32,
          "step": 1,
          "default": 22
        },
        {
          "id": "labelFontFace",
          "label": "序号字体",
          "type": "font",
          "icon": "semi:SemiIconFont",
          "keyPath": "style/label_font_face"
        },
        {
          "id": "labelFontPoint",
          "label": "序号字号",
          "type": "stepper",
          "icon": "ip:FontSize",
          "keyPath": "style/label_font_point",
          "min": 8,
          "max": 32,
          "step": 1
        },
        {
          "id": "commentFontFace",
          "label": "注释字体",
          "type": "font",
          "icon": "semi:SemiIconFont",
          "keyPath": "style/comment_font_face"
        },
        {
          "id": "commentFontPoint",
          "label": "注释字号",
          "type": "stepper",
          "icon": "ip:FontSize",
          "keyPath": "style/comment_font_point",
          "min": 8,
          "max": 32,
          "step": 1
        }
      ]
    },
    {
      "id": "layoutSpacing",
      "group": "layout",
      "title": "间距",
      "fields": [
        {
          "id": "spacing",
          "label": "编码-候选间距",
          "type": "stepper",
          "keyPath": "style/layout/spacing",
          "min": 0,
          "max": 20,
          "step": 1
        },
        {
          "id": "candidateSpacing",
          "label": "候选间距",
          "type": "stepper",
          "keyPath": "style/layout/candidate_spacing",
          "min": 0,
          "max": 40,
          "step": 1
        },
        {
          "id": "hiliteSpacing",
          "label": "序号-候选间距",
          "type": "stepper",
          "keyPath": "style/layout/hilite_spacing",
          "min": 0,
          "max": 40,
          "step": 1
        },
        {
          "id": "hilitePadding",
          "label": "高亮扩张",
          "description": "高亮候选背景向四周扩张的像素",
          "type": "stepper",
          "keyPath": "style/layout/hilite_padding",
          "min": 0,
          "max": 20,
          "step": 1
        },
        {
          "id": "lineSpacing",
          "label": "候选行距",
          "type": "stepper",
          "icon": "td:LineHeight",
          "keyPath": "style/layout/linespacing",
          "min": 0,
          "max": 12,
          "step": 1
        }
      ]
    },
    {
      "id": "layoutCorners",
      "group": "layout",
      "title": "圆角与边距",
      "fields": [
        {
          "id": "cornerRadius",
          "label": "圆角",
          "type": "stepper",
          "icon": "td:Round",
          "keyPath": "style/layout/corner_radius",
          "min": 0,
          "max": 20,
          "step": 1
        },
        {
          "id": "hilitedCornerRadius",
          "label": "高亮圆角",
          "type": "stepper",
          "keyPath": "style/layout/hilited_corner_radius",
          "min": 0,
          "max": 20,
          "step": 1
        },
        {
          "id": "borderWidth",
          "label": "边框宽度",
          "description": "候选窗描边像素；颜色取自配色方案的 border_color",
          "type": "stepper",
          "icon": "td:Frame",
          "keyPath": "style/layout/border_width",
          "min": 0,
          "max": 10,
          "step": 1
        },
        {
          "id": "marginX",
          "label": "横向边距",
          "description": "候选窗内容与窗口边缘的左右留白",
          "type": "stepper",
          "icon": "td:Frame",
          "keyPath": "style/layout/margin_x",
          "min": 0,
          "max": 30,
          "step": 1
        },
        {
          "id": "marginY",
          "label": "纵向边距",
          "description": "候选窗内容与窗口边缘的上下留白",
          "type": "stepper",
          "icon": "td:Frame",
          "keyPath": "style/layout/margin_y",
          "min": 0,
          "max": 30,
          "step": 1
        }
      ]
    },
    {
      "id": "layoutShadow",
      "group": "layout",
      "title": "阴影",
      "description": "需配色方案提供非透明的 shadow_color 才可见。",
      "fields": [
        {
          "id": "shadowRadius",
          "label": "阴影圆角",
          "description": "候选窗阴影模糊半径",
          "type": "stepper",
          "keyPath": "style/layout/shadow_radius",
          "min": 0,
          "max": 30,
          "step": 1
        },
        {
          "id": "shadowOffsetX",
          "label": "阴影横向偏移",
          "type": "stepper",
          "keyPath": "style/layout/shadow_offset_x",
          "min": -30,
          "max": 30,
          "step": 1
        },
        {
          "id": "shadowOffsetY",
          "label": "阴影纵向偏移",
          "type": "stepper",
          "keyPath": "style/layout/shadow_offset_y",
          "min": -30,
          "max": 30,
          "step": 1
        }
      ]
    },
    {
      "id": "layoutSize",
      "group": "layout",
      "title": "宽高限制",
      "description": "0 表示不限制。",
      "fields": [
        {
          "id": "minWidth",
          "label": "最小宽度",
          "type": "stepper",
          "keyPath": "style/layout/min_width",
          "min": 0,
          "max": 800,
          "step": 10
        },
        {
          "id": "minHeight",
          "label": "最小高度",
          "type": "stepper",
          "keyPath": "style/layout/min_height",
          "min": 0,
          "max": 400,
          "step": 10
        },
        {
          "id": "maxWidth",
          "label": "最大宽度",
          "type": "stepper",
          "keyPath": "style/layout/max_width",
          "min": 0,
          "max": 1200,
          "step": 10
        },
        {
          "id": "maxHeight",
          "label": "最大高度",
          "type": "stepper",
          "keyPath": "style/layout/max_height",
          "min": 0,
          "max": 800,
          "step": 10
        }
      ]
    },
    {
      "id": "layoutAlign",
      "group": "layout",
      "title": "对齐与基线",
      "fields": [
        {
          "id": "alignType",
          "label": "垂直对齐",
          "description": "候选行内文字的对齐基准（上 / 中 / 下）",
          "type": "segmented",
          "keyPath": "style/layout/align_type",
          "choices": [
            "top",
            "center",
            "bottom"
          ]
        },
        {
          "id": "baseline",
          "label": "基线微调",
          "description": "以候选字号的百分比微调文字基线，0 为不调整",
          "type": "stepper",
          "keyPath": "style/layout/baseline",
          "min": -50,
          "max": 50,
          "step": 5
        }
      ]
    },
    {
      "id": "appOptions",
      "group": "apps",
      "title": "应用程序",
      "description": "为指定应用设置输入行为（按程序 exe 名，如在终端中默认使用英文）。应用行为页以卡片列表编辑本节；修改保存到补丁后重新部署生效。",
      "fields": [
        {
          "id": "appsTable",
          "label": "应用列表",
          "type": "appOptions",
          "icon": "td:App",
          "keyPath": "app_options",
          "choices": [
            "ascii_mode",
            "vim_mode",
            "inline_preedit"
          ]
        }
      ]
    }
  ]
}
