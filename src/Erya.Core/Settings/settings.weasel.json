{
  "targetFile": "weasel.yaml",
  "sections": [
    {
      "id": "style",
      "title": "候选词面板",
      "description": "小狼毫候选窗的外观与排版（取小狼毫与鼠须管通用的样式键）。",
      "fields": [
        {
          "id": "colorScheme",
          "label": "亮色皮肤",
          "type": "enum",
          "keyPath": "style/color_scheme",
          "choicesRef": "preset_color_schemes"
        },
        {
          "id": "colorSchemeDark",
          "label": "暗色皮肤",
          "description": "系统深色模式下使用的皮肤",
          "type": "enum",
          "keyPath": "style/color_scheme_dark",
          "choicesRef": "preset_color_schemes"
        },
        {
          "id": "candidateLayout",
          "label": "排列方式",
          "description": "stacked 为竖排，linear 为横排",
          "type": "segmented",
          "keyPath": "style/candidate_list_layout",
          "choices": ["stacked", "linear"]
        },
        {
          "id": "textOrientation",
          "label": "文字方向",
          "type": "segmented",
          "keyPath": "style/text_orientation",
          "choices": ["horizontal", "vertical"]
        },
        {
          "id": "inlinePreedit",
          "label": "内嵌编码",
          "description": "在应用光标处显示输入中的编码",
          "type": "toggle",
          "keyPath": "style/inline_preedit"
        },
        {
          "id": "inlineCandidate",
          "label": "内嵌候选",
          "description": "首选词直接内嵌在应用光标处（小狼毫 0.15+）",
          "type": "toggle",
          "keyPath": "style/inline_candidate"
        },
        {
          "id": "translucency",
          "label": "磨砂效果",
          "type": "toggle",
          "keyPath": "style/translucency"
        },
        {
          "id": "mutualExclusive",
          "label": "色彩不叠加",
          "type": "toggle",
          "keyPath": "style/mutual_exclusive"
        },
        {
          "id": "fontFace",
          "label": "字体",
          "description": "如 微软雅黑 (Microsoft YaHei)",
          "type": "text",
          "keyPath": "style/font_face"
        },
        {
          "id": "fontPoint",
          "label": "字号",
          "type": "stepper",
          "keyPath": "style/font_point",
          "min": 10,
          "max": 32,
          "step": 1,
          "default": 22
        },
        {
          "id": "cornerRadius",
          "label": "圆角",
          "type": "stepper",
          "keyPath": "style/corner_radius",
          "min": 0,
          "max": 20,
          "step": 1
        },
        {
          "id": "hilitedCornerRadius",
          "label": "高亮圆角",
          "type": "stepper",
          "keyPath": "style/hilited_corner_radius",
          "min": 0,
          "max": 20,
          "step": 1
        },
        {
          "id": "lineSpacing",
          "label": "候选行距",
          "type": "stepper",
          "keyPath": "style/line_spacing",
          "min": 0,
          "max": 12,
          "step": 1
        },
        {
          "id": "spacing",
          "label": "拼音间距",
          "type": "stepper",
          "keyPath": "style/spacing",
          "min": 0,
          "max": 20,
          "step": 1
        },
        {
          "id": "alpha",
          "label": "透明度",
          "type": "slider",
          "keyPath": "style/alpha",
          "min": 0,
          "max": 1,
          "step": 0.05,
          "default": 1
        }
      ]
    },
    {
      "id": "appOptions",
      "title": "应用程序",
      "description": "为特定应用设置输入行为（按程序 exe 名，如在 gvim.exe 中默认使用英文）。",
      "fields": [
        {
          "id": "appsTable",
          "label": "应用列表",
          "type": "appOptions",
          "keyPath": "app_options"
        }
      ]
    }
  ]
}
