<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Erya.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- 通配：基础文件 + 语言变体（settings.default.json / settings.default.zh-Hant.json …）。
         WithCulture=false 至关重要：文件名里的 .en/.zh-Hant 后缀会被 MSBuild 当成
         卫星程序集文化标识分流出去，CoreLoc 按名字从主程序集读流就会落空。 -->
    <EmbeddedResource Include="Settings\settings.*.json" WithCulture="false" />
    <EmbeddedResource Include="Packages\packages.catalog*.json" WithCulture="false" />
    <EmbeddedResource Include="Localization\CoreStrings*.json" WithCulture="false" />
  </ItemGroup>

</Project>
